    #agents { height: auto; }
    #agents Checkbox { margin-right: 3; }
    .row { height: auto; }
    .row > Vertical { height: auto; margin-right: 2; }
    #output { height: 1fr; border: solid $primary; }
    #status { padding: 1 2; height: auto; }
    #snaptitle, #snaphelp { padding: 0 1; height: auto; }
    #snaps { height: 1fr; }
    #chstatus { padding: 0 1; height: auto; }
    #diff { height: 1fr; }
    #topbar { height: 2; }
    #brand { width: auto; padding: 0 2 0 1; content-align: left middle; height: 2; }
    #tabs { width: 1fr; }
    #panes { height: 1fr; }
    Creating { padding: 0 1 1 1; }
    """

    def __init__(self):
        global LANG
        super().__init__()
        LANG = load_lang()
        self.vms, self.info = [], {}
        self.forwards = {}  # name -> list of (Popen, description)
        self.busy = set()
        self.count = 0
        self.last = None  # the tab Ctrl+] goes back to from the list
        self._bindings = BindingsMap(self.make_bindings())

    def make_bindings(self):
        """The keys of the tab shown: the list's, or a terminal's (which get
        all other keys)."""
        kind = self.pane_kind()
        tabs = [Binding("f7", "prev_tab", T("← Tab"), priority=True),
                Binding("f8", "next_tab", T("Tab →"), priority=True),
                Binding("ctrl+pageup", "prev_tab", show=False, priority=True),
                Binding("ctrl+pagedown", "next_tab", show=False, priority=True)]
        if kind == "home":
            other = dict(LANGUAGES)[LANGUAGES[(list(dict(LANGUAGES)).index(LANG) + 1) % len(LANGUAGES)][0]]
            more = len(self.pane_ids()) > 1
            return [Binding("enter", "open", T("Open"), show=False),
                    Binding("n", "new", T("New VM")), Binding("s", "shell", T("Shell"), show=False),
                    Binding("p", "project", T("Project")), Binding("c", "changes", T("Changes")),
                    Binding("o", "ports", T("Ports")), Binding("t", "toggle", T("Start/stop")),
                    Binding("u", "snapshots", T("Snapshots")), Binding("r", "resize", T("Resources")),
                    Binding("d", "delete", T("Delete")),
                    Binding("ctrl+right_square_bracket", "back_to_tab", T("Tabs"), key_display="^]",
                            show=more, priority=True),
                    Binding("L", "language", other), Binding("q", "quit", T("Quit")),
                    Binding("g", "refresh", show=False)] + [
                Binding(str(i), f"goto_tab({i})", show=False) for i in range(1, 10)] + [
                dataclasses.replace(b, show=False) for b in tabs]
        home = [Binding("ctrl+right_square_bracket", "home", T("VM list"), priority=True, key_display="^]")]
        if kind != "term":
            return home + tabs
        return home + [Binding("f1", "open_kind('shell')", T("Shell"), priority=True)] + [
            Binding(f"f{i}", f"open_kind('{k}')", label, priority=True)
            for i, (k, label) in enumerate(AGENTS, start=2)] + tabs

    @property
    def main(self):
        """The screen with the tabs. (The app's own queries go to the screen on
        top, which may be a dialog.)"""
        return self.screen_stack[0]

    def check_action(self, action, parameters):
        # The app's keys are for its tabs, not for forms or dialogs over them.
        if action in LIST_ACTIONS | TAB_ACTIONS and len(self.screen_stack) > 1:
            return False
        return True

    def compose(self):
        with Horizontal(id="topbar"):
            yield Static("[b]vmagents[/b]", id="brand")
            yield Tabs(Tab(T("VMs"), id="tab-home"), id="tabs")
        with ContentSwitcher(id="panes", initial="home"):
            with Vertical(id="home"):
                with Horizontal():
                    yield VMTable(id="vms", cursor_type="row", zebra_stripes=True)
                    with VerticalScroll(id="side", can_focus=False):
                        yield Static("", id="details")
                log = RichLog(id="log", wrap=True, markup=True)
                log.can_focus = False  # the keys are for the list
                yield log
        yield Footer()

    def on_mount(self):
        self.main.query_one(Tabs).can_focus = False
        self.setup_list()
        self.relabel()
        self.load_info()
        self.refresh_vms()
        self.set_interval(5, self.refresh_vms)
        self.set_interval(0.5, self.watch_terminals)

    def setup_list(self):
        t = self.main.query_one("#vms", DataTable)
        t.clear(columns=True)
        t.add_columns(T("Name"), T("State"), T("RAM"), T("CPUs"), T("AI"), T("Ports"))
        t.focus()
        self._seen = None
        self.log_line(T("[dim]Enter or l: open · j/k: move · n: new VM · p: project · c: changes · o: ports · "
                        "t: start/stop · u: snapshots · L: language · q: quit[/]"))
        self.log_line(T("[dim]Tabs: Ctrl+] list ⇄ last tab · F7/F8 (or Ctrl+PgUp/PgDn) previous/next · "
                        "1 to 9 here: that tab[/]"))

    # --- language
    def action_language(self):
        global LANG
        codes = [c for c, _ in LANGUAGES]
        LANG = codes[(codes.index(LANG) + 1) % len(codes)]
        save_lang(LANG)
        for c in self.main.query(Changes):
            c._bindings = BindingsMap(c.make_bindings())
        self.rebind()
        self.relabel()
        self.setup_list()
        if self.vms:
            self.show_vms(self.vms)
        self.notify(T("Language: English"))

    # --- tabs
    def pane_ids(self):
        try:
            return [t.id[4:] for t in self.main.query_one(Tabs).query(Tab)]
        except (NoMatches, IndexError):
            return ["home"]

    def current_pane(self):
        try:
            return self.main.query_one("#panes", ContentSwitcher).current or "home"
        except (NoMatches, IndexError):
            return "home"

    def pane_kind(self, pid=None):
        pid = pid or self.current_pane()
        return "home" if pid == "home" else "term" if pid.startswith("term-") else "other"

    def pane(self, pid):
        return self.main.query_one("#panes", ContentSwitcher).get_child_by_id(pid)

    def pane_label(self, pid):
        if pid == "home":
            return T("VMs")
        w = self.pane(pid)
        if isinstance(w, Terminal):
            return f"{w.vm_name} · {kind_label(w.kind)}"
        return f"{(w.vm if isinstance(w, Changes) else w.v)['name']} · {w.status_label()}"

    def pane_mark(self, pid):
        """Before the label of a terminal tab not shown: a spinner while its
        program works, a dot when it stopped (waiting for you, or done)."""
        w = self.pane(pid) if pid.startswith("term-") else None
        if w is None or pid == self.current_pane():
            return ("", "")
        if w.attention:
            return ("● ", "bold #ffaf00")
        if w.working:
            return (SPINNER[int(time.monotonic() * 8) % len(SPINNER)] + " ", "cyan")
        return ("", "")

    def relabel(self):
        for i, tab in enumerate(self.main.query_one(Tabs).query(Tab), start=1):
            pid = tab.id[4:]
            label = Text.assemble((f"{i} " if i < 10 else "", "dim"), self.pane_mark(pid), self.pane_label(pid))
            if label != tab.label:
                tab.label = label

    def watch_terminals(self):
        """Which programs work, and which stopped while you were elsewhere."""
        now, changed = time.monotonic(), False
        for t in self.terminals():
            if t.rc is None and t.busy(now):
                t.last_active = now
                changed |= not t.working
                t.working = True
            elif t.working and now - t.last_active > 3:
                t.working, changed = False, True
                if t.id != self.current_pane():
                    self.needs_you(t)
            changed |= t.working and t.id != self.current_pane()  # the spinner turns
        if changed:
            self.relabel()

    def needs_you(self, t):
        if t.attention:
            return
        t.attention = True
        self.notify(T("{tab} is waiting for you ({key}).", tab=f"{t.vm_name} · {kind_label(t.kind)}",
                      key=f"{self.pane_ids().index(t.id) + 1}" if t.id in self.pane_ids() else "F7/F8"))
        self.bell()
        self._seen = None
        self.back_to_list()

    @on(Terminal.Bell)
    def terminal_bell(self, event):
        if event.terminal.id != self.current_pane():
            self.needs_you(event.terminal)
            self.relabel()

    def rebind(self):
        self._bindings = BindingsMap(self.make_bindings())
        self.refresh_bindings()

    def show(self, pid):
        """Shows the tab PID ("home": the list) and gives it the keys."""
        self.main.query_one("#panes", ContentSwitcher).current = pid
        tabs = self.main.query_one(Tabs)
        if tabs.active != f"tab-{pid}":
            tabs.active = f"tab-{pid}"
        if pid == "home":
            self.main.query_one("#vms", DataTable).focus()
            self.back_to_list()
        else:
            self.last = pid
            w = self.pane(pid)
            if isinstance(w, Terminal):
                w.attention = False
                w.focus()
            else:
                w.focus_default()
        self.rebind()
        self.relabel()

    def add_pane(self, widget, label):
        self.main.query_one("#panes", ContentSwitcher).mount(widget)
        self.main.query_one(Tabs).add_tab(Tab(label, id=f"tab-{widget.id}"))
        self.show(widget.id)
        self.relabel()

    def close_pane(self, pid, then="home"):
        """Removes the tab PID; if it was shown, shows THEN."""
        if self.current_pane() == pid:
            self.show(then)  # first, so that the tabs do not pick one themselves
        self.main.query_one(Tabs).remove_tab(f"tab-{pid}")
        self.pane(pid).remove()
        if self.last == pid:
            self.last = None
        self.call_after_refresh(self.relabel)
        self.call_after_refresh(self.back_to_list)  # its marks in the list go too
        self.rebind()
        self._seen = None

    @on(Tabs.TabActivated)
    def tab_activated(self, event):
        if event.tab is not None and self.current_pane() != event.tab.id[4:]:
            self.show(event.tab.id[4:])

    def action_home(self):
        self.show("home")

    def action_back_to_tab(self):
        ids = self.pane_ids()
        if self.last in ids:
            self.show(self.last)
        elif len(ids) > 1:
            self.show(ids[-1])

    def step_tab(self, step):
        ids = self.pane_ids()
        cur = self.current_pane()
        self.show(ids[(ids.index(cur) + step) % len(ids)] if cur in ids else "home")

    def action_prev_tab(self):
        self.step_tab(-1)

    def action_next_tab(self):
        self.step_tab(1)

    def action_goto_tab(self, n):
        ids = self.pane_ids()
        if n <= len(ids):
            self.show(ids[n - 1])

    # --- data
    @work(thread=True, exclusive=True, group="info")
    def load_info(self):
        info = cli_json("images", "--json", default={})
        self.call_from_thread(setattr, self, "info", info or {})

    @work(thread=True, exclusive=True, group="list")
    def refresh_vms(self):
        vms = cli_json("list", "--json")
        if vms is not None:
            self.call_from_thread(self.show_vms, vms)

    def action_refresh(self):
        self.refresh_vms()

    @on(DataTable.RowSelected, "#vms")
    def row_selected(self):
        self.action_open()

    @while_open
    def show_vms(self, vms):
        open_here = sorted({t.vm_name for t in self.terminals()})
        waiting = sorted({t.vm_name for t in self.terminals() if t.attention})
        seen = (vms, sorted(self.busy), open_here, waiting)
        if seen == getattr(self, "_seen", None):
            return
        self._seen = seen
        self.vms = vms
        t = self.main.query_one("#vms", DataTable)
        current = self.selected_name()
        t.clear()
        for vm in vms:
            agents = vm.get("agents") or [vm.get("agent", "claude")]
            name = ("* " if vm.get("default") else "  ") + vm["name"] + (" [b #ffaf00]●[/]" if vm["name"] in waiting else " ▸" if vm["name"] in open_here else "")
            state = "[cyan]◆[/] " + T("working") if vm["name"] in self.busy else state_mark(vm)
            t.add_row(name, state, gb(vm.get("memory_mb")), str(vm.get("cpus") or "-"), ", ".join(agents),
                      ",".join(map(str, vm.get("ports") or [])) or "-", key=vm["name"])
        if current and current in [v["name"] for v in vms]:
            t.move_cursor(row=[v["name"] for v in vms].index(current))
        self.show_details()
        n = len(vms)
        self.sub_title = (T("{n} VM", n=n) if n == 1 else T("{n} VMs", n=n)) if vms else T("no VMs yet: press n")
        self.main.query_one("#brand", Static).update(f"[b]vmagents[/b] [dim]{self.sub_title}[/]")

    def selected(self):
        t = self.main.query_one("#vms", DataTable)
        if not self.vms or t.cursor_row is None or t.cursor_row >= len(self.vms):
            return None
        return self.vms[t.cursor_row]

    def selected_name(self):
        vm = self.selected()
        return vm["name"] if vm else None

    @on(DataTable.RowHighlighted, "#vms")
    @while_open
    def show_details(self):
        d = self.main.query_one("#details", Static)
        vm = self.selected()
        if not vm:
            d.update(T("[b]No VMs yet.[/b]\n\nPress [b]n[/b] to make one: choose the system, RAM, CPUs, disk, the AI "
                       "assistants and the ports you want.\n\nOr add one you have: vmagents add NAME --host IP"))
            return
        n = vm["name"]
        lines = [f"[b]{n}[/b]  {state_mark(vm)}" + ("  [dim](" + T("default") + ")[/]" if vm.get("default") else "")]
        if vm.get("domain"):
            lines.append(T("libvirt VM {d}", d=vm["domain"])
                         + ("" if vm.get("uri") == "qemu:///system" else f" ({vm['uri']})"))
        else:
            lines.append(f"{vm['user']}@{vm['host']}" + (f":{vm['port']}" if vm["port"] != 22 else ""))
        if vm.get("os") == "windows":
            lines.append("Windows")
        if vm.get("memory_mb"):
            lines.append(T("{ram} RAM · {cpus} CPUs · {snaps} snapshots", ram=gb(vm["memory_mb"]), cpus=vm["cpus"],
                           snaps=vm.get("snapshots", 0)))
        agents = vm.get("agents") or []
        lines.append("")
        lines.append(T("Opens: [b]{agent}[/b]", agent=AGENT_NAMES.get(vm["agent"], vm["agent"]))
                     + (T("   installed: {list}", list=", ".join(agents)) if agents else ""))
        ports = vm.get("ports") or []
        lines.append(T("Ports: {list} (while connected)", list=", ".join(map(str, ports))) if ports
                     else T("Ports: none"))
        for _, desc in self.forwards.get(n, []):
            lines.append(f"  [green]→[/] {desc}")
        project = vm.get("project")
        lines.append(T("Project: {p} → {d} on the VM  [dim](c: changes)[/]", p=home_short(project), d=vm.get("dir"))
                     if project else T("Project: none  [dim](p: send a git repository of this computer)[/]"))
        if terms := self.terminals(n):
            def state(t):
                return (" [b #ffaf00]" + T("waiting") + "[/]" if t.attention
                        else " [cyan]" + T("working") + "[/]" if t.working else "")
            lines.append("")
            lines.append(T("Open here: {list}  [dim](Enter to go back)[/]",
                           list=", ".join(kind_label(t.kind) + state(t) for t in terms)))
        lines.append("")
        lines.append(" · ".join([
            T("idle shutdown {m} min", m=vm["idle"]) if vm.get("idle") else T("no idle shutdown"),
            T("autostop on") if vm.get("autostop") else T("autostop off"),
            T("notifications on") if vm.get("notify") else T("notifications off"),
            T("clipboard on") if vm.get("clipboard") else T("clipboard off")]))
        lines.append("")
        lines.append(T("[dim]From a terminal: vmagents {n}{more}[/]", n=n, more=f" · vmagents open {n}" if ports else ""))
        d.update("\n".join(lines))

    @while_open
    def log_line(self, text):
        self.main.query_one("#log", RichLog).write(text)

    # --- terminals inside the UI, one tab each
    def terminals(self, name=None):
        return [t for t in self.main.query(Terminal) if name is None or t.vm_name == name]

    def creating(self):
        return list(self.main.query(Creating))

    def open_session(self, name, kind):
        """Shows the tab of KIND (shell, login or an AI assistant) on the VM
        NAME, opening it if needed; with no KIND, the VM's last tab."""
        vm = next((v for v in self.vms if v["name"] == name), {"name": name, "agent": "claude"})
        terms = self.terminals(name)
        if kind is None:
            if terms:
                last = self.pane(self.last) if self.last in self.pane_ids() else None
                self.show(last.id if last in terms else terms[-1].id)
            return
        if kind not in ("shell", "login", "claude") and vm.get("os") == "windows":
            self.notify(T("Only Claude Code runs on Windows VMs."))
            return
        for t in terms:
            if t.kind == kind and t.rc is None:
                self.show(t.id)
                return
        self.count += 1
        t = Terminal(kind_command(name, kind), kind_label(kind), id=f"term-{self.count}")
        t.vm_name, t.kind = name, kind
        self.add_pane(t, f"{name} · {kind_label(kind)}")
        self._seen = None

    def action_open_kind(self, kind):
        w = self.pane(self.current_pane())
        if isinstance(w, Terminal):
            self.open_session(w.vm_name, kind)

    @on(Terminal.Exited)
    def exited(self, event):
        """A program ended: its tab closes (the VM's other tab, or the list, shows)."""
        t = event.terminal
        if self.current_pane() != t.id:
            self.close_pane(t.id)
            return
        others = [x for x in self.terminals(t.vm_name) if x is not t]
        self.close_pane(t.id, then=others[-1].id if others else "home")

    def back_to_list(self):
        self._seen = None
        if self.vms:
            self.show_vms(self.vms)

    # --- creating VMs, in a tab
    def start_create(self, v):
        self.count += 1
        c = Creating(v, id=f"create-{self.count}")
        self.add_pane(c, f"{v['name']} · {T('creating…')}")

    def create_finished(self, c):
        self.relabel()
        self.refresh_vms()
        if self.current_pane() != c.id:
            if c.rc == 0:
                self.notify(T("{n} is ready.", n=c.v["name"]))
            else:
                self.notify(T("Creating {n} failed.", n=c.v["name"]), severity="error")

    @work(thread=True)
    def background(self, args, done=None, name=None):
        """Runs vmagents without a terminal; its output goes to the log."""
        if name:
            self.busy.add(name)
            self.call_from_thread(self.refresh_vms)
        self.call_from_thread(self.log_line, "[b]$ vmagents " + shlex.join(args) + "[/b]")
        rc, out, err = cli(*args, timeout=3600)
        for line in (out + err).splitlines():
            if line.strip():
                self.call_from_thread(self.log_line, line)
        if rc != 0:
            self.call_from_thread(self.notify, T("vmagents {cmd} failed (exit code {rc})", cmd=args[0], rc=rc),
                                  severity="error")
        if name:
            self.busy.discard(name)
        if done:
            self.call_from_thread(done, rc)
        self.call_from_thread(self.refresh_vms)

    def need_vm(self, libvirt=False, busy_ok=False):
        vm = self.selected()
        if not vm:
            self.notify(T("No VM selected. Press n to make one."))
            return None
        if vm["name"] in self.busy and not busy_ok:
            self.notify(T("{n} is busy; wait a moment.", n=vm["name"]))
            return None
        if libvirt and not vm.get("domain"):
            self.notify(T("{n} is not a libvirt VM: vmagents cannot start, stop or snapshot it.", n=vm["name"]))
            return None
        return vm

    # --- actions
    def action_open(self):
        if not (vm := self.need_vm(busy_ok=True)):
            return
        if self.terminals(vm["name"]):  # back to what is open there
            self.open_session(vm["name"], None)
            return

        def chosen(kind):
            if kind:
                self.open_session(vm["name"], kind)
        self.push_screen(OpenAs(vm), chosen)

    def action_shell(self):
        if vm := self.need_vm(busy_ok=True):
            self.open_session(vm["name"], "shell")

    def action_project(self):
        if not (vm := self.need_vm()):
            return
        if vm.get("os") == "windows":
            self.notify(T("Projects work with Linux VMs only."))
            return
        n = vm["name"]

        def check(v):
            if not v["folder"]:
                return T("Give a folder.")
            if not git_top(v["folder"]):
                return T("{p} is not in a git repository.", p=v["folder"])
            return ""

        def sent(rc, args):
            if rc == 0:
                self.notify(T("Sent the project to {n}; agents start in it.", n=n))
            elif rc == 5:
                def discard(yes):
                    if yes:
                        self.background(args + ["--discard"], done=lambda rc: sent(rc, args), name=n)
                self.push_screen(Confirm(T("{n} has work on the project that was not taken back (c shows it; t there "
                                           "takes it). Send anyway? That work is set aside on the VM, not deleted.",
                                           n=n), yes=T("Send anyway"), danger=True), discard)

        def chosen(r):
            if r:
                args = ["project", n, os.path.expanduser(r["folder"])]
                self.background(args, done=lambda rc: sent(rc, args), name=n)
        self.push_screen(Ask(T("Send a git repository of this computer to {n}; the agents work on it there, and "
                               "what they do comes back as a branch (c). Sending again brings new commits over.", n=n),
                             [("folder", T("Folder"), home_short(vm.get("project") or HERE), "~/code/app")], check),
                         chosen)

    def action_changes(self):
        if not (vm := self.need_vm(busy_ok=True)):
            return
        if not vm.get("project"):
            self.notify(T("{n} has no project yet: p sends one.", n=vm["name"]))
            return
        for c in self.main.query(Changes):
            if c.vm["name"] == vm["name"]:
                c.vm = vm
                self.show(c.id)
                c.action_load()
                return
        self.count += 1
        self.add_pane(Changes(vm, id=f"changes-{self.count}"), f"{vm['name']} · {T('Changes')}")

    def action_new(self):
        self.push_screen(NewVM(self.info, [v["name"] for v in self.vms]))

    def action_toggle(self):
        if not (vm := self.need_vm(libvirt=True)):
            return
        if vm.get("state") == "running":
            self.background(["stop", vm["name"]], name=vm["name"])
        else:
            self.background(["start", vm["name"]], name=vm["name"])

    def action_snapshots(self):
        if vm := self.need_vm(libvirt=True):
            self.push_screen(Snapshots(vm))

    def action_resize(self):
        if not (vm := self.need_vm(libvirt=True)):
            return
        host = (self.info or {}).get("host", {})

        def chosen(r):
            if not r:
                return
            mem, cpus = r
            if mem == vm.get("memory_mb") and cpus == vm.get("cpus"):
                return
            self.background(["resize", vm["name"], "--memory", str(mem), "--cpus", str(cpus), "--stop"],
                            name=vm["name"])
        self.push_screen(Resize(vm, host), chosen)

    def action_ports(self):
        if not (vm := self.need_vm()):
            return
        n = vm["name"]
        if self.forwards.get(n):
            def stop(yes):
                if yes:
                    self.stop_forwards(n)
            descs = "\n".join(d for _, d in self.forwards[n])
            self.push_screen(Confirm(T("Forwarding now:\n{list}\n\nStop it?", list=descs), yes=T("Stop")), stop)
            return
        current = ",".join(map(str, vm.get("ports") or []))

        def check(v):
            if v["ports"] and not PORTS_RE.match(v["ports"].replace(" ", "")):
                return T("Ports like 3000,5173 (or HERE:VM, e.g. 9000:3000).")
            return ""

        def chosen(r):
            if not r:
                return
            v = r["ports"].replace(" ", "")
            if r.get("save") and ":" not in v:
                self.background(["ports", n, v or "off"])
            if v and r.get("now"):
                self.start_forward(n, v.split(","), r.get("lan"), r.get("browser"))
        self.push_screen(Ask(
            T("Ports of {n} to reach from this computer (a web server the agent started, for example):", n=n),
            [("ports", "", current, "3000,5173")], check,
            extra=[("now", T("Forward them now"), True), ("browser", T("Open them in the browser"), True),
                   ("lan", T("Also reachable from other devices on my network"), False),
                   ("save", T("Forward them every time I connect"), bool(current))]), chosen)

    def start_forward(self, name, ports, lan, browser):
        args = ["open", name, *ports, "--keep"] + ([] if browser else ["--no-browser"]) + (["--lan"] if lan else [])
        self.log_line("[b]$ vmagents " + shlex.join(args) + "[/b]")
        try:
            p = subprocess.Popen([VMAGENTS, *args], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                 stdin=subprocess.DEVNULL, text=True, bufsize=1, start_new_session=True)
        except OSError as e:
            self.notify(str(e), severity="error")
            return
        self.forwards.setdefault(name, [])

        def read():
            for line in p.stdout:
                line = line.rstrip()
                if not line:
                    continue
                self.call_from_thread(self.log_line, line)
                m = re.match(r"Port (\d+) of \S+: (http://\S+)", line)
                if m:
                    self.call_from_thread(self.add_forward, name, p, T("port {p} at {url}", p=m.group(1),
                                                                       url=m.group(2)))
            rc = p.wait()
            self.call_from_thread(self.forward_ended, name, p, rc)
        threading.Thread(target=read, daemon=True).start()

    def add_forward(self, name, p, desc):
        self.forwards.setdefault(name, []).append((p, desc))
        self.show_details()

    def forward_ended(self, name, p, rc):
        had = [f for f in self.forwards.get(name, []) if f[0] is p]
        self.forwards[name] = [f for f in self.forwards.get(name, []) if f[0] is not p]
        if not had and rc not in (0, 130, -2):
            self.notify(T("Forwarding ports of {n} failed; see the log.", n=name), severity="error")
        self.show_details()

    def stop_forwards(self, name=None):
        for n in [name] if name else list(self.forwards):
            for p in {id(p): p for p, _ in self.forwards.get(n, [])}.values():
                if p is not None and p.poll() is None:
                    p.send_signal(signal.SIGINT)
            self.forwards[n] = []
        self.show_details()

    def action_delete(self):
        if not (vm := self.need_vm()):
            return
        n = vm["name"]
        if not vm.get("created"):
            def rm(yes):
                if yes:
                    self.background(["rm", n])
            self.push_screen(Confirm(T("{n} was not made by vmagents, so only its profile can be removed (the VM "
                                       "stays as it is). Remove the profile?", n=n), yes=T("Remove")), rm)
            return

        def sure(yes):
            if yes:
                self.stop_forwards(n)
                self.background(["delete", n, "--yes"], name=n)
        self.push_screen(TypeName(T("[b]Delete {n}[/b] with its disk and snapshots? This cannot be undone.\nType its "
                                    "name to confirm:", n=n), n), sure)

    def action_quit(self):
        count = len(self.terminals())
        making = [c for c in self.creating() if c.running()]
        if not count and not making:
            self.stop_forwards()
            self.exit()
            return

        def sure(yes):
            if yes:
                for t in self.terminals():
                    t.close()
                for c in making:
                    c.cancel()
                self.stop_forwards()
                self.exit()
        text = []
        if count:
            text.append(T("{count} terminal(s) are open. Quit closes them (agents in tmux keep running on the VM).",
                          count=count))
        if making:
            text.append(T("{n} is still being created; quitting stops that.", n=", ".join(c.v["name"] for c in making)))
        self.push_screen(Confirm("\n\n".join(text), yes=T("Quit")), sure)

def main():
    VmAgentsUI().run()


