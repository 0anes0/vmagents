#!/usr/bin/env bash
# vmagents — run AI coding agents (Claude Code, Codex, Gemini CLI, OpenCode,
# aider) inside a virtual machine over SSH, in one step. (Called vmclaude
# before 0.11; the old name, its settings and its VMs keep working.)
# https://github.com/emincan2000/vmagents
# shellcheck disable=SC2317,SC2329 # commands are called by name ("cmd_$cmd" in main)
set -euo pipefail
# Regex ranges like [A-Z] follow the collation: in Turkish "I" is not in
# [A-Z], so "DOMAIN=..." would not parse. Keep the language, sort as C.
if [[ -n ${LC_ALL:-} ]]; then
  export LANG=$LC_ALL
  unset LC_ALL
fi
export LC_COLLATE=C
# Started from the UI under uv: drop its venv, or tools that are Python
# scripts (virt-install) run with a python3 that lacks their modules.
if [[ -n ${VMAGENTS_HOST_PATH:-} ]]; then
  PATH=$VMAGENTS_HOST_PATH
  unset VIRTUAL_ENV VMAGENTS_HOST_PATH
fi

VERSION=0.14.0
PROG=${0##*/}
CONF_DIR=${VMAGENTS_CONFIG_DIR:-${VMCLAUDE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/vmagents}}
HOSTS_DIR=$CONF_DIR/hosts
KNOWN_HOSTS=$CONF_DIR/known_hosts
DEFAULT_KEY=$HOME/.ssh/vmagents_ed25519
# The key made under the old name stays in use.
[[ ! -e $DEFAULT_KEY && -e $HOME/.ssh/vmclaude_ed25519 ]] && DEFAULT_KEY=$HOME/.ssh/vmclaude_ed25519
BOOT_TIMEOUT=${VMAGENTS_BOOT_TIMEOUT:-${VMCLAUDE_BOOT_TIMEOUT:-180}}
STOP_TIMEOUT=${VMAGENTS_STOP_TIMEOUT:-${VMCLAUDE_STOP_TIMEOUT:-120}}
APPS_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/applications
PROFILE_KEYS=" HOST USER PORT IDENTITY DOMAIN LIBVIRT_URI DIR SESSION OS AGENT AGENTS PORTS AUTOSTOP AUTOSNAP IDLE NOTIFY CLIPBOARD PROJECT CREATED "
HOLD=0
AGENTS="claude codex gemini opencode aider"

say()  { printf '%s\n' "$*"; }
info() { printf '%s\n' "$*" >&2; }
warn() { printf '%s: warning: %s\n' "$PROG" "$*" >&2; }
die()  {
  printf '%s: %s\n' "$PROG" "$*" >&2
  hold_prompt
  exit 1
}
usage_error() { printf '%s: %s\n' "$PROG" "$*" >&2; printf "Try '%s help'.\n" "$PROG" >&2; exit 2; }
# In a desktop launcher the terminal closes as soon as we exit; keep it open on errors.
hold_prompt() {
  if [[ $HOLD = 1 && -t 0 ]]; then
    read -r -p "Press Enter to close." _ || true
  fi
}

usage() {
  cat <<EOF
vmagents $VERSION — run AI coding agents inside a virtual machine, over SSH.

Claude Code, Codex, Gemini CLI, OpenCode or aider then work on the VM's files
and programs, not on your computer's. vmagents starts the VM, logs in with its
own SSH key and opens the agent there (Claude Code unless you choose another):
in tmux on Linux VMs, so it keeps running if the connection drops.
When you leave Claude, a libvirt VM that nothing else uses shuts down again;
one left running shuts itself down after 30 idle minutes ("vmagents idle").
Each start takes a snapshot first: "vmagents undo" takes back what Claude did.
When Claude needs you, a desktop notification appears on this computer, and
what you copy on the VM lands in this computer's clipboard.
(vmagents was called vmclaude before 0.11; that name still works.)

GET STARTED
  The easy way: a terminal UI to make, open and manage VMs:
    vmagents ui

  No VM yet? Make one (Linux computer with libvirt):
    vmagents create dev                      new Debian 13 VM with Claude Code, no password
    vmagents create box --image arch         the same with Arch Linux
    vmagents create web --memory 8192 --cpus 4 --agents claude,codex --ports 3000
    vmagents login dev                       log Claude in (browser opens on this computer)
    vmagents dev                             open Claude Code in it

  A VM you already have:
    vmagents add win10 --domain win10 --user emin     a libvirt VM (vmagents starts it)
    vmagents add srv --host 192.168.1.50 --user dev   any machine you can SSH into
    vmagents setup srv                       install SSH key + Claude Code (asks the VM password once)
    vmagents srv                             open Claude Code in it

  Every day:
    vmagents                                 open Claude on the default VM
    vmagents dev --continue                  arguments after the name go to Claude
    vmagents open dev 3000                   a web server on the VM, in your browser here
    vmagents dev --codex                     Codex instead of Claude (also --gemini, --opencode, --aider)

  Work on a project of this computer (a git repository) in the VM:
    vmagents project dev ~/code/app          send it; agents start in it ("vmagents dev")
    vmagents changes dev                     what the agents changed there
    vmagents take dev                        that work as the branch vmagents/dev here (--pr: a pull request)
    ssh dev@VM                               any SSH app opens Claude too (after setup)

COMMANDS
  Make and remove VMs (libvirt):
    create NAME          new Linux VM from an official cloud image, ready for Claude
    delete NAME          delete a VM made with create, with its disks
    images               list the images: which exist, which are downloaded, where
    prune                delete downloaded images that no VM uses any more
    resize NAME          change RAM and CPUs (--memory MB --cpus N)
    ui                   all of this in a terminal UI

  Use a VM:
    connect NAME         open Claude Code ("vmagents NAME" does the same)
    shell NAME [CMD]     a normal shell on the VM, or run one command there
    start NAME           start a libvirt VM and wait until SSH answers
    stop NAME            shut a libvirt VM down (--force: pull the plug)
    open NAME PORT       open the VM's port PORT here (http://localhost:PORT)
    ports NAME 3000,...  ports forwarded each time you connect
    doctor NAME          check VM, network, SSH, key, Claude and tmux, step by step
    login NAME           log Claude in on the VM, with the browser of THIS computer
    mcp NAME --add       let Claude Code on THIS computer work in the VM (run, read, write, edit)
    mount NAME [DIR]     show the VM's folder as a folder here (~/vm/NAME); umount NAME

  Projects (a git repository of this computer, worked on in the VM):
    project NAME [DIR]   send the repository (default: this folder); again: send new commits
    changes NAME         what the agents changed since (commits, and what is not committed)
    take NAME            that work as a branch here (vmagents/NAME); --pr opens a pull request

  Undo (libvirt):
    undo NAME [SNAPSHOT] put the VM back to how it was before this session
    snapshot NAME [NOTE] take a snapshot now; snapshots NAME lists them
    autosnap NAME N|off  how many automatic snapshots to keep (default: 3)

  Profiles (one per VM, in ${CONF_DIR/#$HOME/\~}/hosts/):
    add NAME             add an existing VM, or change the settings of a profile
    setup NAME           install the SSH key, tmux and Claude Code on the VM
    list                 show all profiles; * marks the default
    default NAME         choose the VM that plain "vmagents" opens
    autostart NAME on|off   open Claude on every SSH login, or stop doing so
    autostop NAME on|off    shut the VM down when you leave Claude (default: on)
    idle NAME MINUTES|off   the VM shuts itself down after MINUTES unused (create: 30)
    notify NAME on|off      desktop notifications when Claude needs you (default: on)
    clipboard NAME on|off   what you copy in tmux on the VM lands here (default: on)
    agent NAME [AGENT]      what "vmagents NAME" opens: claude, codex, gemini, opencode, aider
    desktop NAME         add "Claude Code (NAME)" to your app menu
    edit NAME            open the profile file in your editor
    forget NAME          forget the VM's SSH host key (after reinstalling the VM)
    rm NAME              delete the profile only (the VM stays)

MORE HELP
  vmagents help COMMAND     what a command does, its options and examples
                            (e.g. "vmagents help create"; "vmagents create --help" works too)
  vmagents images           where downloaded images and VM disks are stored
EOF
}

help_cmd() { # COMMAND
  local u
  u=$(id -un)
  case $1 in
    create) cat <<EOF
vmagents create NAME [options]

Makes a new Linux VM in libvirt and sets it up for Claude Code. You need
virt-install and virsh (Debian/Ubuntu: sudo apt install virtinst libvirt-daemon-system;
Arch: sudo pacman -S libvirt virt-install libisoburn dnsmasq qemu-desktop, then
sudo systemctl enable --now libvirtd) and your user in the "libvirt" group. No password is set or asked: the VM
lets you in with vmagents's SSH key only, and sudo works without a password.

What happens:
  1. The official cloud image is downloaded once and checked against the
     distribution's published SHA-256/SHA-512 checksum.
  2. It is copied into the libvirt pool as a base image. The new VM gets its
     own small disk that only stores what differs from the base, so more VMs
     from the same image need no download and little space.
  3. cloud-init in the VM creates your user with the SSH key and installs tmux.
  4. "vmagents setup NAME" installs Claude Code and the SSH-login autostart.

Options:
  --image IMAGE    debian13 (default), debian12, ubuntu24.04 or arch
                   ("vmagents images" lists them, with what is downloaded)
  --memory MB      RAM in megabytes          (default 4096)
  --cpus N         virtual CPUs              (default 2)
  --disk GB        disk size in gigabytes    (default 20)
  --user USER      user created in the VM    (default: $u)
  --uri URI        libvirt connection        (default: qemu:///system)
  --agents LIST    AI assistants to install, e.g. claude,codex (default: claude;
                   also gemini, opencode, aider); the first one is what "vmagents NAME" opens
  --ports LIST     ports of the VM to reach here while connected, e.g. 3000,5173
  --idle MINUTES   the VM shuts itself down after MINUTES unused (default 30; off)
  --project DIR    send this computer's git repository DIR to the VM ("vmagents
                   help project"); the agents start in it
  --no-setup       only make the VM; run "vmagents setup NAME" later

Examples:
  vmagents create dev                              Debian 13: 4 GB RAM, 2 CPUs, 20 GB disk
  vmagents create big --memory 16384 --cpus 8 --disk 100
                                                   16 GB RAM, 8 CPUs, 100 GB disk
  vmagents create u24 --image ubuntu24.04          Ubuntu 24.04
  vmagents create box --image arch                 Arch Linux
  VMAGENTS_ARCH_MIRROR=https://mirrors.dotsrc.org/archlinux vmagents create box --image arch
                                                   Arch Linux, image from a faster mirror

Then: "vmagents dev" opens Claude. "vmagents delete dev" removes the VM again.
EOF
      ;;
    delete) cat <<EOF
vmagents delete NAME [--yes]

Deletes a VM that "vmagents create" made: stops it, removes it from libvirt with
its disk and cloud-init disk, and removes its profile. The shared base image
stays (see "vmagents prune"). Asks you to type the name unless --yes is given.

Only VMs made by create can be deleted: both the profile and the VM's libvirt
description must say so. Your other VMs (for example a Windows VM you added
with "vmagents add") are never deleted; "vmagents rm NAME" forgets their profile.

Examples:
  vmagents delete dev
  vmagents delete dev --yes
EOF
      ;;
    images) cat <<EOF
vmagents images [--uri URI] [--json]

Lists the images "vmagents create --image" can use, and for each one whether it
is downloaded, whether a base image of it is in the libvirt pool, its size,
and which VMs use it (--json: the images, and this computer's RAM, CPUs and
free space for new VMs, for scripts and "vmagents ui"). Also shows where all
of it is stored:

  downloads (the original image files):
      ${CACHE_DIR/#$HOME/\~}/images/
  base images, one per image release, shared by the VMs made from it:
      <libvirt pool>/vmagents-base-IMAGE-CHECKSUM.qcow2
  each VM's own disk (only what differs from its base image):
      <libvirt pool>/NAME.qcow2
  each VM's cloud-init settings (user, SSH key):
      <libvirt pool>/NAME-seed.iso

The pool is "$CREATE_POOL" (usually /var/lib/libvirt/images); set VMAGENTS_POOL
for another. Free the space of unused images with "vmagents prune".
EOF
      ;;
    prune) cat <<EOF
vmagents prune [--uri URI]

Deletes base images in the libvirt pool that no VM disk is built on, and the
downloads in ${CACHE_DIR/#$HOME/\~}/images/. Base images that a VM still uses are
kept. The next "vmagents create" downloads again what it needs.

Example:
  vmagents delete dev && vmagents prune
EOF
      ;;
    connect) cat <<EOF
vmagents connect [--keep] [--hold] [--no-tmux] [--codex|--gemini|--aider|--claude] [NAME] [-- ARGS...]
vmagents NAME [CLAUDE_ARGS...]
vmagents

Opens Claude Code on the VM. A libvirt VM is started first if it is off.
Without NAME the default VM is used (see "vmagents default").

On Linux VMs Claude runs in tmux session "claude": if the connection drops,
Claude keeps running and the next connect returns to it. Leave it running on
purpose with Ctrl-b d. Arguments for Claude only apply when a new session
starts. Windows VMs have no tmux; there Claude ends with the connection.

When you quit Claude, a libvirt VM shuts down (autostop), unless something
still uses it: Claude left running in tmux (Ctrl-b d), another vmagents shell,
mount or connection, someone logged in on the VM. It then stays on and says
why. Keep it on every time: "vmagents autostop NAME off".

Before a libvirt VM is started from "shut off", a snapshot is taken:
"vmagents undo NAME" returns to it. While Claude runs (also after Ctrl-b d),
this computer shows a desktop notification when Claude needs you (see
"vmagents help notify"). What you copy in Claude's tmux session lands in
this computer's clipboard (see "vmagents help clipboard").

Options:
  --keep        leave the VM running this time
  --codex, --gemini, --opencode, --aider
                open that agent instead of Claude, in its own tmux session; it
                is installed on the VM the first time (see "vmagents help agent")
  --claude      Claude, when "vmagents agent" chose another one
  --no-tmux     run Claude directly, without tmux
  --hold        keep the terminal open after an error (used by app-menu launchers)
  -- ARGS       everything after -- goes to Claude

Examples:
  vmagents dev
  vmagents dev --continue                    continue the last conversation
  vmagents connect dev -- --model opus       pass options to Claude
  vmagents                                   the default VM
EOF
      ;;
    shell) cat <<EOF
vmagents shell [--keep] NAME [COMMAND...]

Opens a normal shell on the VM (without starting Claude), or runs one command
there and prints its output. A libvirt VM is started if it is off. When you
leave the shell, the VM shuts down like after connect (see "vmagents help
autostop"); --keep leaves it on. A single COMMAND never shuts it down.

Examples:
  vmagents shell dev
  vmagents shell dev df -h
  vmagents shell dev 'cd ~/work && git status'
EOF
      ;;
    doctor) cat <<EOF
vmagents doctor [NAME]

Checks each step of the connection and says which one fails: ssh on this
computer, the key, the libvirt VM state, its IP address, the SSH server, key
login, and on the VM Claude Code, tmux (Linux) or Git (Windows), autostart.
It does not start or change anything.

Example:
  vmagents doctor dev
EOF
      ;;
    add) cat <<EOF
vmagents add NAME [options]

Adds a profile for a VM (or any machine) you already have, or changes settings
of an existing profile: only the options you give change. Then run
"vmagents setup NAME" once.

Options:
  --host HOST        IP or hostname. Optional with --domain (the IP is found)
  --domain DOMAIN    libvirt VM name: vmagents starts it and finds its IP
  --user USER        login user on the VM          (default: $u)
  --port PORT        SSH port                      (default: 22)
  --key FILE         SSH private key               (default: ~/.ssh/vmagents_ed25519)
  --uri URI          libvirt connection            (default: qemu:///system)
  --dir DIR          folder on the VM where Claude starts, created if missing
                     (default: home; ~/work style paths are fine)
  --session NAME     tmux session name             (default: claude)
  --no-tmux          run Claude without tmux
  --os linux|windows normally detected on first connect

Examples:
  vmagents add win10 --domain win10 --user emin              libvirt VM
  vmagents add srv --host 192.168.1.50 --user dev            any SSH machine
  vmagents add vbox --host 127.0.0.1 --port 2222 --user dev  VirtualBox port forward
  vmagents add dev --dir ~/projects/site                     change one setting
EOF
      ;;
    setup) cat <<EOF
vmagents setup NAME [--no-install] [--no-autostart]

Prepares the VM for Claude Code. Safe to run again: done steps are skipped.
  1. SSH key: creates ~/.ssh/vmagents_ed25519 if needed and adds it to the VM.
     The VM password is asked once, for this step only.
  2. Linux: tmux (with the VM's package manager and sudo) and Claude Code.
     Windows: Git for Windows and Claude Code.
  3. Autostart: SSH logins open Claude (Linux: ~/.bashrc and ~/.zshrc;
     Windows: the PowerShell profile).

Options:
  --no-install      only step 1
  --no-autostart    skip step 3

Example:
  vmagents add srv --host 192.168.1.50 --user dev && vmagents setup srv
EOF
      ;;
    start) cat <<EOF
vmagents start NAME

Starts a libvirt VM (or resumes a paused one) and waits until it has an IP
address and its SSH server answers. connect, shell, mount and mcp do this by
themselves; use start to boot a VM ahead of time.

Example:
  vmagents start dev
EOF
      ;;
    stop) cat <<EOF
vmagents stop NAME [--force]

Shuts a libvirt VM down the clean way, like pressing its power button, and
waits until it is off (at most ${STOP_TIMEOUT}s; VMAGENTS_STOP_TIMEOUT changes this).
Claude sessions still running in tmux on the VM end with it.

Options:
  --force       pull the plug at once (virsh destroy): unsaved data in the VM is lost

Examples:
  vmagents stop dev
  vmagents stop win10 --force         when Windows does not react
EOF
      ;;
    autostop) cat <<EOF
vmagents autostop NAME on|off

With "on" (the default for libvirt VMs), the VM shuts down when you leave
Claude ("vmagents NAME") or "vmagents shell NAME", so it does not use RAM and
CPU in the background. It stays on, and says why, while something still uses
it:
  - Claude left running in tmux (you pressed Ctrl-b d)
  - another vmagents connect, shell or mount to this VM from this computer
  - someone logged in on the VM (another SSH login; on Windows, the screen)
  - a Claude process still running on the VM
It also stays on when the connection broke rather than ended.
"vmagents NAME --keep" leaves it on once. Plain ssh logins (autostart) do not
shut it down: vmagents is not running then.

Examples:
  vmagents autostop dev off          the VM keeps running after you leave
  vmagents autostop dev on
  vmagents stop dev                  shut it down by hand
EOF
      ;;
    snapshot | snapshots) cat <<EOF
vmagents snapshots NAME [--json]
vmagents snapshot NAME [--name SNAPSHOT] [LABEL]
vmagents snapshot NAME --label SNAPSHOT LABEL
vmagents snapshot NAME --delete SNAPSHOT

A snapshot saves the whole VM (its disk; for a running VM its memory too),
so "vmagents undo" can return to it. vmagents takes one by itself each time
it starts the VM ("auto-..."; see "vmagents help autosnap"). snapshot takes
one now, named "snap-DATE-TIME" or what you give with --name, with an
optional label; these are never deleted automatically. --label changes the
label of any snapshot. snapshots lists them all, oldest first.

They live inside the VM's disk file (libvirt internal snapshots) and need
a qcow2 disk. They take space as the VM changes after them.

Examples:
  vmagents snapshot dev "before the big refactor"
  vmagents snapshot dev --name clean-install "fresh, with Node"
  vmagents snapshot dev --label auto-20261016-224745 "worked fine here"
  vmagents snapshots dev
  vmagents snapshot dev --delete snap-20261016-224927
EOF
      ;;
    undo) cat <<EOF
vmagents undo NAME [SNAPSHOT] [--yes]

Puts the VM back to a snapshot: by default the newest one, which vmagents
took right before it last started the VM, so this takes back everything
done since then: Claude's changes, installed programs, deleted files. A
running VM is stopped first. Asks before it does anything, unless --yes.

Examples:
  vmagents undo dev                         back to before this session
  vmagents snapshots dev                    which snapshots there are
  vmagents undo dev snap-20261016-224927    back to a particular one
EOF
      ;;
    autosnap) cat <<EOF
vmagents autosnap NAME on|off|N

Each time vmagents starts a libvirt VM that is off (connect, shell, mount,
mcp, start), it first takes a snapshot named auto-DATE-TIME. That takes a
moment, since the VM is off. The newest N are kept (default 3), older
automatic ones are deleted; snapshots you took with "vmagents snapshot"
are never deleted.

Examples:
  vmagents autosnap dev 10      keep the newest 10
  vmagents autosnap dev off     take none
  vmagents autosnap dev on      back to 3
EOF
      ;;
    idle) cat <<EOF
vmagents idle NAME MINUTES|off

Installs a small service on the VM that shuts it down after MINUTES in which
nothing used it. "vmagents create" sets 30. This covers what autostop cannot:
Claude left running in tmux after it finished, a plain ssh login that ended,
a VM you forgot. Used means:
  Linux:   an SSH session (a shell, a command, a mount), a console login,
           Claude Code working (from its hooks, see "vmagents help notify"),
           or a busy CPU (load average 1 or more)
  Windows: an SSH connection, someone signed in on the screen, Claude running
Claude waiting for you counts as unused; its conversation is saved, so
"vmagents NAME --continue" resumes it.

Linux VMs need systemd and sudo (asked for the password if needed); Windows
VMs an administrator account (a scheduled task runs as SYSTEM).

Examples:
  vmagents idle dev 30
  vmagents idle dev 120     for long jobs that do not keep the CPU busy
  vmagents idle dev off
EOF
      ;;
    notify) cat <<EOF
vmagents notify NAME on|off

While Claude runs on the VM, also after you detached with Ctrl-b d, this
computer shows a desktop notification when Claude needs you: it asks for
permission, or it finished and waited a minute for your answer.

How: "vmagents NAME" keeps two files in ~/.config/vmagents on the VM:
hook.sh and claude-settings.json, which vmagents passes to Claude with
--settings (your own ~/.claude/settings.json is not changed). Claude's hooks
note there what Claude does (on Windows they run with Git Bash, which Claude
Code needs there anyway). A small background process here asks the VM every
15 seconds and stops when Claude has ended or the VM is off.
Needs notify-send here (Debian/Ubuntu: sudo apt install libnotify-bin).

Examples:
  vmagents notify dev off
  vmagents notify dev on
EOF
      ;;
    open) cat <<EOF
vmagents open [NAME] [PORT...] [--no-browser] [--keep] [--lan]

Makes port PORT of the VM a port of this computer, over SSH, and opens
http://localhost:PORT in your browser: for the web server or app Claude
started on the VM. It also works when that server only listens on the VM's
localhost, and for VMs elsewhere. When PORT is taken here, the next free one
is used (it says which). LOCAL:PORT picks the port here yourself.

Without PORT: the ports set with "vmagents ports NAME". --lan makes them
reachable from other devices on your network too (http://THIS-COMPUTER:PORT);
without it only from this computer.

It runs until Ctrl-C; then the VM shuts down if nothing else uses it, as
after connect (--keep: leave it on).

Examples:
  vmagents open dev 3000
  vmagents open dev 5173 8080            two ports
  vmagents open dev 9000:3000            the VM's 3000 as localhost:9000
  vmagents open 3000 --no-browser        the default VM; only forward
EOF
      ;;
    project) cat <<EOF
vmagents project NAME [FOLDER] [--discard | --off]

Sends a git repository of this computer (the one FOLDER is in; default: the
current folder, or the project NAME already has) to the VM, into
~/projects/FOLDERNAME there, checked out on the same branch. From then on the
agents start in it ("vmagents NAME", the UI's tabs). The VM needs no access to
GitHub: the commits go over vmagents's SSH connection, as a git bundle. Only
commits go; what is not committed here stays here.

Send it again to bring new commits over. That replaces the VM's copy, so it is
refused while the VM has work that was not taken back ("vmagents take").
--discard sends anyway; the VM keeps that work in a ref,
refs/vmagents/discarded/TIME. --off forgets the project (the copy stays).
A libvirt VM that was off is started, and shut down again afterwards.

Examples:
  vmagents project dev ~/code/app
  vmagents create web --project ~/code/app     a new VM with the project in it
EOF
      ;;
    changes) cat <<EOF
vmagents changes NAME [--stat]

Shows what changed in the project on the VM since it was sent: the commits
the agents made, and what is not committed there (new files too, but not
ignored ones), as one diff. --stat: the files only. Nothing on the VM changes.
EOF
      ;;
    take) cat <<EOF
vmagents take NAME [--branch BRANCH] [--pr]

Brings the work done in the project on the VM to this computer's repository,
as the branch vmagents/NAME (or BRANCH), pointing at the agents' commits plus
one commit with what they did not commit. Your checkout is not touched: look
at it, then merge it (git merge vmagents/NAME). --pr also pushes the branch to
origin and opens a pull request with the GitHub CLI (gh).

After merging, "vmagents project NAME" sends the result back, and the agents
go on from there.

Examples:
  vmagents take dev
  vmagents take dev --branch feature/health --pr
EOF
      ;;
    ports) cat <<EOF
vmagents ports NAME [PORT,PORT...|off]

Ports of the VM that become ports of this computer each time you connect
("vmagents NAME"), as long as you stay connected: http://localhost:PORT reaches
the web server or app Claude started on the VM. A port taken here is skipped
(it says so). Without a list it shows them; "vmagents open NAME" forwards them
without connecting. "vmagents create --ports" sets them for a new VM.

Examples:
  vmagents ports dev 3000,5173
  vmagents ports dev off
EOF
      ;;
    resize) cat <<EOF
vmagents resize NAME [--memory MB] [--cpus N] [--stop]

Changes how much RAM and how many CPUs a libvirt VM has. The VM has to be
off: --stop shuts it down first (otherwise it says so). The disk keeps its
size; it grows as it fills, up to the size given to create.

Examples:
  vmagents resize dev --memory 8192
  vmagents resize dev --cpus 4 --stop
EOF
      ;;
    ui) cat <<EOF
vmagents ui

A terminal UI for everything vmagents does, usable without a mouse. The list
shows your VMs with their state, RAM, CPUs, AI assistants and ports; on the
right the details of the selected one. Keys on the list:
  j / k    down / up (or the arrow keys)
  Enter, l open the VM: it asks how (a shell, Claude Code, Codex, Gemini CLI,
           OpenCode, aider, or logging Claude in) and opens it inside the UI,
           in a terminal tab; Enter on a VM with open tabs goes back to them
  s        a shell on the VM, straight away
  n        new VM: name, system, RAM, CPUs, disk, AI assistants, ports, idle
           shutdown; it shows the same "vmagents create" command line
  u        snapshots: pick one with j/k and go back to it (Enter), take one
