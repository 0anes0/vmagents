# ------------------------------------------------------------------ profiles

valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
profile_file() { printf '%s/%s.conf' "$HOSTS_DIR" "$1"; }
profile_exists() { valid_name "$1" && [[ -f $(profile_file "$1") ]]; }

profile_names() {
  local f
  [[ -d $HOSTS_DIR ]] || return 0
  for f in "$HOSTS_DIR"/*.conf; do
    [[ -f $f ]] || continue
    f=${f##*/}
    printf '%s\n' "${f%.conf}"
  done
}

# Profiles are KEY=VALUE files. They are parsed, never sourced.
declare -A P=()
read_profile() {
  local name=$1 file line k v n=0
  file=$(profile_file "$name")
  P=()
  [[ -f $file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ $line =~ ^([A-Z_]+)=(.*)$ ]] || die "$file:$n: expected KEY=VALUE"
    k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
    [[ $PROFILE_KEYS == *" $k "* ]] || die "$file:$n: unknown key $k"
    P[$k]=$v
  done <"$file"
}

write_profile() {
  local name=$1 file tmp k
  file=$(profile_file "$name")
  mkdir -p "$HOSTS_DIR"
  tmp=$(mktemp "$HOSTS_DIR/.tmp.XXXXXX")
  {
    printf '# vmagents profile "%s"\n' "$name"
    for k in $PROFILE_KEYS; do
      [[ -v P[$k] ]] && printf '%s=%s\n' "$k" "${P[$k]}"
    done
  } >"$tmp"
  mv -f "$tmp" "$file"
}

HOST_RE='^[]A-Za-z0-9._:%[-]+$' # names, IPv4, IPv6 (optionally [bracketed], %zone)
agent_list_ok() { # claude,codex
  local a
  [[ $1 =~ ^[a-z]+(,[a-z]+)*$ ]] || return 1
  for a in ${1//,/ }; do [[ " $AGENTS " == *" $a "* ]] || return 1; done
}
port_list_ok() { # 3000,5173
  local p
  [[ $1 =~ ^[0-9]+(,[0-9]+)*$ ]] || return 1
  for p in ${1//,/ }; do ((10#$p >= 1 && 10#$p <= 65535)) || return 1; done
}
check_value() { # KEY VALUE
  local k=$1 v=$2
  [[ $v != *$'\n'* ]] || die "$k must be a single line"
  case $k in
    HOST) [[ $v =~ $HOST_RE && $v != -* ]] || die "invalid host: $v" ;;
    USER) [[ $v =~ ^[A-Za-z0-9._][A-Za-z0-9._-]*$ ]] || die "invalid user: $v" ;;
    PORT) if ! [[ $v =~ ^[0-9]+$ ]] || ((v < 1 || v > 65535)); then die "invalid port: $v"; fi ;;
    DOMAIN) [[ -n $v && $v != -* ]] || die "invalid libvirt domain: $v" ;;
    SESSION) [[ $v =~ ^[A-Za-z0-9_-]*$ ]] || die "invalid tmux session name: $v (letters, digits, _ and - only)" ;;
    OS) [[ $v == linux || $v == windows ]] || die "invalid OS: $v (linux or windows)" ;;
    AGENT) [[ " $AGENTS " == *" $v "* ]] || die "invalid agent: $v (one of: $AGENTS)" ;;
    AGENTS) agent_list_ok "$v" || die "invalid AGENTS: $v (a comma-separated list of: $AGENTS)" ;;
    PORTS) port_list_ok "$v" || die "invalid PORTS: $v (a comma-separated list of ports, e.g. 3000,5173)" ;;
    AUTOSTOP | NOTIFY | CLIPBOARD) [[ $v == on || $v == off ]] || die "invalid $k: $v (on or off)" ;;
    AUTOSNAP | IDLE) [[ $v =~ ^[0-9]+$ ]] || die "invalid $k: $v (a number)" ;;
  esac
}

# Load NAME into the effective connection settings (C_*).
NAME='' C_HOST='' C_USER='' C_PORT='' C_KEY='' C_DOMAIN='' C_URI='' C_DIR='' C_SESSION='' C_OS='' C_AGENT=claude
load() {
  NAME=$1
  valid_name "$NAME" || die "invalid profile name: $NAME"
  profile_exists "$NAME" || die "no VM profile named '$NAME' (see: $PROG list)"
  read_profile "$NAME"
  local k
  for k in HOST USER PORT DOMAIN SESSION OS AGENT AGENTS PORTS AUTOSTOP AUTOSNAP IDLE NOTIFY CLIPBOARD; do
    [[ -v P[$k] && -n ${P[$k]} ]] && check_value "$k" "${P[$k]}"
  done
  C_HOST=${P[HOST]:-}
  C_USER=${P[USER]:-$(id -un)}
  C_PORT=${P[PORT]:-22}
  C_KEY=${P[IDENTITY]:-$DEFAULT_KEY}
  # shellcheck disable=SC2088 # a literal "~/" from the profile file
  [[ $C_KEY == "~/"* ]] && C_KEY=$HOME/${C_KEY#"~/"}
  C_DOMAIN=${P[DOMAIN]:-}
  C_URI=${P[LIBVIRT_URI]:-qemu:///system}
  C_DIR=${P[DIR]:-}
  C_SESSION=${P[SESSION]-claude}
  C_OS=${P[OS]:-}
  C_AGENT=${P[AGENT]:-claude}
  [[ -n $C_HOST || -n $C_DOMAIN ]] || die "profile '$NAME' has neither HOST nor DOMAIN"
}

default_name() {
  local d names count
  if [[ -f $CONF_DIR/default ]]; then
    d=$(<"$CONF_DIR/default")
    if profile_exists "$d"; then printf '%s\n' "$d"; return 0; fi
  fi
  names=$(profile_names)
  count=$(grep -c . <<<"$names" || true)
  if ((count == 1)); then printf '%s\n' "$names"; return 0; fi
  return 1
}

# ------------------------------------------------------------------ libvirt

vsh() { virsh -c "$C_URI" "$@"; }

ensure_running() {
  local out state
  command -v virsh >/dev/null || die "virsh not found, but profile '$NAME' uses libvirt domain '$C_DOMAIN'"
  out=$(vsh domstate "$C_DOMAIN" 2>&1) || die "libvirt: ${out:-cannot read state of $C_DOMAIN}"
  state=${out%%$'\n'*}
  case $state in
    running) ;;
    paused)
      info "Resuming VM $C_DOMAIN..."
      out=$(vsh resume "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
    pmsuspended)
      info "Waking VM $C_DOMAIN..."
      out=$(vsh dompmwakeup "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
    "in shutdown")
      info "VM $C_DOMAIN is shutting down; waiting to start it again..."
      wait_off "$STOP_TIMEOUT" || die "VM $C_DOMAIN is still shutting down after ${STOP_TIMEOUT}s"
      auto_snapshot
      info "Starting VM $C_DOMAIN..."
      out=$(vsh start "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
    *)
      [[ $state == "shut off" ]] && auto_snapshot
      info "Starting VM $C_DOMAIN..."
      out=$(vsh start "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
  esac
}

domstate() { local s; s=$(vsh domstate "$C_DOMAIN" 2>/dev/null) || return 1; printf '%s' "${s%%$'\n'*}"; }

# True once the VM is off (or gone); false after $1 seconds.
wait_off() {
  local deadline=$((SECONDS + $1)) s
  while s=$(domstate) && [[ $s != "shut off" && $s != crashed ]]; do
    ((SECONDS < deadline)) || return 1
    sleep 1
  done
  return 0
}

# Shuts the VM down like its power button would (ACPI), and waits for it.
stop_vm() { # 0|1 (1: pull the plug)
  command -v virsh >/dev/null || die "virsh not found"
  local state out
  state=$(domstate) || die "libvirt: cannot read the state of $C_DOMAIN"
  case $state in
    "shut off" | crashed) info "VM $C_DOMAIN is already off."; return 0 ;;
  esac
  if (($1)); then
    out=$(vsh destroy "$C_DOMAIN" 2>&1) || die "libvirt: $out"
    info "VM $C_DOMAIN is off (forced)."
    return 0
  fi
  case $state in
    paused) out=$(vsh resume "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
    pmsuspended) out=$(vsh dompmwakeup "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
  esac
  if [[ $state != "in shutdown" ]]; then
    out=$(vsh shutdown "$C_DOMAIN" 2>&1) || die "libvirt: $out"
  fi
  info "Shutting down VM $C_DOMAIN... (Ctrl-C stops the waiting, not the shutdown)"
  if wait_off "$STOP_TIMEOUT"; then
    info "VM $C_DOMAIN is off."
  else
    warn "VM $C_DOMAIN is still running after ${STOP_TIMEOUT}s. Pull the plug: $PROG stop $NAME --force"
    return 1
  fi
}

# Sets FOUND_IP to the first IPv4 address of the domain (not on lo).
FOUND_IP=
find_ip() {
  local src
  FOUND_IP=
  for src in lease agent arp; do
    FOUND_IP=$(vsh domifaddr "$C_DOMAIN" --source "$src" 2>/dev/null |
      awk '$1 != "-" { iface = $1 } $3 == "ipv4" && iface != "lo" { sub(/\/.*/, "", $4); print $4; exit }') || true
    [[ -n $FOUND_IP ]] && return 0
  done
  return 1
}

# Fails early when the VM stops while we wait for it.
check_still_running() {
  local state
  state=$(vsh domstate "$C_DOMAIN" 2>/dev/null) || return 0
  state=${state%%$'\n'*}
  [[ $state == running || $state == paused ]] ||
    die "VM $C_DOMAIN stopped while booting (state: $state); see: virsh -c $C_URI console $C_DOMAIN"
}

# With ufw on (default: drop), the VM's DHCP request on a libvirt bridge with
# no allow rule gets no answer. Prints how to allow it, or nothing.
firewall_hint() {
  systemctl is-active --quiet ufw 2>/dev/null || return 0
  local net br
  net=$(vsh domiflist "$C_DOMAIN" 2>/dev/null | awk '$2 == "network" { print $3; exit }')
  [[ -n $net ]] && br=$(vsh net-info "$net" 2>/dev/null | awk '/^Bridge:/ { print $2 }')
  br=${br:-virbr0}
  printf 'ufw is on and may block DHCP on %s. Allow the VM network with:\n' "$br"
  printf '  sudo ufw allow in on %s && sudo ufw route allow in on %s && sudo ufw route allow out on %s\n' "$br" "$br" "$br"
  printf 'then restart the VM: virsh -c %s reboot %s' "$C_URI" "$C_DOMAIN"
}

wait_for_ip() {
  local deadline=$((SECONDS + BOOT_TIMEOUT)) noted=0 hinted=0 hint
  until find_ip; do
    check_still_running
    if ((SECONDS >= deadline)); then
      hint=$(firewall_hint)
      die "VM $C_DOMAIN has no IPv4 address after ${BOOT_TIMEOUT}s (is its network up? set --host to skip detection)${hint:+$'\n'$hint}"
    fi
    ((noted)) || { info "Waiting for $C_DOMAIN to get an IP address..."; noted=1; }
    if ((!hinted && SECONDS > deadline - BOOT_TIMEOUT + 30)); then
      hinted=1
      hint=$(firewall_hint)
      [[ -z $hint ]] || info "Still no IP address. $hint"
    fi
    sleep 2
  done
}

# True once an SSH server answers with its banner. A bare TCP connect is not
# enough: NAT port forwards (passt, slirp, VirtualBox) accept connections
# before the VM's sshd is up.
# Sets BANNER, e.g. "SSH-2.0-OpenSSH_for_Windows_9.5".
BANNER=
# shellcheck disable=SC2016
ssh_ready() {
  local b
  b=$(timeout 5 bash -c 'exec 3<>"/dev/tcp/$1/$2" && IFS= read -r -t 4 line <&3 && printf "%s" "$line"' \
    _ "$1" "$2" 2>/dev/null) || return 1
  [[ $b == SSH-* ]] || return 1
  BANNER=${b%$'\r'}
}

# Sets C_OS from the profile, or once from the SSH banner (then saved).
detect_os() {
  [[ -n $C_OS ]] && return 0
  [[ -n $BANNER ]] || ssh_ready "$TARGET" "$C_PORT" || { C_OS=linux; return 0; }
  if [[ $BANNER == *[Ww]indows* ]]; then C_OS=windows; else C_OS=linux; fi
  P[OS]=$C_OS
  write_profile "$NAME"
  [[ $C_OS == windows ]] && info "Detected a Windows VM."
  return 0
}

wait_for_port() {
  local host=$1 port=$2 deadline=$((SECONDS + BOOT_TIMEOUT)) noted=0
  until ssh_ready "$host" "$port"; do
    [[ -n $C_DOMAIN ]] && check_still_running
    ((SECONDS < deadline)) || die "no SSH server answers on $host:$port after ${BOOT_TIMEOUT}s (is sshd installed and running on the VM?)"
    ((noted)) || { info "Waiting for SSH on $host:$port..."; noted=1; }
    sleep 2
  done
}

# Sets TARGET: starts the VM and waits for it when it is a libvirt domain.
TARGET=
resolve_target() {
  if [[ -n $C_DOMAIN ]]; then
    ensure_running
    if [[ -n $C_HOST ]]; then
      TARGET=$C_HOST
    else
      wait_for_ip
      TARGET=$FOUND_IP
    fi
    wait_for_port "$TARGET" "$C_PORT"
  else
    TARGET=$C_HOST
  fi
  detect_os
}

# ------------------------------------------------------------------ ssh

# The host key is stored under an alias, so a VM whose DHCP address changes
# keeps its identity, and in vmagents's own known_hosts file.
SSH_OPTS=()
build_ssh_opts() {
  mkdir -p "$CONF_DIR"
  SSH_OPTS=(-l "$C_USER" -p "$C_PORT"
    -o "HostKeyAlias=vmagents-$NAME"
    -o "UserKnownHostsFile=$KNOWN_HOSTS"
    -o StrictHostKeyChecking=accept-new
    -o ConnectTimeout=15
    -o ServerAliveInterval=30 -o ServerAliveCountMax=4)
  if [[ -f $C_KEY ]]; then
    SSH_OPTS+=(-i "$C_KEY" -o IdentitiesOnly=yes)
  fi
}

# -t (allocate a terminal on the VM) when we have one, else -T. Not called
# as $(...): stdout would be a pipe there.
TTY_FLAG=-T
[[ -t 0 && -t 1 ]] && TTY_FLAG=-t

# Quote for a POSIX shell (also safe in bash, zsh and fish).
sq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# remote_cmd SCRIPT ARGS... -> one command line that runs SCRIPT with ARGS
# under sh on the VM, whatever the user's login shell is.
remote_cmd() {
  local out a
  out="sh -c $(sq "$1") vmagents"
  shift
  for a in "$@"; do out+=" $(sq "$a")"; done
  printf '%s' "$out"
}

# --- scripts that run on the VM (POSIX sh) ---

# Before 0.11 vmagents kept its files on the VM in ~/.config/vmclaude: move
# them once, and leave a link, so older hooks and autostart lines still work.
# shellcheck disable=SC2016
MIGRATE_SH='[ -d "$HOME/.config/vmclaude" ] && [ ! -L "$HOME/.config/vmclaude" ] && [ ! -e "$HOME/.config/vmagents" ] &&
  mv "$HOME/.config/vmclaude" "$HOME/.config/vmagents" && ln -s vmagents "$HOME/.config/vmclaude"
'
# shellcheck disable=SC2016
REMOTE_ENV=$MIGRATE_SH'PATH="$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.claude/local:$HOME/bin:$PATH"; export PATH
cd_dir() {
  case $1 in
    "") cd || return 1; return 0 ;;
    "~") set -- "$HOME" ;;
    "~/"*) set -- "$HOME/${1#"~/"}" ;;
  esac
  [ -d "$1" ] || { mkdir -p "$1" && echo "vmagents: created $1 on the VM" >&2; } || return 1
  cd "$1"
}
'

# Starts "$2 ..." with the variables from file $1 in its environment (the
# token from "vmagents login", other agents' API keys), and for Claude with
# vmagents's hooks (claude-settings.json in the same folder). A wrapper, not
# tmux -e: tokens stay out of command lines.
# shellcheck disable=SC2016
CLAUDE_ENV_SH='[ -r "$1" ] && { set -a; . "$1"; set +a; }; s=${1%/*}/claude-settings.json; shift; c=$1; shift; case ${c##*/} in claude) [ -r "$s" ] && exec "$c" --settings "$s" "$@" ;; esac; exec "$c" "$@"'

# ------------------------------------------------------------------ hooks, idle shutdown, notifications
# Claude Code on the VM runs hook.sh from its hooks (loaded with --settings
# by vmagents's launcher). It records whether Claude is working, for the idle
# shutdown, and queues "Claude needs you" messages, which the watcher on this
# computer shows as desktop notifications. connect keeps both files current.
IFS= read -r -d '' HOOK_SH <<'EOS' || true
#!/bin/sh
# Installed by vmagents: Claude Code runs this from the hooks in
# claude-settings.json next to it. It tells the VM's idle shutdown whether
# Claude is working, and queues "Claude needs you" messages that vmagents
# shows on your computer as desktop notifications.
d=$HOME/.config/vmagents
case ${1-} in
  busy | idle) cat >/dev/null; echo "$1" >"$d/claude-state" ;;
  notify)
    echo idle >"$d/claude-state"
    m=$(sed -n 's/.*"message" *: *"\([^"]*\)".*/\1/p' | head -n 1 | tr '\t' ' ')
    t=$(date +%s%3N 2>/dev/null)
    case $t in "" | *[!0-9]*) t=$(date +%s)000 ;; esac
    printf '%s\t%s\t%s\n' "$t" "${PWD##*/}" "${m:-Claude is waiting for you}" >>"$d/events"
    if [ "$(wc -l <"$d/events")" -gt 200 ]; then
      tail -n 100 "$d/events" >"$d/events.tmp" && mv -f "$d/events.tmp" "$d/events"
    fi ;;
esac
exit 0
EOS
HOOK_SH=${HOOK_SH%$'\n'}

hook_entry() { # MATCHER|"" ARG
  # shellcheck disable=SC2016 # $HOME is for the VM's shell
  printf '[{%s"hooks": [{"type": "command", "command": "sh \\"$HOME/.config/vmagents/hook.sh\\" %s"}]}]' \
    "${1:+\"matcher\": \"$1\", }" "$2"
}
CLAUDE_SETTINGS="{
  \"hooks\": {
    \"UserPromptSubmit\": $(hook_entry '' busy),
    \"PreToolUse\": $(hook_entry '*' busy),
    \"PostToolUse\": $(hook_entry '*' busy),
    \"Stop\": $(hook_entry '' idle),
    \"Notification\": $(hook_entry '' notify)
  }
}"

# Runs as root on the VM (systemd service vmagents-idle): powers it off after
# $1 minutes in which nothing used it.
IFS= read -r -d '' IDLE_LOOP_SH <<'EOS' || true
#!/bin/sh
# Installed by vmagents ("vmagents idle NAME MINUTES"): powers this VM off
# after MINUTES in which nothing used it. Used means: an SSH session (a shell,
# a command, an sftp mount; not vmagents's notification watcher), a console
# login, Claude Code working (its vmagents hooks say so), or load >= 1.
limit=$((${1:-30} * 60)) step=${2:-60}

in_use() {
  for p in $(cat /proc/[0-9]*/status 2>/dev/null | awk '
      /^Name:/ { n = $2 } /^Pid:/ { p = $2 } /^PPid:/ { name[p] = n; pp[p] = $2 }
      END { for (p in pp) if (name[pp[p]] ~ /^sshd(-session)?$/ && name[p] !~ /^sshd(-session|-auth)?$/) print p }'); do
    tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null | grep -q vmagents-watch || { echo "SSH session"; return 0; }
  done
  who 2>/dev/null | grep -qv '(tmux(' && { echo "login"; return 0; }
  for u in $(ps -C claude -o uid= 2>/dev/null | sort -u); do
    f=$(getent passwd "$u" | cut -d: -f6)/.config/vmagents/claude-state
    [ "$(cat "$f" 2>/dev/null)" = idle ] && continue
    # "busy" left by an interrupted answer (no Stop hook then) expires
    [ -f "$f" ] && [ -z "$(find "$f" -mmin -120 2>/dev/null)" ] && continue
    echo "Claude Code working"; return 0
  done
  awk '{ exit !($2 >= 1) }' /proc/loadavg && { echo "load"; return 0; }
  return 1
}

since=$(date +%s) prev=$since
while sleep "$step"; do
  now=$(date +%s)
  # A jump in time: the VM was paused or suspended. Count again from now.
  [ $((now - prev)) -gt $((step * 5)) ] && since=$now
  prev=$now
  if in_use >/dev/null; then since=$now; continue; fi
  if [ $((now - since)) -ge "$limit" ]; then
    echo "vmagents: unused for ${1:-30} minutes, powering off"
    systemctl poweroff
    exit 0
  fi
done
EOS

# $1 minutes (0: remove), $2 the idle script. Needs root or sudo.
IFS= read -r -d '' IDLE_INSTALL_SH <<'EOS' || true
m=$1
if [ "$(id -u)" = 0 ]; then su_=
elif command -v sudo >/dev/null 2>&1; then su_=sudo
else echo "vmagents: idle shutdown needs root or sudo on the VM" >&2; exit 1
fi
command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ] ||
  { echo "vmagents: idle shutdown needs systemd on the VM" >&2; exit 1; }
unit=/etc/systemd/system/vmagents-idle.service
if [ -f /etc/systemd/system/vmclaude-idle.service ]; then  # from before 0.11
  $su_ sh -c "systemctl disable --now vmclaude-idle.service >/dev/null 2>&1; rm -f /etc/systemd/system/vmclaude-idle.service /usr/local/libexec/vmclaude-idle"
fi
if [ "$m" = 0 ]; then
  $su_ sh -c "systemctl disable --now vmagents-idle.service >/dev/null 2>&1; rm -f $unit /usr/local/libexec/vmagents-idle; systemctl daemon-reload" || exit 1
  echo "Idle shutdown is off."
  exit 0
fi
printf '%s' "$2" | $su_ sh -c 'mkdir -p /usr/local/libexec && cat >/usr/local/libexec/vmagents-idle && chmod 755 /usr/local/libexec/vmagents-idle' || exit 1
printf '%s\n' "[Unit]" "Description=vmagents: power off after $m minutes without use" "" "[Service]" \
  "ExecStart=/bin/sh /usr/local/libexec/vmagents-idle $m" "Restart=always" "" "[Install]" "WantedBy=multi-user.target" |
  $su_ sh -c "cat >$unit" || exit 1
$su_ systemctl daemon-reload && $su_ systemctl enable vmagents-idle.service >/dev/null 2>&1 &&
  $su_ systemctl restart vmagents-idle.service || exit 1
echo "Idle shutdown is on: the VM powers off after $m minutes without use."
EOS

# Windows: the same as a SYSTEM task that starts with Windows.
IFS= read -r -d '' WIN_IDLE_LOOP_PS <<'EOS' || true
param([int]$Minutes = 30, [int]$Step = 60)
# Installed by vmagents ("vmagents idle NAME MINUTES"): shuts this VM down
# after $Minutes minutes in which nothing used it: no SSH connection, nobody
# signed in on the screen, no Claude Code running.
$since = Get-Date
$prev = $since
while ($true) {
  Start-Sleep -Seconds $Step
  $now = Get-Date
  # A jump in time: the VM was paused, suspended or woke from fast startup.
  if (($now - $prev).TotalSeconds -gt $Step * 5) { $since = $now }
  $prev = $now
  $sshd = @(Get-Process sshd -ErrorAction SilentlyContinue | ForEach-Object { $_.Id })
  $ports = @(Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue | Where-Object { $sshd -contains $_.OwningProcess } | ForEach-Object { $_.LocalPort })
  $use = @(Get-NetTCPConnection -State Established -ErrorAction SilentlyContinue | Where-Object { $ports -contains $_.LocalPort }).Count -gt 0
  if (-not $use) { $use = [bool](Get-CimInstance Win32_ComputerSystem -ErrorAction SilentlyContinue).UserName }
  if (-not $use) { $use = [bool](Get-Process claude -ErrorAction SilentlyContinue) }
  if ($use) { $since = $now; continue }
  if (($now - $since).TotalMinutes -ge $Minutes) { Stop-Computer -Force; break }
}
EOS

win_idle_ps() { # MINUTES
  cat <<EOF
\$ErrorActionPreference = "Stop"
\$m = $1
\$d = Join-Path \$env:ProgramData "vmagents"
\$f = Join-Path \$d "idle.ps1"
try {
  foreach (\$old in "vmagents-idle", "vmclaude-idle") {
    if (Get-ScheduledTask -TaskName \$old -ErrorAction SilentlyContinue) {
      Stop-ScheduledTask -TaskName \$old -ErrorAction SilentlyContinue
      Unregister-ScheduledTask -TaskName \$old -Confirm:\$false
    }
  }
  if (\$m -eq 0) { Remove-Item -LiteralPath \$f -ErrorAction SilentlyContinue; "Idle shutdown is off."; exit 0 }
  New-Item -ItemType Directory -Force -Path \$d | Out-Null
  [IO.File]::WriteAllText(\$f, $(psq "$WIN_IDLE_LOOP_PS"), (New-Object Text.UTF8Encoding \$true))
  \$a = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-NoProfile -NonInteractive -ExecutionPolicy Bypass -File \`"\$f\`" -Minutes \$m"
  \$t = New-ScheduledTaskTrigger -AtStartup
  \$s = New-ScheduledTaskSettingsSet -ExecutionTimeLimit ([TimeSpan]::Zero) -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -RestartCount 999 -RestartInterval (New-TimeSpan -Minutes 1)
  \$p = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest
  Register-ScheduledTask -TaskName vmagents-idle -Action \$a -Trigger \$t -Settings \$s -Principal \$p -Force | Out-Null
  Start-ScheduledTask -TaskName vmagents-idle
} catch {
  [Console]::Error.WriteLine("vmagents: setting up idle shutdown failed (an administrator account is needed): \$_")
  exit 1
}
"Idle shutdown is on: the VM shuts down after \$m minutes without use."
EOF
}

# Polled by the watcher ($1: last event id seen, "" on the first poll).
# The marker on the first line lets the idle shutdown ignore this session
# (the old name too, for idle services installed before 0.11).
IFS= read -r -d '' WATCH_SH <<'EOS' || true
: vmagents-watch vmclaude-watch
n=$(pgrep -c -x claude 2>/dev/null) || true
echo "claude=${n:-0}"
t=$(date +%s%3N 2>/dev/null)
case $t in "" | *[!0-9]*) t=$(date +%s)000 ;; esac
echo "now=$t"
f=$HOME/.config/vmagents/events
[ -n "$1" ] && [ -f "$f" ] && awk -F '\t' -v t="$1" '$1 + 0 > t + 0' "$f"
exit 0
EOS

# Runs on the VM while you are connected: prints each new tmux paste buffer
# (what you copy in tmux, and what Claude Code copies: it uses
# "tmux load-buffer" inside tmux) in base64, one per line. The empty lines in
# between notice a closed connection: writing to it ends the script.
IFS= read -r -d '' CLIP_SH <<'EOS' || true
command -v tmux >/dev/null 2>&1 && command -v base64 >/dev/null 2>&1 || exit 0
top() { tmux list-buffers -F "#{buffer_name} #{buffer_created} #{buffer_size}" 2>/dev/null | head -n 1; }
last=$(top)
while echo; do
  sleep 0.5 2>/dev/null || sleep 1
  b=$(top)
  [ "$b" = "$last" ] && continue
  last=$b
  [ -n "$b" ] && tmux show-buffer -b "${b%% *}" 2>/dev/null | base64 | tr -d "\n"
done
EOS

# The same for Windows VMs. Claude Code runs hooks with Git Bash there, so
# hook.sh works as it is.
win_watch_ps() { # LAST_ID
  cat <<EOF
# vmagents-watch
"claude=" + @(Get-Process claude -ErrorAction SilentlyContinue).Count
"now=" + [DateTimeOffset]::UtcNow.ToUnixTimeMilliseconds()
\$last = $(psq "$1")
\$f = Join-Path \$env:USERPROFILE ".config\vmagents\events"
if (\$last -ne "" -and (Test-Path -LiteralPath \$f)) {
  foreach (\$l in [IO.File]::ReadAllLines(\$f)) { \$p = \$l -split "\`t", 3; if (\$p.Count -eq 3 -and [long]\$p[0] -gt [long]\$last) { \$l } }
}
EOF
}

# Writes hook.sh and claude-settings.json on a Windows VM. (On Linux VMs the
# connect script does that; on Windows its command line has no room.)
win_hooks_ps() {
  cat <<EOF
\$o = Join-Path \$env:USERPROFILE ".config\\vmclaude"
\$n = Join-Path \$env:USERPROFILE ".config\\vmagents"
if ((Test-Path -LiteralPath \$o) -and -not (Get-Item -LiteralPath \$o).LinkType -and -not (Test-Path -LiteralPath \$n)) {
  Move-Item -LiteralPath \$o -Destination \$n
  New-Item -ItemType Junction -Path \$o -Target \$n | Out-Null
}
\$d = Join-Path \$env:USERPROFILE ".config\vmagents"
New-Item -ItemType Directory -Force -Path \$d | Out-Null
\$u = New-Object Text.UTF8Encoding \$false
[IO.File]::WriteAllText((Join-Path \$d "hook.sh"), $(psq "$HOOK_SH"$'\n'), \$u)
[IO.File]::WriteAllText((Join-Path \$d "claude-settings.json"), $(psq "$CLAUDE_SETTINGS"$'\n'), \$u)
EOF
}

# $1 dir, $2 tmux session ("" = no tmux), $3 profile name, $4 agent
# (claude, codex, ...), rest: its arguments. Exits 120 when another agent
# than Claude is not installed: vmagents installs it then.
# shellcheck disable=SC2016
CONNECT_SH=$REMOTE_ENV"CLAUDE_ENV_SH=$(sq "$CLAUDE_ENV_SH")
VMAGENTS_HOOK=$(sq "$HOOK_SH")
VMAGENTS_SETTINGS=$(sq "$CLAUDE_SETTINGS")"'
h=$HOME/.config/vmagents
if mkdir -p "$h" 2>/dev/null; then
  [ "$(cat "$h/hook.sh" 2>/dev/null)" = "$VMAGENTS_HOOK" ] || printf "%s\n" "$VMAGENTS_HOOK" >"$h/hook.sh"
  [ "$(cat "$h/claude-settings.json" 2>/dev/null)" = "$VMAGENTS_SETTINGS" ] || printf "%s\n" "$VMAGENTS_SETTINGS" >"$h/claude-settings.json"
fi
d=$1; s=$2; n=$3; a=$4; shift 4
cd_dir "$d" || { echo "vmagents: cannot use directory $d on the VM" >&2; exit 1; }
if ! c=$(command -v "$a"); then
  [ "$a" = claude ] || exit 120
  echo "vmagents: Claude Code is not installed on the VM. Run: vmagents setup $n" >&2; exit 127
fi
if [ -n "${TERM-}" ] && command -v tput >/dev/null 2>&1 && ! tput -T "$TERM" longname >/dev/null 2>&1; then
  TERM=xterm-256color; export TERM
fi
if [ -n "$s" ] && command -v tmux >/dev/null 2>&1; then
  exec tmux new-session -A -s "$s" -c "$PWD" sh -c "$CLAUDE_ENV_SH" vmagents "$HOME/.config/vmagents/$a-env" "$c" "$@"
fi
exec sh -c "$CLAUDE_ENV_SH" vmagents "$HOME/.config/vmagents/$a-env" "$c" "$@"
'

# Reads one public key on stdin and adds it to authorized_keys once.
# shellcheck disable=SC2016
ADDKEY_SH='umask 077
k=$(cat)
case $k in ssh-*|ecdsa-*|sk-*) ;; *) echo "vmagents: not a public key" >&2; exit 1 ;; esac
mkdir -p "$HOME/.ssh" || exit 1
f=$HOME/.ssh/authorized_keys
touch "$f" || exit 1
if [ -s "$f" ] && [ "$(tail -c 1 "$f" | wc -l)" -eq 0 ]; then echo >>"$f"; fi
grep -qxF "$k" "$f" || printf "%s\n" "$k" >>"$f"
chmod 600 "$f"; chmod 700 "$HOME/.ssh"
'

# shellcheck disable=SC2016
INSTALL_SH=$REMOTE_ENV'if command -v cloud-init >/dev/null 2>&1; then
  case $(cloud-init status 2>/dev/null) in
    *running* | *"not started"*) echo "Waiting for cloud-init to finish..."; cloud-init status --wait >/dev/null 2>&1 ;;
  esac
fi
need=
command -v tmux >/dev/null 2>&1 || need="$need tmux"
command -v git >/dev/null 2>&1 || need="$need git"  # for projects (vmagents project), and the agents use it
# $1: "no" leaves Claude Code out (another agent only).
cl=${1:-yes}
[ "$cl" = no ] || command -v claude >/dev/null 2>&1 || command -v curl >/dev/null 2>&1 || need="$need curl"
if [ -n "$need" ]; then
  echo "Installing:$need"
  if [ "$(id -u)" = 0 ]; then su_=
  elif command -v sudo >/dev/null 2>&1; then su_=sudo
  else su_=none
  fi
  if [ "$su_" = none ]; then
    echo "vmagents: cannot install$need without root or sudo; install it yourself" >&2
  elif command -v apt-get >/dev/null 2>&1; then
    $su_ apt-get update -qq && $su_ env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq -o Dpkg::Use-Pty=0 $need
  elif command -v dnf >/dev/null 2>&1; then $su_ dnf install -y $need
  elif command -v yum >/dev/null 2>&1; then $su_ yum install -y $need
  elif command -v pacman >/dev/null 2>&1; then
    $su_ pacman -S --needed --noconfirm $need || $su_ pacman -Syu --needed --noconfirm $need
  elif command -v zypper >/dev/null 2>&1; then $su_ zypper --non-interactive install $need
  elif command -v apk >/dev/null 2>&1; then $su_ apk add $need
  else echo "vmagents: no known package manager; install$need yourself" >&2
  fi || echo "vmagents: installing$need failed" >&2
fi
if [ "$cl" = no ]; then
  :
elif command -v claude >/dev/null 2>&1; then
  echo "Claude Code is already installed: $(claude --version 2>/dev/null || echo unknown version)"
else
  command -v curl >/dev/null 2>&1 || { echo "vmagents: curl is missing; cannot install Claude Code" >&2; exit 1; }
  echo "Installing Claude Code (a download of about 270 MB)..."
  curl -fsSL https://claude.ai/install.sh | bash &
  pid=$! i=0
  while kill -0 "$pid" 2>/dev/null; do
    sleep 1; i=$((i + 1))
    if [ $((i % 10)) -eq 0 ] && kill -0 "$pid" 2>/dev/null; then
      echo "  ...still installing, $(du -sm "$HOME/.claude/downloads" 2>/dev/null | cut -f1) MB downloaded after ${i}s"
    fi
  done
  wait "$pid"
  command -v claude >/dev/null 2>&1 || { echo "vmagents: Claude Code installation failed" >&2; exit 1; }
  echo "Installed Claude Code: $(claude --version 2>/dev/null || echo unknown version)"
fi
command -v tmux >/dev/null 2>&1 || echo "vmagents: tmux is not available; the agent will stop when the connection drops" >&2
exit 0
'

# pkg PACKAGE...: installs with the VM's package manager (root or sudo).
# shellcheck disable=SC2016
PKG_SH='if [ "$(id -u)" = 0 ]; then su_=
elif command -v sudo >/dev/null 2>&1; then su_=sudo
else su_=none
fi
pkg() {
  echo "Installing: $*"
  if [ "$su_" = none ]; then echo "vmagents: cannot install $* without root or sudo; install it yourself" >&2; return 1
  elif command -v apt-get >/dev/null 2>&1; then
    $su_ apt-get update -qq && $su_ env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq -o Dpkg::Use-Pty=0 "$@"
  elif command -v dnf >/dev/null 2>&1; then $su_ dnf install -y "$@"
  elif command -v pacman >/dev/null 2>&1; then
    # A stale package list fails with 404s: then sync and upgrade (Arch has no partial upgrades).
    $su_ pacman -S --needed --noconfirm "$@" || $su_ pacman -Syu --needed --noconfirm "$@"
  elif command -v zypper >/dev/null 2>&1; then $su_ zypper --non-interactive install "$@"
  elif command -v apk >/dev/null 2>&1; then $su_ apk add "$@"
  else echo "vmagents: no known package manager; install $* yourself" >&2; return 1
  fi
}
'

# Installs another agent than Claude ($1) for the user, in ~/.local/bin.
# shellcheck disable=SC2016
AGENT_INSTALL_SH=$REMOTE_ENV'a=$1
if command -v "$a" >/dev/null 2>&1; then echo "$a is already installed."; exit 0; fi
'$PKG_SH'command -v curl >/dev/null 2>&1 || pkg curl || exit 1
mkdir -p "$HOME/.local/bin" || exit 1
case $a in
  codex)
    echo "Installing Codex (its own installer, from chatgpt.com/codex)..."
    curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh || { echo "vmagents: installing Codex failed" >&2; exit 1; } ;;
  gemini)
    node_ok() { command -v npm >/dev/null 2>&1 && node -e "process.exit(parseInt(process.versions.node) >= 20 ? 0 : 1)" 2>/dev/null; }
