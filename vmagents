    @on(Select.Changed)
    @on(Checkbox.Changed)
    def changed(self):
        self.query_one("#error", Static).update("")
        self.refresh_command()

    @on(Button.Pressed, "#back")
    def back(self):
        self.app.pop_screen()

    @on(Button.Pressed, "#create")
    def action_create(self):
        if self.query_one("#create", Button).disabled:
            return
        v = self.values()
        if err := self.problem(v):
            self.query_one("#error", Static).update(err)
            return
        self.app.pop_screen()
        self.app.start_create(v)


class Creating(Vertical):
    """A tab that runs "vmagents create" and shows what it prints. The rest of
    the UI stays usable meanwhile (Ctrl+] or Esc: the list)."""
    BINDINGS = [Binding("escape", "app.home", show=False)]

    def __init__(self, v, **kw):
        super().__init__(**kw)
        self.v, self.proc, self.rc = v, None, None

    def compose(self):
        yield Static(T("[b]Creating {n}[/b]: downloading the image (once), making the VM, then installing tmux and "
                       "the AI assistants. This takes a few minutes.", n=self.v["name"]), id="status")
        yield RichLog(id="output", wrap=True, markup=False)
        with Horizontal(classes="buttons"):
            agent = self.v["agents"][0]
            yield Button(T("Open {agent}", agent=AGENT_NAMES[agent]), id="open", variant="success", disabled=True)
            yield Button(T("Shell"), id="shell", disabled=True)
            if "claude" in self.v["agents"]:
                yield Button(T("Log Claude in"), id="login", disabled=True)
            yield Button(T("Cancel"), id="cancel", variant="error")
            yield Button(T("Close"), id="back", disabled=True)

    def on_mount(self):
        self.run_create()

    def focus_default(self):
        b = [b for b in self.query(Button) if not b.disabled and b.id != "cancel"]
        try:
            (b[0] if b else self.query_one("#output", RichLog)).focus()
        except NoMatches:  # not there yet
            self.call_after_refresh(self.focus_default)

    def status_label(self):
        if self.rc is None:
            return T("creating…")
        return T("ready") if self.rc == 0 else T("failed")

    @work(thread=True)
    def run_create(self):
        log = self.query_one("#output", RichLog)
        args = create_args(self.v)
        self.app.call_from_thread(log.write, "$ vmagents " + shlex.join(args))
        try:
            self.proc = subprocess.Popen([VMAGENTS, *args], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                         stdin=subprocess.DEVNULL, text=True, bufsize=1, start_new_session=True)
        except OSError as e:
            self.app.call_from_thread(log.write, str(e))
            self.app.call_from_thread(self.finished, 1)
            return
        for line in self.proc.stdout:
            self.app.call_from_thread(log.write, line.rstrip("\n").replace("\r", ""))
        self.app.call_from_thread(self.finished, self.proc.wait())

    def finished(self, rc):
        self.rc = rc
        status = self.query_one("#status", Static)
        if rc == 0:
            status.update(T("[green]Done.[/] {n} is ready.", n=self.v["name"]))
            for b in self.query(Button):
                b.disabled = b.id == "cancel"
            self.query_one("#open", Button).focus()
        else:
            status.update(T("[red]Creating {n} failed[/] (exit code {rc}); see above. If a half-made VM is left, "
                            "delete it in the list (d).", n=self.v["name"], rc=rc))
            self.query_one("#cancel", Button).disabled = True
            self.query_one("#back", Button).disabled = False
        self.app.create_finished(self)

    @on(Button.Pressed, "#cancel")
    def cancel(self):
        if self.proc and self.proc.poll() is None:
            os.killpg(self.proc.pid, signal.SIGTERM)

    def running(self):
        return self.rc is None and self.proc is not None and self.proc.poll() is None

    @on(Button.Pressed, "#open")
    def open_vm(self):
        self.app.open_session(self.v["name"], self.v["agents"][0])
        self.app.close_pane(self.id)

    @on(Button.Pressed, "#shell")
    def open_shell(self):
        self.app.open_session(self.v["name"], "shell")
        self.app.close_pane(self.id)

    @on(Button.Pressed, "#login")
    def login(self):
        self.app.open_session(self.v["name"], "login")
        self.app.close_pane(self.id)

    @on(Button.Pressed, "#back")
    def close(self):
        if self.rc is not None:
            self.app.close_pane(self.id)


