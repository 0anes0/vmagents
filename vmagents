    .buttons { height: auto; margin-top: 1; }
    .buttons Button { margin-right: 2; }
    .error { color: $error; height: auto; }
    .command { margin-top: 1; height: auto; }
    .intro { margin-bottom: 1; }
    #form { padding: 1 2; }
