    node_ok || { echo "vmagents: Gemini CLI needs Node.js 20 or newer; the VM has $(node --version 2>/dev/null || echo none)" >&2; exit 1; }
    echo "Installing Gemini CLI..."
    npm install -g --prefix "$HOME/.local" --no-fund --no-audit --loglevel=error @google/gemini-cli || { echo "vmagents: installing Gemini CLI failed" >&2; exit 1; } ;;
  opencode)
    command -v bash >/dev/null 2>&1 && command -v tar >/dev/null 2>&1 || pkg bash tar || exit 1
    echo "Installing OpenCode (its own installer, from opencode.ai)..."
    curl -fsSL https://opencode.ai/install | bash || { echo "vmagents: installing OpenCode failed" >&2; exit 1; } ;;
  aider)
    echo "Installing aider..."
    curl -LsSf https://aider.chat/install.sh | sh || { echo "vmagents: installing aider failed" >&2; exit 1; } ;;
