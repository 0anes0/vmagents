esac
command -v "$a" >/dev/null 2>&1 || { echo "vmagents: $a was installed but is not on PATH" >&2; exit 1; }
echo "Installed $a: $("$a" --version 2>/dev/null | head -n 1)"
'

# $1 on|off; with "on" the hook body comes on stdin.
# shellcheck disable=SC2016
AUTOSTART_SH=$MIGRATE_SH'umask 022
d=$HOME/.config/vmagents
hook=$d/autostart.sh
begin="# >>> vmagents autostart >>>"
end="# <<< vmagents autostart <<<"
oldb="# >>> vmclaude autostart >>>"
olde="# <<< vmclaude autostart <<<"
strip() {
  [ -f "$1" ] || return 0
  awk -v b="$begin" -v e="$end" -v ob="$oldb" -v oe="$olde" \
    "\$0 == b || \$0 == ob { skip = 1; next } \$0 == e || \$0 == oe { skip = 0; next } !skip" "$1" >"$1.vmagents.tmp" &&
    cat "$1.vmagents.tmp" >"$1" && rm -f "$1.vmagents.tmp"
}
rcs="$HOME/.bashrc"
case ${SHELL-} in */zsh) rcs="$rcs $HOME/.zshrc" ;; esac
[ -f "$HOME/.zshrc" ] && case $rcs in *zshrc*) ;; *) rcs="$rcs $HOME/.zshrc" ;; esac
for rc in $rcs; do strip "$rc" || exit 1; done
if [ "$1" = off ]; then
  rm -f "$hook"
  echo "Autostart is off."
  exit 0
fi
mkdir -p "$d" || exit 1
cat >"$hook" || exit 1
for rc in $rcs; do
  [ -f "$rc" ] && [ -s "$rc" ] && [ "$(tail -c 1 "$rc" | wc -l)" -eq 0 ] && echo >>"$rc"
  printf "%s\n%s\n%s\n%s\n%s\n" "$begin" \
    "case \":\$PATH:\" in *\":\$HOME/.local/bin:\"*) ;; *) PATH=\"\$HOME/.local/bin:\$PATH\" ;; esac" \
    "[ -r \"\$HOME/.config/vmagents/claude-env\" ] && { set -a; . \"\$HOME/.config/vmagents/claude-env\"; set +a; }" \
    "[ -r \"\$HOME/.config/vmagents/autostart.sh\" ] && . \"\$HOME/.config/vmagents/autostart.sh\"" "$end" >>"$rc" || exit 1
done
echo "Autostart is on: SSH logins open Claude Code (quit Claude to get a shell)."
'

# The hook sourced from ~/.bashrc / ~/.zshrc on the VM.
autostart_hook() { # DIR SESSION
  cat <<EOF
# Installed by vmagents: open Claude Code on interactive SSH logins.
# Quit Claude (or detach tmux with Ctrl-b d) to get a normal shell.
# Skip it once:  ssh -o SetEnv=LC_VMAGENTS=off ...   Turn it off:  vmagents autostart NAME off
case \$- in *i*) ;; *) return 0 2>/dev/null || exit 0 ;; esac
if [ -n "\${SSH_CONNECTION-}" ] && [ -z "\${TMUX-}" ] && [ -z "\${VMAGENTS_NO_AUTOSTART-}\${VMCLAUDE_NO_AUTOSTART-}" ] && [ "\${LC_VMAGENTS-}" != off ] && [ "\${LC_VMCLAUDE-}" != off ] && [ -t 0 ] && [ -t 1 ]; then
  VMAGENTS_NO_AUTOSTART=1; export VMAGENTS_NO_AUTOSTART
  case ":\$PATH:" in *":\$HOME/.local/bin:"*) ;; *) PATH="\$HOME/.local/bin:\$PATH"; export PATH ;; esac
  vmagents_dir=$(sq "$1")
  case \$vmagents_dir in "") vmagents_dir=\$HOME ;; "~") vmagents_dir=\$HOME ;; "~/"*) vmagents_dir=\$HOME/\${vmagents_dir#"~/"} ;; esac
  if command -v claude >/dev/null 2>&1; then
    if [ -n $(sq "$2") ] && command -v tmux >/dev/null 2>&1; then
      tmux new-session -A -s $(sq "$2") -c "\$vmagents_dir" sh -c $(sq "$CLAUDE_ENV_SH") vmagents "\$HOME/.config/vmagents/claude-env" "\$(command -v claude)"
    else
      (cd "\$vmagents_dir" 2>/dev/null; exec sh -c $(sq "$CLAUDE_ENV_SH") vmagents "\$HOME/.config/vmagents/claude-env" claude)
    fi
  fi
  unset vmagents_dir
fi
EOF
}

# ------------------------------------------------------------------ Windows VMs
# Windows OpenSSH runs commands with cmd.exe or PowerShell, depending on its
# DefaultShell. Both can start `powershell -EncodedCommand BASE64`, which needs
# no quoting at all; values go into the script as PowerShell literals.

# Quote for PowerShell as a single-quoted literal. PowerShell also takes the
# curly quotes U+2018..U+201B as single quotes, so those are doubled too.
psq() {
  local s=$1 q
  for q in "'" $'\xe2\x80\x98' $'\xe2\x80\x99' $'\xe2\x80\x9a' $'\xe2\x80\x9b'; do
    s=${s//"$q"/"$q$q"}
  done
  printf "'%s'" "$s"
}

ps_array() { # ARGS... -> @('a', 'b')
  local out="@(" a sep=""
  for a in "$@"; do out+="$sep$(psq "$a")"; sep=", "; done
  printf '%s)' "$out"
}

# win_cmd [-i] [-noexit] SCRIPT -> a command line for the VM's default shell
win_cmd() {
  local flags="-NoLogo -NoProfile -NonInteractive" script enc
  while [[ $1 == -* ]]; do
    case $1 in
      -i) flags="-NoLogo -NoProfile" ;;
      -noexit) flags="-NoLogo -NoProfile -NoExit" ;;
    esac
    shift
  done
  script="\$ProgressPreference = 'SilentlyContinue'"$'\n'"try { [Console]::OutputEncoding = [Text.Encoding]::UTF8 } catch { }"$'\n'$1
  enc=$(printf '%s' "$script" | iconv -f UTF-8 -t UTF-16LE | base64 -w 0) || die "iconv/base64 failed"
  # cmd.exe accepts at most 8191 characters per command line.
  ((${#enc} < 8000)) || die "internal error: Windows command too long (${#enc})"
  printf 'powershell %s -ExecutionPolicy Bypass -EncodedCommand %s' "$flags" "$enc"
}

# Runs a longer script: it travels gzipped inside the command line and runs
# from a temporary .ps1 file, so `exit N` works. (Not on stdin: with
# PowerShell as OpenSSH's DefaultShell, stdin over 4 KB hangs. And with that
# DefaultShell every non-zero exit code reaches us as 1.)
win_run() { # SCRIPT
  local gz
  gz=$(printf '%s' "$1" | gzip -9n | base64 -w 0) || die "gzip/base64 failed"
  run_ssh -T -- "$TARGET" "$(win_cmd "\$z = New-Object IO.Compression.GZipStream (New-Object IO.MemoryStream (,[Convert]::FromBase64String('$gz'))), ([IO.Compression.CompressionMode]::Decompress)
\$f = Join-Path \$env:TEMP (\"vmagents-\" + [guid]::NewGuid() + \".ps1\")
[IO.File]::WriteAllText(\$f, (New-Object IO.StreamReader \$z, ([Text.Encoding]::UTF8)).ReadToEnd(), (New-Object Text.UTF8Encoding \$true))
try { & \$f; \$rc = \$LASTEXITCODE } finally { Remove-Item -LiteralPath \$f -ErrorAction SilentlyContinue }
exit \$rc")" </dev/null
}

