class Snapshots(Screen):
    """All snapshots of a VM: go back to one, take one, label one, delete one."""

    def __init__(self, vm):
        super().__init__()
        self.vm, self.snaps = vm, []
        self._bindings = BindingsMap(self.make_bindings())

    @staticmethod
    def make_bindings():
        return [Binding("enter", "restore", T("Go back to it")), Binding("n", "take", T("Take one")),
                Binding("e", "label", T("Edit label")), Binding("d", "delete", T("Delete")),
                Binding("escape", "app.pop_screen", T("Back to the list")),
                Binding("h", "app.pop_screen", T("Back"), show=False)]

    def compose(self):
        yield Header()
        yield Static(f"[b]{T('Snapshots of {n}', n=self.vm['name'])}[/b]", id="snaptitle")
        yield VimTable(id="snaps", cursor_type="row", zebra_stripes=True)
        yield Static(T("[dim]j/k: move · Enter or l: go back to it · n: take one · e: label · d: delete · h or Esc: "
                       "back[/]"), id="snaphelp")
        yield Footer()

    def on_mount(self):
        t = self.query_one(DataTable)
        t.add_columns(T("Name"), T("Time"), T("State"), T("Label"))
        t.focus()
        self.load()

    @work(thread=True, exclusive=True)
    def load(self):
        snaps = cli_json("snapshots", self.vm["name"], "--json", default=[]) or []
        self.app.call_from_thread(self.show, snaps)

    def show(self, snaps):
        self.snaps = list(reversed(snaps))  # newest first
        t = self.query_one(DataTable)
        t.clear()
        for s in self.snaps:
            t.add_row(s["name"], s["time"], T("VM on") if s["state"] == "running" else T("VM off"),
                      s.get("description") or "", key=s["name"])
        if not self.snaps:
            self.query_one("#snaphelp", Static).update(T("No snapshots yet. One is taken each time vmagents starts "
                                                         "the VM; n takes one now."))

    def selected(self):
        t = self.query_one(DataTable)
        if not self.snaps or t.cursor_row is None or t.cursor_row >= len(self.snaps):
            return None
        return self.snaps[t.cursor_row]

    def run(self, args):
        self.app.background(args, done=lambda rc: self.load(), name=self.vm["name"])

    @on(DataTable.RowSelected)
    def action_restore(self):
        if not (s := self.selected()):
            return
        n = self.vm["name"]

        def sure(yes):
            if yes:
                self.run(["undo", n, s["name"], "--yes"])
        self.app.push_screen(Confirm(T("Put {n} back to [b]{snap}[/b]?\nEverything changed in the VM since then is "
                                       "lost.", n=n, snap=s["name"]), yes=T("Restore"), danger=True), sure)

    def action_take(self):
        names = {s["name"] for s in self.snaps}

        def check(v):
            if v["name"] and not SNAP_RE.match(v["name"]):
                return T("A name may have letters, digits, . _ and - only.")
            if v["name"] in names:
                return T("There is a snapshot named {s} already.", s=v["name"])
            return ""

        def done(v):
            if v is not None:
                self.run(["snapshot", self.vm["name"]] + (["--name", v["name"]] if v["name"] else [])
                         + ([v["label"]] if v["label"] else []))
        self.app.push_screen(Ask(T("New snapshot of {n}", n=self.vm["name"]), [
            ("name", T("Name [dim](letters, digits, . _ -; empty: automatic)[/]"), "", "before-refactor"),
            ("label", T("Label [dim](optional, e.g. before the big refactor)[/]"), "", "")], check), done)

    def action_label(self):
        if not (s := self.selected()):
            return

        def done(v):
            if v is not None:
                self.run(["snapshot", self.vm["name"], "--label", s["name"], v["label"]])
        self.app.push_screen(Ask(T("Label of {snap}:", snap=s["name"]),
                                 [("label", "", s.get("description") or "", "")]), done)

    def action_delete(self):
        if not (s := self.selected()):
            return

        def sure(yes):
            if yes:
                self.run(["snapshot", self.vm["name"], "--delete", s["name"]])
        self.app.push_screen(Confirm(T("Delete the snapshot [b]{snap}[/b] of {n}?", snap=s["name"], n=self.vm["name"]),
                                     yes=T("Delete"), danger=True), sure)


