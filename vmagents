class VMTable(VimTable):
    pass


def while_open(f):
    """For what threads and timers call: does nothing once the app is closing
    (its widgets are gone then)."""
    @functools.wraps(f)
    def run(self, *args):
        try:
            return f(self, *args)
        except (NoMatches, IndexError):
            if self.screen_stack and self.main.query("#vms"):
                raise  # not closing: a real mistake
    return run


LIST_ACTIONS = {"open", "new", "shell", "ports", "toggle", "snapshots", "resize", "delete", "language", "quit",
                "refresh", "project", "changes"}
SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
TAB_ACTIONS = {"home", "back_to_tab", "prev_tab", "next_tab", "goto_tab", "open_kind"}


class VmAgentsUI(App):
