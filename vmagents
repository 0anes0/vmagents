LANG = "en"


def T(text, **kw):
    s = TEXTS.get(LANG, {}).get(text, text)
    return s.format(**kw) if kw else s


def conf_dir():
    return os.environ.get("VMAGENTS_CONF_DIR") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "vmagents")


def load_lang():
    try:
        with open(os.path.join(conf_dir(), "ui.json")) as f:
            lang = json.load(f).get("lang")
        if lang in dict(LANGUAGES):
            return lang
    except (OSError, ValueError, AttributeError):
        pass
    env = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    return "tr" if env.lower().startswith("tr") else "en"


def save_lang(lang):
    try:
        os.makedirs(conf_dir(), exist_ok=True)
        with open(os.path.join(conf_dir(), "ui.json"), "w") as f:
            json.dump({"lang": lang}, f)
    except OSError:
        pass


# ------------------------------------------------------------------ helpers

def cli(*args, timeout=120):
    """Runs vmagents; returns (exit code, stdout, stderr)."""
    try:
        r = subprocess.run([VMAGENTS, *args], capture_output=True, text=True, stdin=subprocess.DEVNULL,
                           timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def cli_json(*args, default=None):
    rc, out, _ = cli(*args)
    if rc != 0:
        return default
    try:
        return json.loads(out)
    except ValueError:
        return default


def gb(mb):
    if mb is None:
        return "-"
    return f"{mb / 1024:.1f}".rstrip("0").rstrip(".") + " GB"


def state_mark(vm):
    s = vm.get("state")
    if s is None:
        return "[dim]-[/] " + T("not libvirt")
    marks = {"running": "[green]●[/] ", "shut off": "[dim]○[/] ", "paused": "[yellow]●[/] ", "missing": "[red]![/] "}
    words = {"running": "running", "shut off": "off", "paused": "paused", "missing": "missing"}
    return marks.get(s, "[yellow]●[/] ") + T(words.get(s, s))


def idle_label(m):
    return {0: T("off"), 15: T("15 minutes"), 30: T("30 minutes"), 60: T("1 hour"), 120: T("2 hours"),
            240: T("4 hours")}[m]


def create_args(v):
    """The "vmagents create" arguments for the form values v (a dict)."""
    a = ["create", v["name"], "--image", v["image"], "--memory", str(v["memory"]), "--cpus", str(v["cpus"]),
         "--disk", str(v["disk"]), "--agents", ",".join(v["agents"]), "--idle", str(v["idle"] or "off")]
    if v["ports"]:
        a += ["--ports", v["ports"]]
    if v.get("project"):
        a += ["--project", v["project"]]
    return a


def git_top(folder):
    """The top folder of the git repository FOLDER is in, or None."""
    try:
        r = subprocess.run(["git", "-C", os.path.expanduser(folder), "rev-parse", "--show-toplevel"],
                           capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def home_short(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path and (path == home or path.startswith(home + "/")) else path


HERE = git_top(os.getcwd()) or ""  # the repository "vmagents ui" was started in, if any


