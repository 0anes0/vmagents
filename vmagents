        return {
            "name": val("name").value.strip(),
            "image": val("image").value,
            "memory": val("memory").value,
            "cpus": val("cpus").value,
            "disk": val("disk").value.strip(),
            "agents": [k for k, _ in AGENTS if self.query_one(f"#agent-{k}", Checkbox).value],
            "ports": val("ports").value.replace(" ", ""),
            "idle": val("idle").value,
            "project": os.path.expanduser(val("project").value.strip()),
        }

    def problem(self, v):
        if not v["name"]:
            return T("Give the VM a name.")
        if not NAME_RE.match(v["name"]):
            return T("The name may have letters, digits, . _ and - only.")
        if v["name"] in self.names:
            return T("There is a VM named {n} already.", n=v["name"])
        if not v["disk"].isdigit() or not 5 <= int(v["disk"]) <= 4096:
            return T("Disk: a size in GB, at least 5.")
        avail = self.info.get("host", {}).get("pool_available_gb")
        if avail is not None and int(v["disk"]) > avail:
            return T("Disk: the libvirt pool has {n} GB free (the disk grows as it fills, but not beyond that).",
                     n=avail)
        if not v["agents"]:
            return T("Choose at least one AI assistant.")
        if v["ports"] and not re.match(r"^[0-9]+(,[0-9]+)*$", v["ports"]):
            return T("Ports: numbers separated by commas, e.g. 3000,5173.")
        if v["ports"] and any(not 1 <= int(p) <= 65535 for p in v["ports"].split(",")):
            return T("Ports go from 1 to 65535.")
        if v["project"] and not git_top(v["project"]):
            return T("Project: {p} is not a git repository.", p=home_short(v["project"]))
        return ""

    def refresh_command(self):
        v = self.values()
        v2 = dict(v, name=v["name"] or "NAME", agents=v["agents"] or ["claude"], disk=v["disk"] or "20")
        self.query_one("#command", Static).update(T("[dim]The same from a terminal: vmagents {cmd}[/]",
                                                    cmd=shlex.join(create_args(v2))))

