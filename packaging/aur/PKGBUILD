# Maintainer: EminY <57416756+emincan2000@users.noreply.github.com>
pkgname=vmagents
pkgver=0.24.1
pkgrel=1
pkgdesc="Run AI coding agents (Claude Code, Codex, Gemini CLI, OpenCode, aider) inside a virtual machine"
arch=('any')
url="https://github.com/emincan2000/vmagents"
license=('MIT')
depends=('bash' 'openssh' 'curl' 'util-linux' 'python' 'git'
         'libvirt' 'virt-install' 'qemu-system-x86' 'qemu-img' 'libisoburn' 'dnsmasq')
optdepends=('uv: fetches the terminal UI'"'"'s Python packages'
            'github-cli: pull requests (vmagents take --pr, vmagents fix)'
            'libnotify: desktop notifications'
            'xclip: the shared clipboard on X11'
            'wl-clipboard: the shared clipboard on Wayland'
            'sshfs: vmagents mount')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e4d330903808760647eb83f435f897346d789614d6c9821cee506f94aeb98f66')

check() {
  cd "$pkgname-$pkgver"
  [[ $(bash ./vmagents --version) == "vmagents $pkgver" ]]
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 vmagents "$pkgdir/usr/bin/vmagents"
  ln -s vmagents "$pkgdir/usr/bin/vmclaude"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 README.tr.md "$pkgdir/usr/share/doc/$pkgname/README.tr.md"
}
