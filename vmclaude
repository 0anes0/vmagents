  esac
}

# ------------------------------------------------------------------ profiles

valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
profile_file() { printf '%s/%s.conf' "$HOSTS_DIR" "$1"; }
profile_exists() { valid_name "$1" && [[ -f $(profile_file "$1") ]]; }

profile_names() {
  local f
  [[ -d $HOSTS_DIR ]] || return 0
  for f in "$HOSTS_DIR"/*.conf; do
    [[ -f $f ]] || continue
    f=${f##*/}
    printf '%s\n' "${f%.conf}"
  done
}

# Profiles are KEY=VALUE files. They are parsed, never sourced.
declare -A P=()
read_profile() {
  local name=$1 file line k v n=0
  file=$(profile_file "$name")
  P=()
  [[ -f $file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ $line =~ ^([A-Z_]+)=(.*)$ ]] || die "$file:$n: expected KEY=VALUE"
    k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
    [[ $PROFILE_KEYS == *" $k "* ]] || die "$file:$n: unknown key $k"
    P[$k]=$v
  done <"$file"
}

write_profile() {
  local name=$1 file tmp k
  file=$(profile_file "$name")
  mkdir -p "$HOSTS_DIR"
  tmp=$(mktemp "$HOSTS_DIR/.tmp.XXXXXX")
  {
    printf '# vmclaude profile "%s"\n' "$name"
    for k in $PROFILE_KEYS; do
      [[ -v P[$k] ]] && printf '%s=%s\n' "$k" "${P[$k]}"
    done
  } >"$tmp"
  mv -f "$tmp" "$file"
}

HOST_RE='^[]A-Za-z0-9._:%[-]+$' # names, IPv4, IPv6 (optionally [bracketed], %zone)
check_value() { # KEY VALUE
  local k=$1 v=$2
  [[ $v != *$'\n'* ]] || die "$k must be a single line"
  case $k in
    HOST) [[ $v =~ $HOST_RE && $v != -* ]] || die "invalid host: $v" ;;
    USER) [[ $v =~ ^[A-Za-z0-9._][A-Za-z0-9._-]*$ ]] || die "invalid user: $v" ;;
    PORT) if ! [[ $v =~ ^[0-9]+$ ]] || ((v < 1 || v > 65535)); then die "invalid port: $v"; fi ;;
    DOMAIN) [[ -n $v && $v != -* ]] || die "invalid libvirt domain: $v" ;;
    SESSION) [[ $v =~ ^[A-Za-z0-9_-]*$ ]] || die "invalid tmux session name: $v (letters, digits, _ and - only)" ;;
    OS) [[ $v == linux || $v == windows ]] || die "invalid OS: $v (linux or windows)" ;;
    AUTOSTOP) [[ $v == on || $v == off ]] || die "invalid AUTOSTOP: $v (on or off)" ;;
  esac
}

# Load NAME into the effective connection settings (C_*).
NAME='' C_HOST='' C_USER='' C_PORT='' C_KEY='' C_DOMAIN='' C_URI='' C_DIR='' C_SESSION='' C_OS=''
load() {
  NAME=$1
  valid_name "$NAME" || die "invalid profile name: $NAME"
  profile_exists "$NAME" || die "no VM profile named '$NAME' (see: $PROG list)"
  read_profile "$NAME"
  local k
  for k in HOST USER PORT DOMAIN SESSION OS AUTOSTOP; do
    [[ -v P[$k] && -n ${P[$k]} ]] && check_value "$k" "${P[$k]}"
  done
  C_HOST=${P[HOST]:-}
  C_USER=${P[USER]:-$(id -un)}
  C_PORT=${P[PORT]:-22}
  C_KEY=${P[IDENTITY]:-$DEFAULT_KEY}
  # shellcheck disable=SC2088 # a literal "~/" from the profile file
  [[ $C_KEY == "~/"* ]] && C_KEY=$HOME/${C_KEY#"~/"}
  C_DOMAIN=${P[DOMAIN]:-}
  C_URI=${P[LIBVIRT_URI]:-qemu:///system}
  C_DIR=${P[DIR]:-}
  C_SESSION=${P[SESSION]-claude}
  C_OS=${P[OS]:-}
  [[ -n $C_HOST || -n $C_DOMAIN ]] || die "profile '$NAME' has neither HOST nor DOMAIN"
}

default_name() {
  local d names count
  if [[ -f $CONF_DIR/default ]]; then
    d=$(<"$CONF_DIR/default")
    if profile_exists "$d"; then printf '%s\n' "$d"; return 0; fi
  fi
  names=$(profile_names)
  count=$(grep -c . <<<"$names" || true)
  if ((count == 1)); then printf '%s\n' "$names"; return 0; fi
  return 1
}

# ------------------------------------------------------------------ libvirt

vsh() { virsh -c "$C_URI" "$@"; }

ensure_running() {
  local out state
  command -v virsh >/dev/null || die "virsh not found, but profile '$NAME' uses libvirt domain '$C_DOMAIN'"
  out=$(vsh domstate "$C_DOMAIN" 2>&1) || die "libvirt: ${out:-cannot read state of $C_DOMAIN}"
  state=${out%%$'\n'*}
  case $state in
    running) ;;
    paused)
      info "Resuming VM $C_DOMAIN..."
      out=$(vsh resume "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
    pmsuspended)
      info "Waking VM $C_DOMAIN..."
      out=$(vsh dompmwakeup "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
    "in shutdown")
      info "VM $C_DOMAIN is shutting down; waiting to start it again..."
      wait_off "$STOP_TIMEOUT" || die "VM $C_DOMAIN is still shutting down after ${STOP_TIMEOUT}s"
      info "Starting VM $C_DOMAIN..."
      out=$(vsh start "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
    *)
      info "Starting VM $C_DOMAIN..."
      out=$(vsh start "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
  esac
}

domstate() { local s; s=$(vsh domstate "$C_DOMAIN" 2>/dev/null) || return 1; printf '%s' "${s%%$'\n'*}"; }

# True once the VM is off (or gone); false after $1 seconds.
wait_off() {
  local deadline=$((SECONDS + $1)) s
  while s=$(domstate) && [[ $s != "shut off" && $s != crashed ]]; do
    ((SECONDS < deadline)) || return 1
    sleep 1
  done
  return 0
}

# Shuts the VM down like its power button would (ACPI), and waits for it.
stop_vm() { # 0|1 (1: pull the plug)
  command -v virsh >/dev/null || die "virsh not found"
  local state out
  state=$(domstate) || die "libvirt: cannot read the state of $C_DOMAIN"
  case $state in
    "shut off" | crashed) info "VM $C_DOMAIN is already off."; return 0 ;;
  esac
  if (($1)); then
    out=$(vsh destroy "$C_DOMAIN" 2>&1) || die "libvirt: $out"
    info "VM $C_DOMAIN is off (forced)."
    return 0
  fi
  case $state in
    paused) out=$(vsh resume "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
    pmsuspended) out=$(vsh dompmwakeup "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
  esac
  if [[ $state != "in shutdown" ]]; then
    out=$(vsh shutdown "$C_DOMAIN" 2>&1) || die "libvirt: $out"
  fi
  info "Shutting down VM $C_DOMAIN... (Ctrl-C stops the waiting, not the shutdown)"
  if wait_off "$STOP_TIMEOUT"; then
    info "VM $C_DOMAIN is off."
  else
    warn "VM $C_DOMAIN is still running after ${STOP_TIMEOUT}s. Pull the plug: $PROG stop $NAME --force"
    return 1
  fi
}

# Sets FOUND_IP to the first IPv4 address of the domain (not on lo).
FOUND_IP=
find_ip() {
  local src
  FOUND_IP=
  for src in lease agent arp; do
    FOUND_IP=$(vsh domifaddr "$C_DOMAIN" --source "$src" 2>/dev/null |
      awk '$1 != "-" { iface = $1 } $3 == "ipv4" && iface != "lo" { sub(/\/.*/, "", $4); print $4; exit }') || true
    [[ -n $FOUND_IP ]] && return 0
  done
  return 1
}

# Fails early when the VM stops while we wait for it.
check_still_running() {
  local state
  state=$(vsh domstate "$C_DOMAIN" 2>/dev/null) || return 0
  state=${state%%$'\n'*}
  [[ $state == running || $state == paused ]] ||
    die "VM $C_DOMAIN stopped while booting (state: $state); see: virsh -c $C_URI console $C_DOMAIN"
}

wait_for_ip() {
  local deadline=$((SECONDS + BOOT_TIMEOUT)) noted=0
  until find_ip; do
    check_still_running
    ((SECONDS < deadline)) || die "VM $C_DOMAIN has no IPv4 address after ${BOOT_TIMEOUT}s (is its network up? set --host to skip detection)"
    ((noted)) || { info "Waiting for $C_DOMAIN to get an IP address..."; noted=1; }
    sleep 2
  done
}

# True once an SSH server answers with its banner. A bare TCP connect is not
# enough: NAT port forwards (passt, slirp, VirtualBox) accept connections
# before the VM's sshd is up.
# Sets BANNER, e.g. "SSH-2.0-OpenSSH_for_Windows_9.5".
BANNER=
# shellcheck disable=SC2016
ssh_ready() {
  local b
  b=$(timeout 5 bash -c 'exec 3<>"/dev/tcp/$1/$2" && IFS= read -r -t 4 line <&3 && printf "%s" "$line"' \
    _ "$1" "$2" 2>/dev/null) || return 1
  [[ $b == SSH-* ]] || return 1
  BANNER=${b%$'\r'}
}

# Sets C_OS from the profile, or once from the SSH banner (then saved).
detect_os() {
  [[ -n $C_OS ]] && return 0
  [[ -n $BANNER ]] || ssh_ready "$TARGET" "$C_PORT" || { C_OS=linux; return 0; }
  if [[ $BANNER == *[Ww]indows* ]]; then C_OS=windows; else C_OS=linux; fi
  P[OS]=$C_OS
  write_profile "$NAME"
  [[ $C_OS == windows ]] && info "Detected a Windows VM."
  return 0
}

wait_for_port() {
  local host=$1 port=$2 deadline=$((SECONDS + BOOT_TIMEOUT)) noted=0
  until ssh_ready "$host" "$port"; do
    [[ -n $C_DOMAIN ]] && check_still_running
    ((SECONDS < deadline)) || die "no SSH server answers on $host:$port after ${BOOT_TIMEOUT}s (is sshd installed and running on the VM?)"
    ((noted)) || { info "Waiting for SSH on $host:$port..."; noted=1; }
    sleep 2
  done
}

# Sets TARGET: starts the VM and waits for it when it is a libvirt domain.
TARGET=
resolve_target() {
  if [[ -n $C_DOMAIN ]]; then
    ensure_running
    if [[ -n $C_HOST ]]; then
      TARGET=$C_HOST
    else
      wait_for_ip
      TARGET=$FOUND_IP
    fi
    wait_for_port "$TARGET" "$C_PORT"
  else
    TARGET=$C_HOST
  fi
  detect_os
}

