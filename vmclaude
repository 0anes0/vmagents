#!/usr/bin/env bash
# vmclaude — open Claude Code inside a virtual machine over SSH, in one step.
# https://github.com/emincan2000/vmclaude
set -euo pipefail

VERSION=0.3.0
PROG=${0##*/}
CONF_DIR=${VMCLAUDE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/vmclaude}
HOSTS_DIR=$CONF_DIR/hosts
KNOWN_HOSTS=$CONF_DIR/known_hosts
DEFAULT_KEY=$HOME/.ssh/vmclaude_ed25519
BOOT_TIMEOUT=${VMCLAUDE_BOOT_TIMEOUT:-180}
APPS_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/applications
PROFILE_KEYS=" HOST USER PORT IDENTITY DOMAIN LIBVIRT_URI DIR SESSION OS CREATED "
HOLD=0

say()  { printf '%s\n' "$*"; }
info() { printf '%s\n' "$*" >&2; }
warn() { printf '%s: warning: %s\n' "$PROG" "$*" >&2; }
die()  {
  printf '%s: %s\n' "$PROG" "$*" >&2
  hold_prompt
  exit 1
}
usage_error() { printf '%s: %s\n' "$PROG" "$*" >&2; printf "Try '%s help'.\n" "$PROG" >&2; exit 2; }
# In a desktop launcher the terminal closes as soon as we exit; keep it open on errors.
hold_prompt() {
  if [[ $HOLD = 1 && -t 0 ]]; then
    read -r -p "Press Enter to close." _ || true
  fi
}

usage() {
  cat <<EOF
vmclaude $VERSION — open Claude Code inside a virtual machine over SSH.

Usage:
  $PROG                         connect to the default VM (asks to add one if none)
  $PROG NAME [CLAUDE_ARGS...]   connect to VM NAME
  $PROG COMMAND [ARGS...]

Commands:
  create NAME [options]    make a new Linux VM (libvirt) and set it up; no password needed
      --image NAME           debian13 (default), debian12 or ubuntu24.04
      --memory MB            default 4096        --cpus N    default 2
      --disk GB              default 20          --user U    default: $(id -un)
      --uri URI              libvirt URI (default: qemu:///system)
      --no-setup             only create the VM
  delete NAME [--yes]      delete a VM made with create, with its disk
  prune                    remove downloaded images no VM uses any more
  add NAME [options]       add an existing VM, or change fields of a profile
      --host HOST            hostname or IP (optional with --domain: detected)
      --user USER            login user on the VM (default: $(id -un))
      --port PORT            SSH port (default: 22)
      --key FILE             private key (default: ~/.ssh/vmclaude_ed25519)
      --domain NAME          libvirt domain: start it on connect, find its IP
      --uri URI              libvirt URI (default: qemu:///system)
      --dir DIR              working directory on the VM (default: home)
      --session NAME         tmux session name (default: claude)
      --no-tmux              run Claude without tmux
      --os linux|windows     the VM's system (default: detected on first use)
  setup NAME [options]     install the SSH key, tmux and Claude Code on the VM
                           (on Windows: Git for Windows instead of tmux)
      --no-install           only install the SSH key
      --no-autostart         do not start Claude when you log in over SSH
  connect [--hold] [--no-tmux] [NAME] [-- CLAUDE_ARGS...]
                           open Claude Code on the VM (the default command)
  shell NAME [CMD...]      plain shell (or a command) on the VM, no Claude
  autostart NAME on|off    start Claude Code on every interactive SSH login
  doctor NAME              check every step of the connection
  list                     list VM profiles
  default NAME             make NAME the default VM
  desktop NAME             add an app-menu launcher that opens Claude on NAME
  edit NAME                open the profile in \$EDITOR
  forget NAME              forget the VM's SSH host key (after reinstalling it)
  rm NAME                  delete a profile and its launcher
  help, version

Claude keeps running in tmux when the connection drops; connecting again
reattaches. Detach on purpose with Ctrl-b d. Windows VMs have no tmux: there
Claude ends with the connection.
EOF
}

# ------------------------------------------------------------------ profiles

valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
profile_file() { printf '%s/%s.conf' "$HOSTS_DIR" "$1"; }
profile_exists() { valid_name "$1" && [[ -f $(profile_file "$1") ]]; }

profile_names() {
  local f
  [[ -d $HOSTS_DIR ]] || return 0
  for f in "$HOSTS_DIR"/*.conf; do
    [[ -f $f ]] || continue
    f=${f##*/}
    printf '%s\n' "${f%.conf}"
  done
}

# Profiles are KEY=VALUE files. They are parsed, never sourced.
declare -A P=()
read_profile() {
  local name=$1 file line k v n=0
  file=$(profile_file "$name")
  P=()
  [[ -f $file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ $line =~ ^([A-Z_]+)=(.*)$ ]] || die "$file:$n: expected KEY=VALUE"
    k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
    [[ $PROFILE_KEYS == *" $k "* ]] || die "$file:$n: unknown key $k"
    P[$k]=$v
  done <"$file"
}

write_profile() {
  local name=$1 file tmp k
  file=$(profile_file "$name")
  mkdir -p "$HOSTS_DIR"
  tmp=$(mktemp "$HOSTS_DIR/.tmp.XXXXXX")
  {
    printf '# vmclaude profile "%s"\n' "$name"
    for k in $PROFILE_KEYS; do
      [[ -v P[$k] ]] && printf '%s=%s\n' "$k" "${P[$k]}"
    done
  } >"$tmp"
  mv -f "$tmp" "$file"
}

HOST_RE='^[]A-Za-z0-9._:%[-]+$' # names, IPv4, IPv6 (optionally [bracketed], %zone)
check_value() { # KEY VALUE
  local k=$1 v=$2
  [[ $v != *$'\n'* ]] || die "$k must be a single line"
  case $k in
    HOST) [[ $v =~ $HOST_RE && $v != -* ]] || die "invalid host: $v" ;;
    USER) [[ $v =~ ^[A-Za-z0-9._][A-Za-z0-9._-]*$ ]] || die "invalid user: $v" ;;
    PORT) if ! [[ $v =~ ^[0-9]+$ ]] || ((v < 1 || v > 65535)); then die "invalid port: $v"; fi ;;
    DOMAIN) [[ -n $v && $v != -* ]] || die "invalid libvirt domain: $v" ;;
    SESSION) [[ $v =~ ^[A-Za-z0-9_-]*$ ]] || die "invalid tmux session name: $v (letters, digits, _ and - only)" ;;
    OS) [[ $v == linux || $v == windows ]] || die "invalid OS: $v (linux or windows)" ;;
  esac
}

# Load NAME into the effective connection settings (C_*).
NAME='' C_HOST='' C_USER='' C_PORT='' C_KEY='' C_DOMAIN='' C_URI='' C_DIR='' C_SESSION='' C_OS=''
load() {
  NAME=$1
  valid_name "$NAME" || die "invalid profile name: $NAME"
  profile_exists "$NAME" || die "no VM profile named '$NAME' (see: $PROG list)"
  read_profile "$NAME"
  local k
  for k in HOST USER PORT DOMAIN SESSION OS; do
    [[ -v P[$k] && -n ${P[$k]} ]] && check_value "$k" "${P[$k]}"
  done
  C_HOST=${P[HOST]:-}
  C_USER=${P[USER]:-$(id -un)}
  C_PORT=${P[PORT]:-22}
  C_KEY=${P[IDENTITY]:-$DEFAULT_KEY}
  # shellcheck disable=SC2088 # a literal "~/" from the profile file
  [[ $C_KEY == "~/"* ]] && C_KEY=$HOME/${C_KEY#"~/"}
  C_DOMAIN=${P[DOMAIN]:-}
  C_URI=${P[LIBVIRT_URI]:-qemu:///system}
  C_DIR=${P[DIR]:-}
  C_SESSION=${P[SESSION]-claude}
  C_OS=${P[OS]:-}
  [[ -n $C_HOST || -n $C_DOMAIN ]] || die "profile '$NAME' has neither HOST nor DOMAIN"
}

default_name() {
  local d names count
  if [[ -f $CONF_DIR/default ]]; then
    d=$(<"$CONF_DIR/default")
    if profile_exists "$d"; then printf '%s\n' "$d"; return 0; fi
  fi
  names=$(profile_names)
  count=$(grep -c . <<<"$names" || true)
  if ((count == 1)); then printf '%s\n' "$names"; return 0; fi
  return 1
}

# ------------------------------------------------------------------ libvirt

vsh() { virsh -c "$C_URI" "$@"; }

ensure_running() {
  local out state
  command -v virsh >/dev/null || die "virsh not found, but profile '$NAME' uses libvirt domain '$C_DOMAIN'"
  out=$(vsh domstate "$C_DOMAIN" 2>&1) || die "libvirt: ${out:-cannot read state of $C_DOMAIN}"
  state=${out%%$'\n'*}
  case $state in
    running) ;;
    paused)
      info "Resuming VM $C_DOMAIN..."
      out=$(vsh resume "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
    pmsuspended)
      info "Waking VM $C_DOMAIN..."
      out=$(vsh dompmwakeup "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
    "in shutdown")
      die "VM $C_DOMAIN is shutting down; try again in a moment" ;;
    *)
      info "Starting VM $C_DOMAIN..."
      out=$(vsh start "$C_DOMAIN" 2>&1) || die "libvirt: $out" ;;
  esac
}

# Sets FOUND_IP to the first IPv4 address of the domain (not on lo).
FOUND_IP=
find_ip() {
  local src
  FOUND_IP=
  for src in lease agent arp; do
    FOUND_IP=$(vsh domifaddr "$C_DOMAIN" --source "$src" 2>/dev/null |
      awk '$1 != "-" { iface = $1 } $3 == "ipv4" && iface != "lo" { sub(/\/.*/, "", $4); print $4; exit }') || true
    [[ -n $FOUND_IP ]] && return 0
  done
  return 1
}

# Fails early when the VM stops while we wait for it.
check_still_running() {
  local state
  state=$(vsh domstate "$C_DOMAIN" 2>/dev/null) || return 0
  state=${state%%$'\n'*}
  [[ $state == running || $state == paused ]] ||
    die "VM $C_DOMAIN stopped while booting (state: $state); see: virsh -c $C_URI console $C_DOMAIN"
}

wait_for_ip() {
  local deadline=$((SECONDS + BOOT_TIMEOUT)) noted=0
  until find_ip; do
    check_still_running
    ((SECONDS < deadline)) || die "VM $C_DOMAIN has no IPv4 address after ${BOOT_TIMEOUT}s (is its network up? set --host to skip detection)"
    ((noted)) || { info "Waiting for $C_DOMAIN to get an IP address..."; noted=1; }
    sleep 2
  done
}

# True once an SSH server answers with its banner. A bare TCP connect is not
# enough: NAT port forwards (passt, slirp, VirtualBox) accept connections
# before the VM's sshd is up.
# Sets BANNER, e.g. "SSH-2.0-OpenSSH_for_Windows_9.5".
BANNER=
# shellcheck disable=SC2016
ssh_ready() {
  local b
  b=$(timeout 5 bash -c 'exec 3<>"/dev/tcp/$1/$2" && IFS= read -r -t 4 line <&3 && printf "%s" "$line"' \
    _ "$1" "$2" 2>/dev/null) || return 1
  [[ $b == SSH-* ]] || return 1
  BANNER=${b%$'\r'}
}

# Sets C_OS from the profile, or once from the SSH banner (then saved).
detect_os() {
  [[ -n $C_OS ]] && return 0
  [[ -n $BANNER ]] || ssh_ready "$TARGET" "$C_PORT" || { C_OS=linux; return 0; }
  if [[ $BANNER == *[Ww]indows* ]]; then C_OS=windows; else C_OS=linux; fi
  P[OS]=$C_OS
  write_profile "$NAME"
  [[ $C_OS == windows ]] && info "Detected a Windows VM."
  return 0
}

wait_for_port() {
  local host=$1 port=$2 deadline=$((SECONDS + BOOT_TIMEOUT)) noted=0
  until ssh_ready "$host" "$port"; do
    [[ -n $C_DOMAIN ]] && check_still_running
    ((SECONDS < deadline)) || die "no SSH server answers on $host:$port after ${BOOT_TIMEOUT}s (is sshd installed and running on the VM?)"
    ((noted)) || { info "Waiting for SSH on $host:$port..."; noted=1; }
    sleep 2
  done
}

# Sets TARGET: starts the VM and waits for it when it is a libvirt domain.
TARGET=
resolve_target() {
  if [[ -n $C_DOMAIN ]]; then
    ensure_running
    if [[ -n $C_HOST ]]; then
      TARGET=$C_HOST
    else
      wait_for_ip
      TARGET=$FOUND_IP
    fi
    wait_for_port "$TARGET" "$C_PORT"
  else
    TARGET=$C_HOST
  fi
  detect_os
}

# ------------------------------------------------------------------ ssh

# The host key is stored under an alias, so a VM whose DHCP address changes
# keeps its identity, and in vmclaude's own known_hosts file.
SSH_OPTS=()
build_ssh_opts() {
  mkdir -p "$CONF_DIR"
  SSH_OPTS=(-l "$C_USER" -p "$C_PORT"
    -o "HostKeyAlias=vmclaude-$NAME"
    -o "UserKnownHostsFile=$KNOWN_HOSTS"
    -o StrictHostKeyChecking=accept-new
    -o ConnectTimeout=15
    -o ServerAliveInterval=30 -o ServerAliveCountMax=4)
  if [[ -f $C_KEY ]]; then
    SSH_OPTS+=(-i "$C_KEY" -o IdentitiesOnly=yes)
  fi
}

# -t (allocate a terminal on the VM) when we have one, else -T. Not called
# as $(...): stdout would be a pipe there.
TTY_FLAG=-T
[[ -t 0 && -t 1 ]] && TTY_FLAG=-t

# Quote for a POSIX shell (also safe in bash, zsh and fish).
sq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# remote_cmd SCRIPT ARGS... -> one command line that runs SCRIPT with ARGS
# under sh on the VM, whatever the user's login shell is.
remote_cmd() {
  local out a
  out="sh -c $(sq "$1") vmclaude"
  shift
  for a in "$@"; do out+=" $(sq "$a")"; done
  printf '%s' "$out"
}

# --- scripts that run on the VM (POSIX sh) ---

# shellcheck disable=SC2016
REMOTE_ENV='PATH="$HOME/.local/bin:$HOME/.claude/local:$HOME/bin:$PATH"; export PATH
cd_dir() {
  case $1 in
    "") cd || return 1; return 0 ;;
    "~") set -- "$HOME" ;;
    "~/"*) set -- "$HOME/${1#"~/"}" ;;
  esac
  [ -d "$1" ] || { mkdir -p "$1" && echo "vmclaude: created $1 on the VM" >&2; } || return 1
  cd "$1"
}
'

# $1 dir, $2 tmux session ("" = no tmux), $3 profile name, rest: claude args
# shellcheck disable=SC2016
CONNECT_SH=$REMOTE_ENV'd=$1; s=$2; n=$3; shift 3
cd_dir "$d" || { echo "vmclaude: cannot use directory $d on the VM" >&2; exit 1; }
c=$(command -v claude) || { echo "vmclaude: Claude Code is not installed on the VM. Run: vmclaude setup $n" >&2; exit 127; }
if [ -n "${TERM-}" ] && command -v tput >/dev/null 2>&1 && ! tput -T "$TERM" longname >/dev/null 2>&1; then
  TERM=xterm-256color; export TERM
fi
if [ -n "$s" ] && command -v tmux >/dev/null 2>&1; then
  exec tmux new-session -A -s "$s" -c "$PWD" "$c" "$@"
fi
exec "$c" "$@"
'

# Reads one public key on stdin and adds it to authorized_keys once.
# shellcheck disable=SC2016
ADDKEY_SH='umask 077
k=$(cat)
case $k in ssh-*|ecdsa-*|sk-*) ;; *) echo "vmclaude: not a public key" >&2; exit 1 ;; esac
mkdir -p "$HOME/.ssh" || exit 1
f=$HOME/.ssh/authorized_keys
touch "$f" || exit 1
if [ -s "$f" ] && [ "$(tail -c 1 "$f" | wc -l)" -eq 0 ]; then echo >>"$f"; fi
grep -qxF "$k" "$f" || printf "%s\n" "$k" >>"$f"
chmod 600 "$f"; chmod 700 "$HOME/.ssh"
'

# shellcheck disable=SC2016
INSTALL_SH=$REMOTE_ENV'if command -v cloud-init >/dev/null 2>&1; then
  case $(cloud-init status 2>/dev/null) in
    *running* | *"not started"*) echo "Waiting for cloud-init to finish..."; cloud-init status --wait >/dev/null 2>&1 ;;
  esac
fi
need=
command -v tmux >/dev/null 2>&1 || need="$need tmux"
command -v claude >/dev/null 2>&1 || command -v curl >/dev/null 2>&1 || need="$need curl"
if [ -n "$need" ]; then
  echo "Installing:$need"
  if [ "$(id -u)" = 0 ]; then su_=
  elif command -v sudo >/dev/null 2>&1; then su_=sudo
  else su_=none
  fi
  if [ "$su_" = none ]; then
    echo "vmclaude: cannot install$need without root or sudo; install it yourself" >&2
  elif command -v apt-get >/dev/null 2>&1; then
    $su_ apt-get update -qq && $su_ env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq -o Dpkg::Use-Pty=0 $need
  elif command -v dnf >/dev/null 2>&1; then $su_ dnf install -y $need
  elif command -v yum >/dev/null 2>&1; then $su_ yum install -y $need
  elif command -v pacman >/dev/null 2>&1; then $su_ pacman -S --needed --noconfirm $need
  elif command -v zypper >/dev/null 2>&1; then $su_ zypper --non-interactive install $need
  elif command -v apk >/dev/null 2>&1; then $su_ apk add $need
  else echo "vmclaude: no known package manager; install$need yourself" >&2
  fi || echo "vmclaude: installing$need failed" >&2
fi
if command -v claude >/dev/null 2>&1; then
  echo "Claude Code is already installed: $(claude --version 2>/dev/null || echo unknown version)"
else
  command -v curl >/dev/null 2>&1 || { echo "vmclaude: curl is missing; cannot install Claude Code" >&2; exit 1; }
  echo "Installing Claude Code..."
  curl -fsSL https://claude.ai/install.sh | bash
  command -v claude >/dev/null 2>&1 || { echo "vmclaude: Claude Code installation failed" >&2; exit 1; }
  echo "Installed Claude Code: $(claude --version 2>/dev/null || echo unknown version)"
fi
command -v tmux >/dev/null 2>&1 || echo "vmclaude: tmux is not available; Claude will stop when the connection drops" >&2
exit 0
'

# $1 on|off; with "on" the hook body comes on stdin.
# shellcheck disable=SC2016
AUTOSTART_SH='umask 022
d=$HOME/.config/vmclaude
hook=$d/autostart.sh
begin="# >>> vmclaude autostart >>>"
end="# <<< vmclaude autostart <<<"
strip() {
  [ -f "$1" ] || return 0
  awk -v b="$begin" -v e="$end" "\$0 == b { skip = 1; next } \$0 == e { skip = 0; next } !skip" "$1" >"$1.vmclaude.tmp" &&
    cat "$1.vmclaude.tmp" >"$1" && rm -f "$1.vmclaude.tmp"
}
rcs="$HOME/.bashrc"
case ${SHELL-} in */zsh) rcs="$rcs $HOME/.zshrc" ;; esac
[ -f "$HOME/.zshrc" ] && case $rcs in *zshrc*) ;; *) rcs="$rcs $HOME/.zshrc" ;; esac
for rc in $rcs; do strip "$rc" || exit 1; done
if [ "$1" = off ]; then
  rm -f "$hook"
  echo "Autostart is off."
  exit 0
fi
mkdir -p "$d" || exit 1
cat >"$hook" || exit 1
for rc in $rcs; do
  [ -f "$rc" ] && [ -s "$rc" ] && [ "$(tail -c 1 "$rc" | wc -l)" -eq 0 ] && echo >>"$rc"
  printf "%s\n%s\n%s\n" "$begin" "[ -r \"\$HOME/.config/vmclaude/autostart.sh\" ] && . \"\$HOME/.config/vmclaude/autostart.sh\"" "$end" >>"$rc" || exit 1
done
echo "Autostart is on: SSH logins open Claude Code (quit Claude to get a shell)."
'

# The hook sourced from ~/.bashrc / ~/.zshrc on the VM.
autostart_hook() { # DIR SESSION
  cat <<EOF
# Installed by vmclaude: open Claude Code on interactive SSH logins.
# Quit Claude (or detach tmux with Ctrl-b d) to get a normal shell.
# Skip it once:  ssh -o SetEnv=LC_VMCLAUDE=off ...   Turn it off:  vmclaude autostart NAME off
case \$- in *i*) ;; *) return 0 2>/dev/null || exit 0 ;; esac
if [ -n "\${SSH_CONNECTION-}" ] && [ -z "\${TMUX-}" ] && [ -z "\${VMCLAUDE_NO_AUTOSTART-}" ] && [ "\${LC_VMCLAUDE-}" != off ] && [ -t 0 ] && [ -t 1 ]; then
  VMCLAUDE_NO_AUTOSTART=1; export VMCLAUDE_NO_AUTOSTART
  case ":\$PATH:" in *":\$HOME/.local/bin:"*) ;; *) PATH="\$HOME/.local/bin:\$PATH"; export PATH ;; esac
  vmclaude_dir=$(sq "$1")
  case \$vmclaude_dir in "") vmclaude_dir=\$HOME ;; "~") vmclaude_dir=\$HOME ;; "~/"*) vmclaude_dir=\$HOME/\${vmclaude_dir#"~/"} ;; esac
  if command -v claude >/dev/null 2>&1; then
    if [ -n $(sq "$2") ] && command -v tmux >/dev/null 2>&1; then
      tmux new-session -A -s $(sq "$2") -c "\$vmclaude_dir" "\$(command -v claude)"
    else
      (cd "\$vmclaude_dir" 2>/dev/null; claude)
    fi
  fi
  unset vmclaude_dir
fi
EOF
}

# ------------------------------------------------------------------ Windows VMs
# Windows OpenSSH runs commands with cmd.exe or PowerShell, depending on its
# DefaultShell. Both can start `powershell -EncodedCommand BASE64`, which needs
# no quoting at all; values go into the script as PowerShell literals.

# Quote for PowerShell as a single-quoted literal. PowerShell also takes the
# curly quotes U+2018..U+201B as single quotes, so those are doubled too.
psq() {
  local s=$1 q
  for q in "'" $'\xe2\x80\x98' $'\xe2\x80\x99' $'\xe2\x80\x9a' $'\xe2\x80\x9b'; do
    s=${s//"$q"/"$q$q"}
  done
  printf "'%s'" "$s"
}

ps_array() { # ARGS... -> @('a', 'b')
  local out="@(" a sep=""
  for a in "$@"; do out+="$sep$(psq "$a")"; sep=", "; done
  printf '%s)' "$out"
}

# win_cmd [-i] [-noexit] SCRIPT -> a command line for the VM's default shell
win_cmd() {
  local flags="-NoLogo -NoProfile -NonInteractive" script enc
  while [[ $1 == -* ]]; do
    case $1 in
      -i) flags="-NoLogo -NoProfile" ;;
      -noexit) flags="-NoLogo -NoProfile -NoExit" ;;
    esac
    shift
  done
  script="\$ProgressPreference = 'SilentlyContinue'"$'\n'"try { [Console]::OutputEncoding = [Text.Encoding]::UTF8 } catch { }"$'\n'$1
  enc=$(printf '%s' "$script" | iconv -f UTF-8 -t UTF-16LE | base64 -w 0) || die "iconv/base64 failed"
  # cmd.exe accepts at most 8191 characters per command line.
  ((${#enc} < 8000)) || die "internal error: Windows command too long (${#enc})"
  printf 'powershell %s -ExecutionPolicy Bypass -EncodedCommand %s' "$flags" "$enc"
}

# Runs a longer script: it travels gzipped inside the command line and runs
# from a temporary .ps1 file, so `exit N` works. (Not on stdin: with
# PowerShell as OpenSSH's DefaultShell, stdin over 4 KB hangs. And with that
# DefaultShell every non-zero exit code reaches us as 1.)
win_run() { # SCRIPT
  local gz
  gz=$(printf '%s' "$1" | gzip -9n | base64 -w 0) || die "gzip/base64 failed"
  run_ssh -T -- "$TARGET" "$(win_cmd "\$z = New-Object IO.Compression.GZipStream (New-Object IO.MemoryStream (,[Convert]::FromBase64String('$gz'))), ([IO.Compression.CompressionMode]::Decompress)
\$f = Join-Path \$env:TEMP (\"vmclaude-\" + [guid]::NewGuid() + \".ps1\")
[IO.File]::WriteAllText(\$f, (New-Object IO.StreamReader \$z, ([Text.Encoding]::UTF8)).ReadToEnd(), (New-Object Text.UTF8Encoding \$true))
try { & \$f; \$rc = \$LASTEXITCODE } finally { Remove-Item -LiteralPath \$f -ErrorAction SilentlyContinue }
exit \$rc")" </dev/null
}

# shellcheck disable=SC2016
WIN_ENV_PS='$env:Path = "$env:USERPROFILE\.local\bin;$env:Path"
function Err($m) { [Console]::Error.WriteLine("vmclaude: $m") }
function Resolve-Dir($d) {
  if ($d -eq "" -or $d -eq "~") { return $env:USERPROFILE }
  if ($d -match "^~[\\/]") { return Join-Path $env:USERPROFILE $d.Substring(2) }
  return $d
}
'

# Starts Claude and waits for it. Claude Code on Windows can hang after you
# quit it under OpenSSH's ConPTY: it puts the console back into line mode but
# never exits. Raw (VT) input first, then line mode for 2 s, means it is done.
# shellcheck disable=SC2016
WIN_INVOKE_PS='function Invoke-Claude($exe, $line, $dir) {
  if (-not ("VmClaude.Con" -as [type])) {
    Add-Type -Namespace VmClaude -Name Con -MemberDefinition ("[DllImport(`"kernel32.dll`")] public static extern IntPtr GetStdHandle(int n);" +
      "[DllImport(`"kernel32.dll`")] public static extern bool GetConsoleMode(IntPtr h, out uint m);")
  }
  $si = New-Object System.Diagnostics.ProcessStartInfo $exe, $line
  $si.UseShellExecute = $false
  $si.WorkingDirectory = $dir
  $p = [System.Diagnostics.Process]::Start($si)
  $h = [VmClaude.Con]::GetStdHandle(-10)
  $raw = $false
  $since = $null
  while (-not $p.WaitForExit(250)) {
    $m = [uint32]0
    if (-not [VmClaude.Con]::GetConsoleMode($h, [ref]$m)) { continue }
    if ($m -band 0x200) { $raw = $true; $since = $null }
    elseif ($raw -and ($m -band 2)) {
      if (-not $since) { $since = Get-Date }
      elseif (((Get-Date) - $since).TotalSeconds -ge 2) { $p.Kill(); $p.WaitForExit(); return 0 }
    }
  }
  $p.ExitCode
}
'

# shellcheck disable=SC2016
win_connect_ps() { # DIR NAME CLAUDE_ARGS...
  local dir=$1 name=$2
  shift 2
  printf '%s' "$WIN_ENV_PS" "$WIN_INVOKE_PS"
  cat <<EOF
\$d = Resolve-Dir $(psq "$dir")
if (-not (Test-Path -LiteralPath \$d)) { New-Item -ItemType Directory -Force -Path \$d | Out-Null; Err "created \$d on the VM" }
Set-Location -LiteralPath \$d
\$c = Get-Command claude -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
if (-not \$c) { Err "Claude Code is not installed on the VM. Run: vmclaude setup $name"; exit 127 }
# Build the command line ourselves: Windows PowerShell 5.1 mangles quotes in
# arguments of native programs.
\$line = (@(foreach (\$a in $(ps_array "$@")) {
  if (\$a -ne "" -and \$a -notmatch '[\s"]') { \$a }
  else { '"' + [regex]::Replace(\$a, '(\\\\*)("|\$)', { param(\$m) \$m.Groups[1].Value * 2 + \$(if (\$m.Groups[2].Value) { '\\"' } else { "" }) }) + '"' }
})) -join " "
exit (Invoke-Claude \$c.Source \$line \$d)
EOF
}

# Adds the key for the user, and for administrators where Windows OpenSSH
# looks for it by default (administrators_authorized_keys, owned by
# Administrators and SYSTEM only; SIDs work on every Windows language).
# shellcheck disable=SC2016
win_addkey_ps() { # PUBKEY
  cat <<EOF
\$k = $(psq "$1")
function Add-Key(\$f) {
  \$dir = Split-Path -Parent \$f
  if (-not (Test-Path -LiteralPath \$dir)) { New-Item -ItemType Directory -Force -Path \$dir | Out-Null }
  \$lines = @()
  if (Test-Path -LiteralPath \$f) { \$lines = @(Get-Content -LiteralPath \$f | Where-Object { \$_ -ne "" }) }
  if (\$lines -notcontains \$k) { Set-Content -LiteralPath \$f -Value (\$lines + \$k) -Encoding Ascii }
}
Add-Key "\$env:USERPROFILE\.ssh\authorized_keys"
\$id = [Security.Principal.WindowsIdentity]::GetCurrent()
if ((New-Object Security.Principal.WindowsPrincipal \$id).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
  \$f = "\$env:ProgramData\ssh\administrators_authorized_keys"
  Add-Key \$f
  icacls.exe \$f /inheritance:r /grant "*S-1-5-32-544:F" /grant "*S-1-5-18:F" | Out-Null
}
EOF
}

# shellcheck disable=SC2016
WIN_INSTALL_PS=$WIN_ENV_PS'[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
function Find-Bash {
  foreach ($p in @("$env:ProgramFiles\Git\bin\bash.exe", "${env:ProgramFiles(x86)}\Git\bin\bash.exe", "$env:LOCALAPPDATA\Programs\Git\bin\bash.exe")) {
    if ($p -and (Test-Path -LiteralPath $p)) { return $p }
  }
}
$bash = Find-Bash
if ($bash) { "Git Bash is already installed: $bash" } else {
  "Installing Git for Windows (Claude Code uses its Bash)..."
  if (Get-Command winget -ErrorAction SilentlyContinue) {
    winget install --id Git.Git --exact --silent --source winget --accept-source-agreements --accept-package-agreements | Out-Null
  }
  $bash = Find-Bash
  if (-not $bash) {
    try {
      $rel = Invoke-RestMethod -UseBasicParsing https://api.github.com/repos/git-for-windows/git/releases/latest
      $asset = $rel.assets | Where-Object { $_.name -match "^Git-[0-9.]+-64-bit\.exe$" } | Select-Object -First 1
      $exe = Join-Path $env:TEMP $asset.name
      Invoke-WebRequest -UseBasicParsing $asset.browser_download_url -OutFile $exe
      Start-Process $exe -ArgumentList "/VERYSILENT", "/NORESTART", "/NOCANCEL", "/SP-", "/SUPPRESSMSGBOXES" -Wait
      Remove-Item -LiteralPath $exe -ErrorAction SilentlyContinue
    } catch { Err "downloading Git for Windows failed: $_" }
    $bash = Find-Bash
  }
  if (-not $bash) { Err "could not install Git for Windows; install it from https://git-scm.com and run setup again"; exit 1 }
  "Installed Git Bash: $bash"
}
$c = Get-Command claude -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
if ($c) { "Claude Code is already installed: " + (& $c.Source --version) } else {
  # What https://claude.ai/install.ps1 does, but downloading with curl.exe:
  # Invoke-WebRequest in Windows PowerShell 5.1 times out on the ~270 MB binary.
  "Installing Claude Code..."
  $base = "https://downloads.claude.ai/claude-code-releases"
  $plat = if ($env:PROCESSOR_ARCHITECTURE -eq "ARM64") { "win32-arm64" } else { "win32-x64" }
  $exe = $null
  try {
    $ver = "$(Invoke-RestMethod -UseBasicParsing "$base/latest")".Trim()
    if ($ver -notmatch "^\d+\.\d+\.\d+") { throw "unexpected answer from downloads.claude.ai: $ver" }
    $sum = (Invoke-RestMethod -UseBasicParsing "$base/$ver/manifest.json").platforms.$plat.checksum
    if (-not $sum) { throw "no $plat build in the manifest of $ver" }
    $dl = "$env:USERPROFILE\.claude\downloads"
    New-Item -ItemType Directory -Force -Path $dl | Out-Null
    $exe = "$dl\claude-$ver-$plat.exe"
    if (Get-Command curl.exe -ErrorAction SilentlyContinue) {
      curl.exe -fsSL --retry 2 -o $exe "$base/$ver/$plat/claude.exe"
      if ($LASTEXITCODE) { throw "download failed (curl exit code $LASTEXITCODE)" }
    } else {
      Invoke-WebRequest -UseBasicParsing "$base/$ver/$plat/claude.exe" -OutFile $exe
    }
    if ((Get-FileHash -Algorithm SHA256 -LiteralPath $exe).Hash.ToLower() -ne $sum) { throw "checksum mismatch" }
    & $exe install latest
    if ($LASTEXITCODE) { throw "claude install exited with code $LASTEXITCODE" }
  } catch { Err "installing Claude Code failed: $_" }
  finally { if ($exe) { Start-Sleep -Seconds 1; Remove-Item -LiteralPath $exe -ErrorAction SilentlyContinue } }
  $c = Get-Command claude -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
  if (-not $c) { Err "Claude Code installation failed"; exit 1 }
  "Installed Claude Code: " + (& $c.Source --version)
}
exit 0
'

# The hook dot-sourced from the PowerShell profile on the VM.
win_autostart_hook() { # DIR
  cat <<EOF
# Installed by vmclaude: open Claude Code on interactive SSH logins.
# Quit Claude to get a normal PowerShell prompt. Turn off: vmclaude autostart NAME off
$WIN_INVOKE_PS
if (\$env:SSH_CONNECTION -and -not \$env:VMCLAUDE_NO_AUTOSTART -and [Environment]::GetCommandLineArgs().Count -le 1 -and -not [Console]::IsInputRedirected) {
  \$env:VMCLAUDE_NO_AUTOSTART = "1"
  \$env:Path = "\$env:USERPROFILE\.local\bin;\$env:Path"
  \$vmclaudeDir = $(psq "$1")
  if (\$vmclaudeDir -eq "" -or \$vmclaudeDir -eq "~") { \$vmclaudeDir = \$env:USERPROFILE }
  elseif (\$vmclaudeDir -match "^~[\\\\/]") { \$vmclaudeDir = Join-Path \$env:USERPROFILE \$vmclaudeDir.Substring(2) }
  \$vmclaudeExe = Get-Command claude -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
  if (\$vmclaudeExe -and (Test-Path -LiteralPath \$vmclaudeDir)) {
    [void](Invoke-Claude \$vmclaudeExe.Source "" (Resolve-Path -LiteralPath \$vmclaudeDir).Path)
  }
  Remove-Variable vmclaudeDir, vmclaudeExe -ErrorAction SilentlyContinue
}
EOF
}

# Writes the hook file; win_autostart_ps then links it from the profile.
# (Two steps: together they do not fit in one Windows command line.)
win_hook_ps() { # DIR
  cat <<EOF
New-Item -ItemType Directory -Force -Path "\$env:USERPROFILE\.config\vmclaude" | Out-Null
Set-Content -LiteralPath "\$env:USERPROFILE\.config\vmclaude\autostart.ps1" -Value $(psq "$(win_autostart_hook "$1")") -Encoding UTF8
exit 0
EOF
}

# shellcheck disable=SC2016
win_autostart_ps() { # on|off
  printf '%s' "$WIN_ENV_PS"
  cat <<EOF
\$mode = $(psq "$1")
\$dir = "\$env:USERPROFILE\.config\vmclaude"
\$hook = "\$dir\autostart.ps1"
\$prof = \$PROFILE.CurrentUserCurrentHost
\$begin = "# >>> vmclaude autostart >>>"
\$end = "# <<< vmclaude autostart <<<"
\$out = New-Object System.Collections.Generic.List[string]
\$skip = \$false
if (Test-Path -LiteralPath \$prof) {
  foreach (\$l in @(Get-Content -LiteralPath \$prof)) {
    if (\$l -eq \$begin) { \$skip = \$true } elseif (\$l -eq \$end) { \$skip = \$false } elseif (-not \$skip) { \$out.Add(\$l) }
  }
}
if (\$mode -eq "off") {
  if (Test-Path -LiteralPath \$prof) { Set-Content -LiteralPath \$prof -Value \$out -Encoding UTF8 }
  Remove-Item -LiteralPath \$hook -ErrorAction SilentlyContinue
  "Autostart is off."
  exit 0
}
if (-not (Test-Path -LiteralPath \$hook)) { Err "the hook \$hook is missing"; exit 1 }
\$out.Add(\$begin)
\$out.Add('if (Test-Path "\$env:USERPROFILE\.config\vmclaude\autostart.ps1") { . "\$env:USERPROFILE\.config\vmclaude\autostart.ps1" }')
\$out.Add(\$end)
New-Item -ItemType Directory -Force -Path (Split-Path -Parent \$prof) | Out-Null
Set-Content -LiteralPath \$prof -Value \$out -Encoding UTF8
# The policy an SSH login will have (this script itself runs with Bypass).
function Get-LoginPolicy {
  foreach (\$s in "MachinePolicy", "UserPolicy", "CurrentUser", "LocalMachine") {
    \$p = "\$(Get-ExecutionPolicy -Scope \$s)"
    if (\$p -ne "Undefined") { return \$p }
  }
  "Restricted"
}
\$pol = Get-LoginPolicy
if (@("Restricted", "AllSigned") -contains \$pol) {
  # Throws "overridden by a more specific scope" (our Bypass) even when it worked.
  try { Set-ExecutionPolicy -Scope CurrentUser -ExecutionPolicy RemoteSigned -Force -ErrorAction Stop } catch { }
  if (@("Restricted", "AllSigned") -contains (Get-LoginPolicy)) {
    Err "PowerShell does not run profile scripts here (execution policy \$pol, set by policy); autostart will not work"
  } else {
    "Execution policy for this user: RemoteSigned (was \$pol), so the PowerShell profile can run."
  }
}
\$shell = (Get-ItemProperty HKLM:\SOFTWARE\OpenSSH -ErrorAction SilentlyContinue).DefaultShell
if ("\$shell" -notmatch "powershell\.exe\$") {
  Err "autostart needs Windows PowerShell as the OpenSSH default shell (now: \$(if (\$shell) { \$shell } else { 'cmd.exe' }))"
}
"Autostart is on: SSH logins open Claude Code (quit Claude to get a shell)."
exit 0
EOF
}

