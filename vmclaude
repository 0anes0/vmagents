[[ -t 0 && -t 1 ]] && TTY_FLAG=-t

# Quote for a POSIX shell (also safe in bash, zsh and fish).
sq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

# remote_cmd SCRIPT ARGS... -> one command line that runs SCRIPT with ARGS
# under sh on the VM, whatever the user's login shell is.
remote_cmd() {
  local out a
  out="sh -c $(sq "$1") vmclaude"
  shift
  for a in "$@"; do out+=" $(sq "$a")"; done
  printf '%s' "$out"
}

