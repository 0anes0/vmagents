# shellcheck disable=SC2029 # remote commands are built with remote_cmd/sq
run_ssh() { ssh "${SSH_OPTS[@]}" "$@"; }

# "exit 0" works in sh, cmd.exe and PowerShell alike.
key_auth_works() { run_ssh -o BatchMode=yes -T -- "$TARGET" "exit 0" </dev/null >/dev/null 2>&1; }

ensure_key() {
  [[ -f $C_KEY ]] && return 0
  [[ $C_KEY == "$DEFAULT_KEY" ]] || die "key file not found: $C_KEY"
  command -v ssh-keygen >/dev/null || die "ssh-keygen not found (install openssh-client)"
  mkdir -p "$(dirname "$C_KEY")"
  chmod 700 "$(dirname "$C_KEY")"
  info "Creating SSH key $C_KEY"
  ssh-keygen -q -t ed25519 -N '' -C "vmclaude@$(hostname 2>/dev/null || echo host)" -f "$C_KEY" ||
    die "ssh-keygen failed"
}

# ------------------------------------------------------------------ commands

cmd_add() {
  local name='' k v created=0
  declare -A opts=()
  while (($#)); do
    case $1 in
      --host | --user | --port | --key | --domain | --uri | --dir | --session | --os)
        (($# >= 2)) || usage_error "add: $1 needs a value"
        case $1 in
          --key) k=IDENTITY ;;
          --uri) k=LIBVIRT_URI ;;
          *) k=${1#--}; k=${k^^} ;;
        esac
        opts[$k]=$2; shift 2 ;;
      --no-tmux) opts[SESSION]=; shift ;;
      -*) usage_error "add: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "add: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || usage_error "add: missing NAME"
  valid_name "$name" || die "invalid profile name: $name (letters, digits, . _ - only)"
  for k in "${!opts[@]}"; do
    v=${opts[$k]}
    [[ -z $v && $k != SESSION ]] || check_value "$k" "$v"
  done
  if profile_exists "$name"; then read_profile "$name"; else P=(); created=1; fi
  for k in "${!opts[@]}"; do
    if [[ -z ${opts[$k]} && $k != SESSION ]]; then unset "P[$k]"; else P[$k]=${opts[$k]}; fi
  done
  [[ -n ${P[HOST]:-} || -n ${P[DOMAIN]:-} ]] || die "add: give --host, --domain, or both"
  write_profile "$name"
  if ((created)); then say "Added VM '$name'. Next: $PROG setup $name"; else say "Updated VM '$name'."; fi
}

cmd_list() {
  local names name def target state
  names=$(profile_names)
  if [[ -z $names ]]; then say "No VMs yet. Add one: $PROG add NAME --host IP  (or --domain LIBVIRT_DOMAIN)"; return 0; fi
  def=$(default_name || true)
  while IFS= read -r name; do
    read_profile "$name"
    target=${P[USER]:-$(id -un)}@${P[HOST]:-"(auto)"}
    [[ ${P[PORT]:-22} != 22 ]] && target+=":${P[PORT]}"
    if [[ -n ${P[DOMAIN]:-} ]]; then
      target+="  libvirt:${P[DOMAIN]}"
      if command -v virsh >/dev/null; then
        state=$(timeout 5 virsh -c "${P[LIBVIRT_URI]:-qemu:///system}" domstate "${P[DOMAIN]}" 2>/dev/null) || state=
        state=${state%%$'\n'*}
        [[ -n $state ]] && target+=" ($state)"
      fi
    fi
    [[ ${P[OS]:-} == windows ]] && target+="  (Windows)"
    printf '%s %-16s %s\n' "$([[ $name == "$def" ]] && echo '*' || echo ' ')" "$name" "$target"
  done <<<"$names"
}

cmd_default() {
  [[ $# = 1 ]] || usage_error "default: give one NAME"
  profile_exists "$1" || die "no VM profile named '$1'"
  mkdir -p "$CONF_DIR"
  printf '%s\n' "$1" >"$CONF_DIR/default"
  say "Default VM: $1"
}

cmd_rm() {
  [[ $# = 1 ]] || usage_error "rm: give one NAME"
  profile_exists "$1" || die "no VM profile named '$1'"
  rm -f "$(profile_file "$1")" "$APPS_DIR/vmclaude-$1.desktop"
  if [[ -f $CONF_DIR/default && $(<"$CONF_DIR/default") == "$1" ]]; then rm -f "$CONF_DIR/default"; fi
  if [[ -f $KNOWN_HOSTS ]]; then ssh-keygen -R "vmclaude-$1" -f "$KNOWN_HOSTS" >/dev/null 2>&1 || true; rm -f "$KNOWN_HOSTS.old"; fi
  say "Removed VM '$1'."
}

cmd_edit() {
  [[ $# = 1 ]] || usage_error "edit: give one NAME"
  profile_exists "$1" || die "no VM profile named '$1'"
  "${VISUAL:-${EDITOR:-vi}}" "$(profile_file "$1")"
}

cmd_forget() {
  [[ $# = 1 ]] || usage_error "forget: give one NAME"
  profile_exists "$1" || die "no VM profile named '$1'"
  if [[ -f $KNOWN_HOSTS ]] && ssh-keygen -R "vmclaude-$1" -f "$KNOWN_HOSTS" >/dev/null 2>&1; then
    rm -f "$KNOWN_HOSTS.old"
  fi
  say "Forgot the host key of '$1'; the next connection will accept the new one."
}

cmd_connect() {
  local name='' notmux=0 keep=0
  local -a cargs=()
  while (($#)); do
    case $1 in
      --hold) HOLD=1; shift ;;
      --no-tmux) notmux=1; shift ;;
      --keep) keep=1; shift ;;
      --) shift; cargs+=("$@"); break ;;
      *)
        if [[ -z $name ]] && [[ $1 != -* ]]; then name=$1; shift
        else cargs+=("$@"); break
        fi ;;
    esac
  done
  if [[ -z $name ]]; then
    name=$(default_name) || die "several VMs and no default; name one, or: $PROG default NAME"
  fi
  load "$name"
  ((notmux)) && C_SESSION=
  resolve_target
  build_ssh_opts
  local rc=0
  local cmd
  if [[ $C_OS == windows ]]; then
    cmd=$(win_cmd -i "$(win_connect_ps "$C_DIR" "$NAME" "${cargs[@]}")")
  else
    cmd=$(remote_cmd "$CONNECT_SH" "$C_DIR" "$C_SESSION" "$NAME" "${cargs[@]}")
  fi
  run_ssh "$TTY_FLAG" -- "$TARGET" "$cmd" || rc=$?
  if ((rc == 255)); then
    info "$PROG: SSH connection to $C_USER@$TARGET:$C_PORT failed. Try: $PROG doctor $NAME"
  elif ((!keep)); then
    autostop
  fi
  ((rc == 0)) || hold_prompt
  return "$rc"
}

cmd_shell() {
  local keep=0 rc=0
  [[ ${1-} == --keep ]] && { keep=1; shift; }
  (($#)) || usage_error "shell: missing NAME"
  load "$1"; shift
  resolve_target
  build_ssh_opts
  if (($#)); then
    run_ssh -- "$TARGET" "$@"
    return
  elif [[ $C_OS == windows ]]; then
    # shellcheck disable=SC2016
    run_ssh "$TTY_FLAG" -- "$TARGET" "$(win_cmd -noexit '$env:VMCLAUDE_NO_AUTOSTART = "1"
if (Test-Path -LiteralPath $PROFILE) { . $PROFILE }')" || rc=$?
  else
    # shellcheck disable=SC2016
    run_ssh "$TTY_FLAG" -- "$TARGET" 'VMCLAUDE_NO_AUTOSTART=1 exec "${SHELL:-/bin/sh}" -l' || rc=$?
  fi
  ((rc == 255 || keep)) || autostop
  return "$rc"
}

cmd_autostart() {
  [[ $# = 2 ]] || usage_error "autostart: give NAME and on|off"
  local mode=$2
  [[ $mode == on || $mode == off ]] || usage_error "autostart: say on or off"
  load "$1"
  resolve_target
  build_ssh_opts
  install_autostart "$mode"
}

install_autostart() { # on|off
  if [[ $C_OS == windows ]]; then
    if [[ $1 == on ]]; then win_run "$(win_hook_ps "$C_DIR")" || return 1; fi
    win_run "$(win_autostart_ps "$1")"
  elif [[ $1 == on ]]; then
    autostart_hook "$C_DIR" "$C_SESSION" | run_ssh -T -- "$TARGET" "$(remote_cmd "$AUTOSTART_SH" on)"
  else
    run_ssh -T -- "$TARGET" "$(remote_cmd "$AUTOSTART_SH" off)" </dev/null
  fi
}

# Why the VM should stay on ("" when nothing uses it): other connections from
# here (vmclaude shell, mount, another connect), tmux sessions, logins.
vm_busy() {
  local pid args n=0 out
  while read -r pid args; do
    [[ $pid == "$$" ]] && continue
    [[ " $args " == *"HostKeyAlias=vmclaude-$NAME "* ]] && n=$((n + 1))
  done < <(ps -eo pid=,args= 2>/dev/null || true)
  if ((n)); then
    printf 'another connection from this computer is open (vmclaude shell, mount, ...)'
    return 0
  fi
  if [[ $C_OS == windows ]]; then
    out=$(run_ssh -o BatchMode=yes -T -- "$TARGET" "$(win_cmd "$BUSY_PS")" </dev/null 2>/dev/null) ||
      { printf 'could not check the VM over SSH'; return 0; }
  else
    out=$(run_ssh -o BatchMode=yes -T -- "$TARGET" "$(remote_cmd "$BUSY_SH")" </dev/null 2>/dev/null) ||
      { printf 'could not check the VM over SSH'; return 0; }
  fi
  out=${out//$'\r'/}
  out=$(sed '/^$/d' <<<"$out")
  printf '%s' "${out//$'\n'/; }"
}

# After a session: shut the libvirt VM down unless something else uses it.
autostop() {
  [[ -n $C_DOMAIN && ${P[AUTOSTOP]:-on} == on ]] || return 0
  local why
  why=$(vm_busy)
  if [[ -n $why ]]; then
    info "VM $C_DOMAIN stays on: $why."
    [[ $why == *tmux* ]] && info "Back to Claude: $PROG $NAME"
    info "Shut it down: $PROG stop $NAME"
    return 0
  fi
  stop_vm 0 || true
}

cmd_start() {
  [[ $# = 1 ]] || usage_error "start: give one NAME"
  load "$1"
  [[ -n $C_DOMAIN ]] || die "'$NAME' is not a libvirt VM (no --domain); start it yourself"
  resolve_target
  say "VM $NAME is running: $C_USER@$TARGET"
}

cmd_stop() {
  local name='' force=0
  while (($#)); do
    case $1 in
      -f | --force) force=1; shift ;;
      -*) usage_error "stop: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "stop: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || name=$(default_name) || usage_error "stop: missing NAME"
  load "$name"
  [[ -n $C_DOMAIN ]] || die "'$NAME' is not a libvirt VM (no --domain); shut it down yourself, e.g.: $PROG shell $NAME 'sudo poweroff'"
  stop_vm "$force"
}

cmd_autostop() {
  [[ $# = 2 ]] || usage_error "autostop: give NAME and on|off"
  local mode=$2
  [[ $mode == on || $mode == off ]] || usage_error "autostop: say on or off"
  load "$1"
  [[ -n $C_DOMAIN ]] || die "autostop needs a libvirt VM; '$NAME' has no --domain"
  P[AUTOSTOP]=$mode
  write_profile "$NAME"
  if [[ $mode == on ]]; then
    say "Autostop is on: the VM shuts down when you leave Claude (unless something else still uses it)."
  else
    say "Autostop is off: the VM keeps running after you leave Claude ($PROG stop $NAME shuts it down)."
  fi
}

cmd_setup() {
  local name='' install=1 autostart=1
  while (($#)); do
    case $1 in
      --no-install) install=0; shift ;;
      --no-autostart) autostart=0; shift ;;
      -*) usage_error "setup: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "setup: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || name=$(default_name) || usage_error "setup: missing NAME"
  load "$name"
  command -v ssh >/dev/null || die "ssh not found (install openssh-client)"
  ensure_key
  resolve_target
  build_ssh_opts

  info "[1/3] SSH key"
  if key_auth_works; then
    info "  key login already works"
  else
    info "  installing $C_KEY.pub for $C_USER@$TARGET (enter the VM password if asked)"
    local addkey
    if [[ $C_OS == windows ]]; then
      addkey=$(win_cmd "$(win_addkey_ps "$(<"$C_KEY.pub")")")
    else
      addkey=$(remote_cmd "$ADDKEY_SH")
    fi
    run_ssh -T -o PreferredAuthentications=keyboard-interactive,password,publickey -- \
      "$TARGET" "$addkey" <"$C_KEY.pub" ||
      die "could not install the key (wrong password? is password login enabled on the VM?)"
    if ! key_auth_works; then
      [[ $C_OS == windows ]] &&
        die "key installed, but key login still fails (for administrators Windows reads C:\\ProgramData\\ssh\\administrators_authorized_keys; was the session elevated?)"
      die "key installed, but key login still fails (check PubkeyAuthentication and home directory permissions on the VM)"
    fi
    info "  key login works"
  fi

  if ((install)) && [[ $C_OS == windows ]]; then
    info "[2/3] Git for Windows and Claude Code"
    win_run "$WIN_INSTALL_PS" || die "installing on the VM failed"
  elif ((install)); then
    info "[2/3] tmux and Claude Code"
    run_ssh "$TTY_FLAG" -- "$TARGET" "$(remote_cmd "$INSTALL_SH")" || die "installing on the VM failed"
  else
    info "[2/3] skipped installing Claude Code"
  fi

  if ((autostart)); then
    info "[3/3] autostart on SSH login"
    install_autostart on || die "could not install the autostart hook"
  else
    info "[3/3] skipped autostart"
  fi

  say ""
  say "Done. Open Claude on the VM with:  $PROG $NAME"
  say "Log in to Claude once (in a browser on this computer):  $PROG login $NAME"
  [[ $C_OS == windows ]] && say "Windows has no tmux: closing the connection ends Claude's session."
  say "App-menu launcher:                 $PROG desktop $NAME"
}

cmd_doctor() {
  local name=${1:-} ok=1 out
  [[ -n $name ]] || name=$(default_name) || usage_error "doctor: missing NAME"
  load "$name"
  pass() { printf '  ok    %s\n' "$*"; }
  fail() { printf '  FAIL  %s\n' "$*"; ok=0; }
  say "Checking '$NAME'"
  if command -v ssh >/dev/null; then pass "ssh: $(ssh -V 2>&1)"; else fail "ssh not installed"; fi
  if [[ -f $C_KEY ]]; then pass "key: $C_KEY"; else fail "key $C_KEY missing (run: $PROG setup $NAME)"; fi
  if [[ -n $C_DOMAIN ]]; then
    if ! command -v virsh >/dev/null; then fail "virsh not installed"; return 1; fi
    if out=$(vsh domstate "$C_DOMAIN" 2>&1); then
      out=${out%%$'\n'*}
      if [[ $out == running ]]; then pass "libvirt domain $C_DOMAIN: running"
      else fail "libvirt domain $C_DOMAIN: $out (connecting starts it)"; return 1; fi
    else
      fail "libvirt: $out"; return 1
    fi
    if [[ -n $C_HOST ]]; then TARGET=$C_HOST
    elif find_ip; then TARGET=$FOUND_IP; pass "IP address: $TARGET"
    else fail "no IPv4 address yet (still booting? network down?)"; return 1
    fi
  else
    TARGET=$C_HOST
  fi
  if ssh_ready "$TARGET" "$C_PORT"; then pass "SSH server answers on $TARGET:$C_PORT ($BANNER)"
  else fail "no SSH server answers on $TARGET:$C_PORT"; return 1; fi
  detect_os
  build_ssh_opts
  if key_auth_works; then pass "key login as $C_USER"
  else fail "key login as $C_USER failed (run: $PROG setup $NAME)"; return 1; fi
  local probe
  if [[ $C_OS == windows ]]; then
    probe=$(win_cmd "$WIN_DOCTOR_PS")
  else
    # shellcheck disable=SC2016
    probe=$(remote_cmd "$REMOTE_ENV"'
printf "claude=%s\n" "$(command -v claude >/dev/null 2>&1 && claude --version 2>/dev/null | head -n 1)"
printf "tmux=%s\n" "$(command -v tmux >/dev/null 2>&1 && tmux -V)"
printf "hook=%s\n" "$([ -f "$HOME/.config/vmclaude/autostart.sh" ] && echo on)"
printf "login=%s\n" "$(if [ -f "$HOME/.config/vmclaude/claude-env" ]; then echo token; elif [ -f "$HOME/.claude/.credentials.json" ]; then echo login; fi)"
')
  fi
  out=$(run_ssh -T -o BatchMode=yes -- "$TARGET" "$probe" </dev/null 2>/dev/null | tr -d '\r') ||
    { fail "running a command on the VM failed"; return 1; }
  local claude tmux hook git
  claude=$(sed -n 's/^claude=//p' <<<"$out")
  tmux=$(sed -n 's/^tmux=//p' <<<"$out")
  git=$(sed -n 's/^git=//p' <<<"$out")
  hook=$(sed -n 's/^hook=//p' <<<"$out")
  if [[ -n $claude ]]; then pass "Claude Code on the VM: $claude"; else fail "Claude Code not installed on the VM (run: $PROG setup $NAME)"; fi
  if [[ $C_OS == windows ]]; then
    if [[ -n $git ]]; then pass "Git for Windows: $git"; else fail "Git for Windows not installed (run: $PROG setup $NAME)"; fi
  elif [[ -n $tmux ]]; then pass "tmux on the VM: $tmux"
  elif [[ -n $C_SESSION ]]; then printf '  warn  tmux not installed; sessions end when the connection drops\n'; fi
  if [[ -n $hook ]]; then pass "autostart on SSH login: on"; else printf '  info  autostart on SSH login: off\n'; fi
  case $(sed -n 's/^login=//p' <<<"$out") in
    token) pass "Claude login: token from \"$PROG login\"" ;;
    login) pass "Claude login: done inside Claude (/login)" ;;
    *) printf '  info  Claude login: not yet (run: %s login %s)\n' "$PROG" "$NAME" ;;
  esac
  ((ok)) && say "All good." || return 1
}

# ------------------------------------------------------------------ create / delete

CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/vmclaude
CREATE_POOL=${VMCLAUDE_POOL:-default}
CREATE_NETWORK=${VMCLAUDE_NETWORK:-default}

# Sets IMG_URL, IMG_SUMS (checksum list), IMG_ALGO, IMG_OSINFO for an image name.
IMG_URL='' IMG_SUMS='' IMG_ALGO='' IMG_OSINFO=''
image_info() {
  case $1 in
    debian13 | debian)
      IMG_URL=https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2
      IMG_SUMS=https://cloud.debian.org/images/cloud/trixie/latest/SHA512SUMS
      IMG_ALGO=sha512 IMG_OSINFO=debian13 ;;
    debian12)
      IMG_URL=https://cloud.debian.org/images/cloud/bookworm/latest/debian-12-genericcloud-amd64.qcow2
      IMG_SUMS=https://cloud.debian.org/images/cloud/bookworm/latest/SHA512SUMS
      IMG_ALGO=sha512 IMG_OSINFO=debian12 ;;
    ubuntu24.04 | ubuntu)
      IMG_URL=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
      IMG_SUMS=https://cloud-images.ubuntu.com/noble/current/SHA256SUMS
      IMG_ALGO=sha256 IMG_OSINFO=ubuntu24.04 ;;
    arch | archlinux)
      # The checksum always comes from Arch itself; the image may come from
      # a faster mirror (VMCLAUDE_ARCH_MIRROR, e.g. https://mirrors.dotsrc.org/archlinux).
      IMG_URL=${VMCLAUDE_ARCH_MIRROR:-https://geo.mirror.pkgbuild.com}
      IMG_URL=${IMG_URL%/}/images/latest/Arch-Linux-x86_64-cloudimg.qcow2
      IMG_SUMS=https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2.SHA256
      IMG_ALGO=sha256 IMG_OSINFO=archlinux ;;
    *) die "unknown image: $1 (choose debian13, debian12, ubuntu24.04 or arch; see: $PROG images)" ;;
  esac
}

# Sets IMG_HASH: the published checksum of the current image (or, offline,
# the checksum of the cached copy).
IMG_FILE='' IMG_HASH=''
image_hash() {
  local name=${IMG_URL##*/} sums
  mkdir -p "$CACHE_DIR/images"
  IMG_FILE=$CACHE_DIR/images/$name
  if sums=$(curl -fsSL "$IMG_SUMS"); then
    IMG_HASH=$(awk -v f="$name" '$2 == f || $2 == "*" f { print $1; exit }' <<<"$sums")
    [[ -n $IMG_HASH ]] || die "no checksum for $name in $IMG_SUMS"
  elif [[ -f $IMG_FILE ]]; then
    warn "cannot fetch $IMG_SUMS; using the cached image unchecked"
    IMG_HASH=$("${IMG_ALGO}sum" "$IMG_FILE" | cut -d' ' -f1)
  else
    die "cannot download $IMG_SUMS (offline?)"
  fi
}

# Makes sure IMG_FILE holds the image with IMG_HASH: downloads it if needed.
fetch_image() {
  local got
  if [[ -f $IMG_FILE ]] && [[ $("${IMG_ALGO}sum" "$IMG_FILE" | cut -d' ' -f1) == "$IMG_HASH" ]]; then
    info "Using cached image $IMG_FILE"
    return 0
  fi
  info "Downloading $IMG_URL"
  local -a progress=(-s)
  [[ -t 2 ]] && progress=(-#)
  curl -fL "${progress[@]}" -o "$IMG_FILE.part" "$IMG_URL" || die "download failed"
  got=$("${IMG_ALGO}sum" "$IMG_FILE.part" | cut -d' ' -f1)
  [[ $got == "$IMG_HASH" ]] ||
    { rm -f "$IMG_FILE.part"; die "checksum mismatch for ${IMG_URL##*/} (a mirror may not have synced the latest image yet)"; }
  mv -f "$IMG_FILE.part" "$IMG_FILE"
}

osinfo_name() { # NAME -> NAME if virt-install knows it, else a generic Linux
  if virt-install --osinfo list 2>/dev/null | tr ',' '\n' | sed 's/^ *//' | grep -qxF "$1"; then
    printf '%s' "$1"
  else
    printf 'linux2022'
  fi
}

cloud_user_data() { # HOSTNAME USER PUBKEY
  cat <<EOF
#cloud-config
hostname: $1
users:
  - name: $2
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
      - $3
package_update: true
packages: [tmux, curl]
EOF
}

cmd_create() {
  local name='' image=debian13 memory=4096 cpus=2 disk=20 user uri=qemu:///system install=1 k
  user=$(id -un)
  while (($#)); do
    case $1 in
      --image | --memory | --cpus | --disk | --user | --uri)
        (($# >= 2)) || usage_error "create: $1 needs a value"
        case $1 in
          --image) image=$2 ;; --memory) memory=$2 ;; --cpus) cpus=$2 ;;
          --disk) disk=$2 ;; --user) user=$2 ;; --uri) uri=$2 ;;
        esac
        shift 2 ;;
      --no-setup) install=0; shift ;;
      -*) usage_error "create: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "create: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || usage_error "create: missing NAME"
  valid_name "$name" || die "invalid name: $name (letters, digits, . _ - only)"
  profile_exists "$name" && die "a VM profile named '$name' already exists"
  for k in "$memory" "$cpus" "$disk"; do [[ $k =~ ^[1-9][0-9]*$ ]] || die "--memory, --cpus and --disk take whole numbers"; done
  check_value USER "$user"
  image_info "$image"
  local tool
  local iso_tool=''
  for tool in xorriso genisoimage mkisofs; do command -v "$tool" >/dev/null && { iso_tool=$tool; break; }; done
  [[ -n $iso_tool ]] || die "xorriso not found (sudo apt install xorriso)"
  for tool in virsh virt-install curl "${IMG_ALGO}sum"; do
    command -v "$tool" >/dev/null || die "$tool not found (on Debian/Ubuntu: sudo apt install libvirt-clients virtinst)"
  done
  C_URI=$uri
  vsh dominfo "$name" >/dev/null 2>&1 && die "libvirt already has a VM named '$name'"
  vsh pool-info "$CREATE_POOL" >/dev/null 2>&1 || die "libvirt storage pool '$CREATE_POOL' not found (set VMCLAUDE_POOL)"
  vsh net-info "$CREATE_NETWORK" >/dev/null 2>&1 || die "libvirt network '$CREATE_NETWORK' not found (set VMCLAUDE_NETWORK)"
  vsh net-start "$CREATE_NETWORK" >/dev/null 2>&1 || true

  C_KEY=$DEFAULT_KEY
  ensure_key
  image_hash

  # One base volume per image release, shared by all VMs as a backing file.
  # (--video vga below matters: without any video device the GRUB of the
  # Debian cloud image resets the VM in a loop right after "Booting".)
  local base="vmclaude-base-$image-${IMG_HASH:0:12}.qcow2" vol="$name.qcow2" out
  if vsh vol-info --pool "$CREATE_POOL" "$base" >/dev/null 2>&1; then
    info "Using base volume $base"
  else
    fetch_image
    info "Copying the image into libvirt pool '$CREATE_POOL'"
    out=$(vsh vol-create-as "$CREATE_POOL" "$base" "$(stat -c %s "$IMG_FILE")" --format qcow2 2>&1) || die "libvirt: $out"
    out=$(vsh vol-upload --pool "$CREATE_POOL" "$base" "$IMG_FILE" 2>&1) ||
      { vsh vol-delete --pool "$CREATE_POOL" "$base" >/dev/null 2>&1; die "libvirt: $out"; }
    vsh pool-refresh "$CREATE_POOL" >/dev/null 2>&1 || true
  fi
  vsh vol-info --pool "$CREATE_POOL" "$vol" >/dev/null 2>&1 && die "volume $vol already exists in pool '$CREATE_POOL'"
  out=$(vsh vol-create-as "$CREATE_POOL" "$vol" "${disk}G" --format qcow2 \
    --backing-vol "$base" --backing-vol-format qcow2 2>&1) || die "libvirt: $out"

  # cloud-init seed (NoCloud): our own ISO on a read-only virtio disk, kept
  # attached. Not virt-install --cloud-init: that puts it on a SATA CD-ROM,
  # and the Debian 12 cloud kernel has no driver for it.
  local tmp seed="$name-seed.iso"
  tmp=$(mktemp -d)
  cloud_user_data "$name" "$user" "$(<"$C_KEY.pub")" >"$tmp/user-data"
  printf 'instance-id: %s-%s\nlocal-hostname: %s\n' "$name" "$(date +%s)" "$name" >"$tmp/meta-data"
  if [[ $iso_tool == xorriso ]]; then
    out=$(xorriso -as mkisofs -V cidata -J -r -o "$tmp/seed.iso" "$tmp/user-data" "$tmp/meta-data" 2>&1)
  else
    out=$("$iso_tool" -V cidata -J -r -o "$tmp/seed.iso" "$tmp/user-data" "$tmp/meta-data" 2>&1)
  fi || { rm -rf "$tmp"; die "creating the cloud-init seed failed: $out"; }
  vsh vol-delete --pool "$CREATE_POOL" "$seed" >/dev/null 2>&1 || true
  if ! out=$(vsh vol-create-as "$CREATE_POOL" "$seed" "$(stat -c %s "$tmp/seed.iso")" --format raw 2>&1) ||
    ! out=$(vsh vol-upload --pool "$CREATE_POOL" "$seed" "$tmp/seed.iso" 2>&1); then
    rm -rf "$tmp"
    vsh vol-delete --pool "$CREATE_POOL" "$vol" >/dev/null 2>&1 || true
    die "libvirt: $out"
  fi
  rm -rf "$tmp"
  info "Creating VM $name ($image, ${memory} MB, $cpus CPUs, ${disk} GB)"
  if ! out=$(virt-install --connect "$uri" --name "$name" --memory "$memory" --vcpus "$cpus" \
    --import --disk "vol=$CREATE_POOL/$vol,bus=virtio" --disk "vol=$CREATE_POOL/$seed,device=disk,bus=virtio,readonly=on" \
    --osinfo "$(osinfo_name "$IMG_OSINFO")" --network "network=$CREATE_NETWORK,model=virtio" \
    --metadata description="created by vmclaude" \
    --graphics none --video vga --console pty,target_type=serial --noautoconsole 2>&1); then
    vsh vol-delete --pool "$CREATE_POOL" "$vol" >/dev/null 2>&1 || true
    vsh vol-delete --pool "$CREATE_POOL" "$seed" >/dev/null 2>&1 || true
    die "virt-install failed: $out"
  fi

  P=([DOMAIN]=$name [USER]=$user [OS]=linux [CREATED]=1)
  [[ $uri != qemu:///system ]] && P[LIBVIRT_URI]=$uri
  write_profile "$name"
  info "Added VM profile '$name'."
  if ((install)); then
    # sshd can be up before cloud-init has created the user and its key.
    load "$name"
    resolve_target
    build_ssh_opts
    local deadline=$((SECONDS + BOOT_TIMEOUT)) noted=0
    until key_auth_works; do
      check_still_running
      ((SECONDS < deadline)) ||
        die "the new VM does not accept your SSH key after ${BOOT_TIMEOUT}s; see: virsh -c $C_URI console $name"
      ((noted)) || { info "Waiting for cloud-init to create user $C_USER..."; noted=1; }
      sleep 3
    done
    cmd_setup "$name"
  else
    say "Created. Next: $PROG setup $name"
  fi
}

cmd_delete() {
  local name='' yes=0 a
  while (($#)); do
    case $1 in
      -y | --yes) yes=1; shift ;;
      -*) usage_error "delete: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "delete: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || usage_error "delete: missing NAME"
  load "$name"
  # Only VMs that vmclaude created, and whose libvirt description says so.
  [[ ${P[CREATED]:-} == 1 && -n $C_DOMAIN ]] ||
    die "'$NAME' was not created by vmclaude; delete the VM yourself (to forget it here: $PROG rm $NAME)"
  [[ $(vsh desc "$C_DOMAIN" 2>/dev/null) == *"created by vmclaude"* ]] ||
    die "libvirt VM '$C_DOMAIN' is not marked as created by vmclaude; not deleting it"
  if ((!yes)); then
    [[ -t 0 ]] || die "delete: add --yes to confirm without a terminal"
    read -r -p "Delete VM '$C_DOMAIN' and its disk for good? Type its name: " a || a=
    [[ $a == "$C_DOMAIN" ]] || die "not deleted"
  fi
  vsh destroy "$C_DOMAIN" >/dev/null 2>&1 || true
  local out
  out=$(vsh undefine "$C_DOMAIN" --remove-all-storage --snapshots-metadata 2>&1) || die "libvirt: $out"
  cmd_rm "$NAME" >/dev/null
  say "Deleted VM '$NAME' and its disk."
}

IMAGES="debian13 debian12 ubuntu24.04 arch"
image_desc() {
  case $1 in
    debian13) printf 'Debian 13 "trixie" (default)' ;;
    debian12) printf 'Debian 12 "bookworm"' ;;
    ubuntu24.04) printf 'Ubuntu 24.04 LTS "noble"' ;;
    arch) printf 'Arch Linux (rolling release)' ;;
  esac
}

# Lists the images, what is downloaded, what is in the libvirt pool, and
# which VMs are built on it.
cmd_images() {
  local uri=qemu:///system
  while (($#)); do
    case $1 in
      --uri) (($# >= 2)) || usage_error "images: --uri needs a value"; uri=$2; shift 2 ;;
      *) usage_error "images: unknown argument $1" ;;
    esac
  done
  C_URI=$uri
  local lv=0 pool_path='' vols='' v b users img file dl base size row
  local -A used_by=()
  if command -v virsh >/dev/null && vsh pool-info "$CREATE_POOL" >/dev/null 2>&1; then
    lv=1
    pool_path=$(vsh pool-dumpxml "$CREATE_POOL" 2>/dev/null | sed -n 's:.*<path>\(.*\)</path>.*:\1:p' | head -n 1)
    vols=$(vsh vol-list "$CREATE_POOL" 2>/dev/null | awk 'NR > 2 && NF { print $1 }')
    for v in $vols; do
      b=$(vsh vol-dumpxml --pool "$CREATE_POOL" "$v" 2>/dev/null |
        sed -n '/<backingStore>/,/<\/backingStore>/s:.*<path>\(.*\)</path>.*:\1:p' | head -n 1)
      [[ -n $b ]] && used_by[${b##*/}]+="${used_by[${b##*/}]:+, }${v%.qcow2}"
    done
  fi

  say "Images for:  $PROG create NAME --image IMAGE"
  say ""
  printf '  %-12s %-30s %-11s %s\n' IMAGE SYSTEM DOWNLOADED "BASE IMAGE IN LIBVIRT (used by)"
  for img in $IMAGES; do
    image_info "$img"
    file=$CACHE_DIR/images/${IMG_URL##*/}
    dl=-
    [[ -f $file ]] && dl=$(du -h "$file" | cut -f1)
    row=-
    for base in $vols; do
      [[ $base == vmclaude-base-"$img"-*.qcow2 ]] || continue
      size=$(vsh vol-info --pool "$CREATE_POOL" "$base" 2>/dev/null | awk '/^Allocation:/ { print $2 $3 }')
      users=${used_by[$base]:-no VM}
      [[ $row == - ]] && row='' || row+='; '
      row+="$size ($users)"
    done
    ((lv)) || row="(libvirt not available)"
    printf '  %-12s %-30s %-11s %s\n' "$img" "$(image_desc "$img")" "$dl" "$row"
  done

  say ""
  say "Where they are:"
  say "  Downloads, kept only to make base images (prune deletes them):"
  say "    $CACHE_DIR/images/"
  if ((lv)); then
    say "  Base images, one per image release, in libvirt pool \"$CREATE_POOL\":"
    say "    $pool_path/vmclaude-base-IMAGE-CHECKSUM.qcow2"
    for base in $vols; do [[ $base == vmclaude-base-*.qcow2 ]] && say "      $base"; done
    say "  Each VM made with create: its own disk (only what differs from the base)"
    say "  and its cloud-init settings:"
    say "    $pool_path/NAME.qcow2   $pool_path/NAME-seed.iso"
  fi
  say ""
  say "Make a VM: $PROG create NAME --image IMAGE.  Free space: $PROG prune."
}

# Removes base volumes no VM disk is built on, and the downloaded images.
cmd_prune() {
  local uri=qemu:///system
  while (($#)); do
    case $1 in
      --uri) (($# >= 2)) || usage_error "prune: --uri needs a value"; uri=$2; shift 2 ;;
      *) usage_error "prune: unknown argument $1" ;;
    esac
  done
  command -v virsh >/dev/null || die "virsh not found"
  C_URI=$uri
  local vols v used='' path n=0
  vols=$(vsh vol-list "$CREATE_POOL" 2>/dev/null | awk 'NR > 2 && NF { print $1 }') ||
    die "cannot list libvirt pool '$CREATE_POOL'"
  for v in $vols; do
    used+=$(vsh vol-dumpxml --pool "$CREATE_POOL" "$v" 2>/dev/null |
      sed -n '/<backingStore>/,/<\/backingStore>/s:.*<path>\(.*\)</path>.*:\1:p')$'\n'
  done
  for v in $vols; do
    [[ $v == vmclaude-base-*.qcow2 ]] || continue
    path=$(vsh vol-path --pool "$CREATE_POOL" "$v" 2>/dev/null) || continue
    if grep -qxF "$path" <<<"$used"; then
      say "Kept $v (a VM uses it)"
    elif vsh vol-delete --pool "$CREATE_POOL" "$v" >/dev/null 2>&1; then
      say "Removed $v"
      n=$((n + 1))
    fi
  done
  if [[ -d $CACHE_DIR/images ]] && [[ -n $(ls -A "$CACHE_DIR/images") ]]; then
    say "Removed downloaded images ($(du -sh "$CACHE_DIR/images" | cut -f1))"
    rm -rf "${CACHE_DIR:?}/images"
  fi
  ((n)) || say "No unused base volumes."
}

# ------------------------------------------------------------------ MCP server
# "vmclaude mcp NAME" speaks MCP on stdin/stdout so that a Claude Code on this
# computer can run commands and edit files inside the VM. The protocol part is
# the Python program below; it calls the hidden __mcp-* commands for each step,
# so SSH options, VM start-up and Linux/Windows differences stay in one place.

mcp_prepare() { # NAME: load, start the VM if needed, connect options
  load "$1"
  resolve_target
  build_ssh_opts
}

# __mcp-info NAME: prints os=, home= and dir= (the working directory, created).
cmd___mcp-info() {
  mcp_prepare "$1"
  vm_info_lines
}

vm_info_lines() { # needs mcp_prepare first
  if [[ $C_OS == windows ]]; then
    # shellcheck disable=SC2016
    run_ssh -T -o BatchMode=yes -- "$TARGET" "$(win_cmd "$WIN_ENV_PS"'$d = Resolve-Dir '"$(psq "$C_DIR")"'
if (-not (Test-Path -LiteralPath $d)) { New-Item -ItemType Directory -Force -Path $d | Out-Null }
"os=windows"; "home=$env:USERPROFILE"; "dir=" + (Resolve-Path -LiteralPath $d).Path')" </dev/null | tr -d '\r'
  else
    # shellcheck disable=SC2016
    run_ssh -T -o BatchMode=yes -- "$TARGET" "$(remote_cmd "$REMOTE_ENV"'cd_dir "$1" || exit 1
printf "os=linux\nhome=%s\ndir=%s\n" "$HOME" "$PWD"' "$C_DIR")" </dev/null
  fi
}

# __mcp-run NAME DIR COMMAND: runs COMMAND in DIR on the VM (bash/sh on Linux,
# PowerShell on Windows). Output and exit code pass through.
cmd___mcp-run() {
  mcp_prepare "$1"
  local dir=$2 command=$3
  if [[ $C_OS == windows ]]; then
    # Errors are written as plain text: left to PowerShell, they reach us
    # as CLIXML when stderr is not a console.
    win_run "$WIN_ENV_PS\$global:LASTEXITCODE = 0
\$vmclaudeFailed = \$false
Set-Location -LiteralPath $(psq "$dir")
& {
$command
} 2>&1 | ForEach-Object {
  if (\$_ -is [System.Management.Automation.ErrorRecord]) { \$script:vmclaudeFailed = \$true; [Console]::Error.WriteLine(\$_.ToString()) }
  else { \$_ }
}
if (\$LASTEXITCODE) { exit \$LASTEXITCODE }
if (\$vmclaudeFailed) { exit 1 }
exit 0"
  else
    # shellcheck disable=SC2016
    run_ssh -T -o BatchMode=yes -- "$TARGET" "$(remote_cmd "$REMOTE_ENV"'cd "$1" || exit 1
if command -v bash >/dev/null 2>&1; then exec bash -c "$2"; else exec sh -c "$2"; fi' "$dir" "$command")" </dev/null
  fi
}

# Remote paths for scp/sftp: Windows wants C:/x/y written as /C:/x/y.
sftp_path() {
  local p=$1
  if [[ $C_OS == windows ]]; then
    p=${p//\\//}
    [[ $p == [A-Za-z]:/* ]] && p=/$p
  fi
  printf '%s' "$p"
}

run_scp() { # SRC DST (one of them remote, as host:path)
  local -a scp_opts=(-q -s -P "$C_PORT" -o "HostKeyAlias=vmclaude-$NAME" -o "UserKnownHostsFile=$KNOWN_HOSTS"
    -o StrictHostKeyChecking=accept-new -o BatchMode=yes -o ConnectTimeout=15)
  [[ -f $C_KEY ]] && scp_opts+=(-i "$C_KEY" -o IdentitiesOnly=yes)
  scp "${scp_opts[@]}" -- "$1" "$2"
}

scp_host() { # user@host, with IPv6 addresses in brackets
  if [[ $TARGET == *:* && $TARGET != \[* ]]; then printf '%s@[%s]' "$C_USER" "$TARGET"
  else printf '%s@%s' "$C_USER" "$TARGET"; fi
}

# __mcp-get NAME REMOTE_PATH LOCAL_FILE
cmd___mcp-get() {
  mcp_prepare "$1"
  run_scp "$(scp_host):$(sftp_path "$2")" "$3"
}

# __mcp-put NAME LOCAL_FILE REMOTE_PATH: creates the folder first.
cmd___mcp-put() {
  mcp_prepare "$1"
  local local_file=$2 remote=$3 parent
  if [[ $C_OS == windows ]]; then
    parent=${remote%[\\/]*}
    run_ssh -T -o BatchMode=yes -- "$TARGET" \
      "$(win_cmd "New-Item -ItemType Directory -Force -Path $(psq "$parent") | Out-Null")" </dev/null >/dev/null || return 1
  else
    parent=$(dirname -- "$remote")
    # shellcheck disable=SC2016
    run_ssh -T -o BatchMode=yes -- "$TARGET" "$(remote_cmd 'mkdir -p -- "$1"' "$parent")" </dev/null || return 1
  fi
  run_scp "$local_file" "$(scp_host):$(sftp_path "$remote")"
}

cmd_mcp() {
  local name='' add=0
  while (($#)); do
    case $1 in
      --add) add=1; shift ;;
      -*) usage_error "mcp: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "mcp: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || usage_error "mcp: missing NAME"
  load "$name"
  if ((add)); then
    command -v claude >/dev/null || die "the claude command is not installed on this computer"
    local self
    self=$(readlink -f "$0")
    claude mcp add --scope user "$NAME" -- "$self" mcp "$NAME" ||
      die "claude mcp add failed (is there already a server named '$NAME'? see: claude mcp list)"
    say "Added. In Claude Code on this computer, the tools of VM '$NAME' are now available"
    say "(start a new Claude session; check with /mcp). Remove with: claude mcp remove $NAME --scope user"
    return 0
  fi
  command -v python3 >/dev/null || die "python3 is needed for the MCP server"
  VMCLAUDE_VERSION=$VERSION exec python3 -c "$MCP_PY" "$(readlink -f "$0")" "$NAME" "$C_OS" "$C_DIR"
}

MCP_PY=$(cat <<'PYTHON_END'
# The MCP server behind "vmclaude mcp NAME": JSON-RPC over stdin/stdout.
import json, os, re, subprocess, sys, tempfile

VMCLAUDE, NAME, OS, DIR = sys.argv[1:5]
VERSION = os.environ.get("VMCLAUDE_VERSION", "")
LIMIT = 30000  # characters of command output returned to the model
info = {}


class ToolError(Exception):
    pass


def vmclaude(args, timeout):
    # Own process group, so a timeout also stops the ssh under it.
    p = subprocess.Popen([VMCLAUDE, *args], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         stdin=subprocess.DEVNULL, start_new_session=True)
    try:
        out, err = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, 15)
        p.communicate()
        raise ToolError(f"timed out after {timeout} s")
    return subprocess.CompletedProcess(p.args, p.returncode, out, err)


def text(b):
    return b.decode("utf-8", errors="replace")


def vm_info():
    if not info:
        r = vmclaude(["__mcp-info", NAME], 600)
        if r.returncode:
            raise ToolError(f"cannot reach VM {NAME}: {text(r.stderr or r.stdout).strip()} (try: vmclaude doctor {NAME})")
        for line in text(r.stdout).splitlines():
            k, _, v = line.partition("=")
            info[k] = v
    return info


def remote_path(p):
    i = vm_info()
    win = i["os"] == "windows"
    if not p:
        raise ToolError("empty path")
    if (win and (re.match(r"^[A-Za-z]:[\\/]", p) or p.startswith("\\\\"))) or (not win and p.startswith("/")):
        return p
    base, rest = i["dir"], p
    if p == "~":
        return i["home"]
    if p.startswith("~/") or p.startswith("~\\"):
        base, rest = i["home"], p[2:]
    sep = "\\" if win else "/"
    if win:
        rest = rest.replace("/", "\\")
    return base.rstrip("/\\") + sep + rest


def shorten(s):
    if len(s) <= LIMIT:
        return s
    half = LIMIT // 2
    return s[:half] + f"\n... [{len(s) - LIMIT} characters cut] ...\n" + s[-half:]


def get(path):
    remote = remote_path(path)
    with tempfile.TemporaryDirectory() as d:
        local = os.path.join(d, "f")
        r = vmclaude(["__mcp-get", NAME, remote, local], 600)
        if r.returncode or not os.path.exists(local):
            raise ToolError(f"cannot read {remote}: {text(r.stderr).strip() or 'not found'}")
        with open(local, "rb") as f:
            return remote, f.read()


def put(path, data):
    remote = remote_path(path)
    with tempfile.TemporaryDirectory() as d:
        local = os.path.join(d, "f")
        with open(local, "wb") as f:
            f.write(data)
        r = vmclaude(["__mcp-put", NAME, local, remote], 600)
        if r.returncode:
            raise ToolError(f"cannot write {remote}: {text(r.stderr).strip()}")
    return remote


def run(a):
    command = a.get("command") or ""
    if not command.strip():
        raise ToolError("command is empty")
    timeout = max(1, min(int(a.get("timeout") or 120), 600))
    r = vmclaude(["__mcp-run", NAME, vm_info()["dir"], command], timeout)
    if r.returncode == 255 and not r.stdout:
        raise ToolError(f"SSH to VM {NAME} failed: {text(r.stderr).strip()}")
    out = text(r.stdout)
    if r.stderr:
        out += ("\n" if out and not out.endswith("\n") else "") + "[stderr]\n" + text(r.stderr)
    out = shorten(out)
    return out + ("" if not out or out.endswith("\n") else "\n") + f"[exit code {r.returncode}]"


def read_file(a):
    remote, data = get(a.get("path", ""))
    lines = data.decode("utf-8-sig", errors="replace").splitlines()
    start = max(1, int(a.get("offset") or 1))
    count = max(1, int(a.get("limit") or 2000))
    part = lines[start - 1:start - 1 + count]
    body = "\n".join(f"{n:6}\t{line}" for n, line in enumerate(part, start))
    more = len(lines) - (start - 1 + len(part))
    if more > 0:
        body += f"\n... {more} more lines (use offset {start + len(part)})"
    return f"{remote} ({len(lines)} lines)\n" + (body or "(empty file)")


def write_file(a):
    content = a.get("content")
    if content is None:
        raise ToolError("content is missing")
    data = content.encode("utf-8")
    path = a.get("path", "")
    # Windows PowerShell 5.1 reads scripts without a BOM in the old ANSI code page.
    if (vm_info()["os"] == "windows" and path.lower().endswith((".ps1", ".psm1", ".psd1"))
            and not data.isascii() and not data.startswith(b"\xef\xbb\xbf")):
        data = b"\xef\xbb\xbf" + data
    remote = put(path, data)
    return f"Wrote {len(data)} bytes to {remote}"


def edit_file(a):
    old, new = a.get("old_string"), a.get("new_string")
    if not old:
        raise ToolError("old_string is empty")  # (a BOM at the start of the file is kept as it is)
    if new is None:
        raise ToolError("new_string is missing")
    remote, data = get(a.get("path", ""))
    try:
        s = data.decode("utf-8")
    except UnicodeDecodeError:
        raise ToolError(f"{remote} is not a UTF-8 text file")
    n = s.count(old)
    if n == 0 and "\r\n" in s and "\r\n" not in old:  # Windows line endings
        old, new = old.replace("\n", "\r\n"), new.replace("\n", "\r\n")
        n = s.count(old)
    if n == 0:
        raise ToolError(f"old_string not found in {remote}")
    if n > 1 and not a.get("replace_all"):
        raise ToolError(f"old_string occurs {n} times in {remote}; give more context or set replace_all")
    put(remote, s.replace(old, new).encode("utf-8"))
    return f"Edited {remote}: replaced {n if a.get('replace_all') else 1} occurrence(s)"


where = f"VM '{NAME}'" + (" (Windows: commands run in Windows PowerShell 5.1; any non-zero exit code is reported as 1)"
                         if OS == "windows" else " (Linux: commands run in bash)")
start_dir = DIR or "the home directory"
TOOLS = [
    {"name": "run", "handler": run,
     "description": f"Run a shell command inside {where}, in {start_dir}. Returns its output and exit code. "
                    "Starts the VM first if it is off. Use this for everything inside the VM: building, "
                    "testing, installing packages (sudo works without a password on VMs made by vmclaude create).",
     "inputSchema": {"type": "object", "properties": {
         "command": {"type": "string", "description": "The command line to run"},
         "timeout": {"type": "integer", "description": "Seconds before it is stopped (default 120, max 600)"}},
         "required": ["command"]}},
    {"name": "read_file", "handler": read_file,
     "description": f"Read a text file inside {where}. Relative paths start in {start_dir}; ~ is the home "
                    "directory. Lines come numbered (number, tab, text).",
     "inputSchema": {"type": "object", "properties": {
         "path": {"type": "string"},
         "offset": {"type": "integer", "description": "First line to show (1-based)"},
         "limit": {"type": "integer", "description": "Number of lines (default 2000)"}},
         "required": ["path"]}},
    {"name": "write_file", "handler": write_file,
     "description": f"Create or overwrite a file inside {where} with the given content. Missing folders are "
                    f"created. Relative paths start in {start_dir}.",
     "inputSchema": {"type": "object", "properties": {
         "path": {"type": "string"}, "content": {"type": "string"}}, "required": ["path", "content"]}},
    {"name": "edit_file", "handler": edit_file,
     "description": f"Replace exact text in a file inside {where}. old_string must match the file exactly "
                    "(whitespace included) and occur once, unless replace_all is true.",
     "inputSchema": {"type": "object", "properties": {
         "path": {"type": "string"}, "old_string": {"type": "string"}, "new_string": {"type": "string"},
         "replace_all": {"type": "boolean", "description": "Replace every occurrence"}},
         "required": ["path", "old_string", "new_string"]}},
]
HANDLERS = {t["name"]: t.pop("handler") for t in TOOLS}
INSTRUCTIONS = (f"These tools work inside the virtual machine '{NAME}' over SSH (vmclaude). Use them, not the "
                f"local file and shell tools, whenever the task is about that VM. Paths and commands start in "
                f"{start_dir} on the VM.")


def reply(id_, result=None, error=None):
    msg = {"jsonrpc": "2.0", "id": id_}
    if error:
        msg["error"] = error
    else:
        msg["result"] = result
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()


def handle(msg):
    method, id_, params = msg.get("method"), msg.get("id"), msg.get("params") or {}
    if id_ is None:
        return  # a notification
    if method == "initialize":
        reply(id_, {"protocolVersion": params.get("protocolVersion", "2025-06-18"),
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": f"vmclaude-{NAME}", "version": VERSION},
                    "instructions": INSTRUCTIONS})
    elif method == "ping":
        reply(id_, {})
    elif method == "tools/list":
        reply(id_, {"tools": TOOLS})
    elif method == "tools/call":
        handler = HANDLERS.get(params.get("name"))
        if not handler:
            reply(id_, error={"code": -32602, "message": f"unknown tool {params.get('name')}"})
            return
        try:
            reply(id_, {"content": [{"type": "text", "text": handler(params.get("arguments") or {})}], "isError": False})
        except ToolError as e:
            reply(id_, {"content": [{"type": "text", "text": str(e)}], "isError": True})
        except Exception as e:  # keep serving after a bug
            reply(id_, {"content": [{"type": "text", "text": f"internal error: {e!r}"}], "isError": True})
    else:
        reply(id_, error={"code": -32601, "message": f"method not found: {method}"})


for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        msg = json.loads(line)
    except ValueError:
        reply(None, error={"code": -32700, "message": "parse error"})
        continue
    for m in msg if isinstance(msg, list) else [msg]:
        handle(m)
PYTHON_END
)

# ------------------------------------------------------------------ mount

MOUNT_BASE=${VMCLAUDE_MOUNT_DIR:-$HOME/vm}

is_mounted() { # DIR
  local d
  d=$(readlink -f "$1" 2>/dev/null) || return 1
  awk -v d="$d" '$2 == d { found = 1 } END { exit !found }' "${VMCLAUDE_MOUNTS_FILE:-/proc/mounts}" 2>/dev/null
}

cmd_mount() {
  local name='' dir=''
  while (($#)); do
    case $1 in
      -*) usage_error "mount: unknown option $1" ;;
      *)
        if [[ -z $name ]]; then name=$1
        elif [[ -z $dir ]]; then dir=$1
        else usage_error "mount: too many arguments"
        fi
        shift ;;
    esac
  done
  [[ -n $name ]] || usage_error "mount: missing NAME"
  command -v sshfs >/dev/null ||
    die "sshfs is not installed (Debian/Ubuntu: sudo apt install sshfs; Fedora: sudo dnf install fuse-sshfs; Arch: sudo pacman -S sshfs)"
  load "$name"
  dir=${dir:-$MOUNT_BASE/$NAME}
  if is_mounted "$dir"; then say "Already mounted: $dir"; return 0; fi
  mkdir -p "$dir"
  [[ -z $(ls -A "$dir") ]] || die "$dir is not empty; give an empty folder: $PROG mount $NAME FOLDER"

  local remote line
  mcp_prepare "$NAME"  # here, not in $(...): it sets TARGET
  remote=$(vm_info_lines | sed -n 's/^dir=//p') || true
  [[ -n $remote ]] || die "cannot reach VM $NAME (see: $PROG doctor $NAME)"
  local -a o=(-o "reconnect,ServerAliveInterval=15,ServerAliveCountMax=3,idmap=user"
    -o "Port=$C_PORT" -o "HostKeyAlias=vmclaude-$NAME" -o "UserKnownHostsFile=$KNOWN_HOSTS"
    -o StrictHostKeyChecking=accept-new -o BatchMode=yes)
  [[ -f $C_KEY ]] && o+=(-o "IdentityFile=$C_KEY" -o IdentitiesOnly=yes)
  if ! line=$(sshfs "${o[@]}" "$(scp_host):$(sftp_path "$remote")" "$dir" 2>&1); then
    rmdir "$dir" 2>/dev/null || true
    die "sshfs failed: $line"
  fi
  say "Mounted $NAME:$remote at $dir"
  say ""
  say "Files you (or Claude Code) change in $dir change in the VM."
  say "But commands started there still run on THIS computer. To run them in the VM:"
  say "  $PROG shell $NAME 'COMMAND'     or the run tool of: $PROG mcp $NAME --add"
  say "Unmount with: $PROG umount $NAME"
}

cmd_umount() {
  local name=${1:-} dir=${2:-}
  [[ -n $name ]] || usage_error "umount: missing NAME"
  valid_name "$name" || die "invalid name: $name"
  dir=${dir:-$MOUNT_BASE/$name}
  is_mounted "$dir" || { say "Not mounted: $dir"; return 0; }
  local tool
  for tool in fusermount3 fusermount; do
    if command -v "$tool" >/dev/null; then
      "$tool" -u "$dir" || die "could not unmount $dir (is a program still using it?)"
      rmdir "$dir" 2>/dev/null || true
      say "Unmounted $dir"
      return 0
    fi
  done
  umount "$dir" || die "could not unmount $dir"
  say "Unmounted $dir"
}

# ------------------------------------------------------------------ login

# Logs Claude Code on the VM in without a browser there: the token is made
# here ("claude setup-token", whose browser step works on this computer) and
# stored on the VM in ~/.config/vmclaude/claude-env, readable only by you.
TOKEN_RE='^sk-ant-[A-Za-z0-9_-]{20,}$'

cmd_login() {
  local name='' remove=0
  while (($#)); do
    case $1 in
      --remove) remove=1; shift ;;
      -*) usage_error "login: unknown option $1" ;;
      *) [[ -z $name ]] || usage_error "login: more than one name given"; name=$1; shift ;;
    esac
  done
  [[ -n $name ]] || name=$(default_name) || usage_error "login: missing NAME"
  load "$name"

  local token='' var
  if ((!remove)); then
    if [[ ! -t 0 ]]; then
      token=$(head -c 4096 | tr -d ' \r\n\t')        # piped in: echo TOKEN | vmclaude login NAME
    else
      if command -v claude >/dev/null && command -v script >/dev/null; then
        info "Making a login token with Claude Code on this computer (claude setup-token)."
        info "Confirm in the browser that opens; vmclaude takes the token from there."
        local log
        log=$(mktemp)
        # A wide terminal, so the token is printed on one line.
        script -qefc "stty cols 1000 2>/dev/null; claude setup-token" "$log" || true
        token=$(sed 's/\x1b\[[0-9;?]*[A-Za-z]//g' "$log" | grep -oE 'sk-ant-[A-Za-z0-9_-]{20,}' | tail -n 1) || true
        rm -f "$log"
      fi
      if [[ -z $token ]]; then
        info "Paste a Claude token (from \"claude setup-token\") or an API key (sk-ant-...)."
        read -rs -p "Token: " token || die "aborted"
        printf '\n' >&2
        token=${token//[[:space:]]/}
      fi
    fi
    [[ $token =~ $TOKEN_RE ]] || die "that is not a Claude token or API key (they start with sk-ant-)"
    case $token in
      sk-ant-oat*) var=CLAUDE_CODE_OAUTH_TOKEN ;;
      *) var=ANTHROPIC_API_KEY ;;
    esac
  fi

  resolve_target
  build_ssh_opts
  if [[ $C_OS == windows ]]; then
    # shellcheck disable=SC2016
    local ps='$d = "$env:USERPROFILE\.config\vmclaude"; $f = "$d\claude-env"'
    if ((remove)); then
      ps+=$'\nRemove-Item -LiteralPath $f -ErrorAction SilentlyContinue'
      run_ssh -T -- "$TARGET" "$(win_cmd "$ps")" </dev/null || die "could not remove the token"
    else
      # shellcheck disable=SC2016
      ps+=$'\nNew-Item -ItemType Directory -Force -Path $d | Out-Null\n[IO.File]::WriteAllText($f, [Console]::In.ReadToEnd())'
      printf '%s=%s\n' "$var" "$token" | run_ssh -T -- "$TARGET" "$(win_cmd "$ps")" || die "could not store the token"
    fi
  else
    if ((remove)); then
      # shellcheck disable=SC2016
      run_ssh -T -- "$TARGET" 'rm -f "$HOME/.config/vmclaude/claude-env"' </dev/null || die "could not remove the token"
    else
      # shellcheck disable=SC2016
      printf '%s=%s\n' "$var" "$token" | run_ssh -T -- "$TARGET" "$(remote_cmd 'umask 077
mkdir -p "$HOME/.config/vmclaude" && cat >"$HOME/.config/vmclaude/claude-env" && chmod 600 "$HOME/.config/vmclaude/claude-env"')" ||
        die "could not store the token"
    fi
  fi
  if ((remove)); then
    say "Removed the login token from '$NAME'."
  else
    say "Logged in: Claude Code on '$NAME' now uses this $([[ $var == ANTHROPIC_API_KEY ]] && echo "API key" || echo token)."
    say "Open it with: $PROG $NAME   (a Claude session that is already running keeps its old login)"
  fi
}

desktop_escape() { # quote an argument for a .desktop Exec line
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//\`/\\\`}; s=${s//\$/\\\$}
  printf '"%s"' "${s//%/%%}"
}

cmd_desktop() {
  [[ $# = 1 ]] || usage_error "desktop: give one NAME"
  profile_exists "$1" || die "no VM profile named '$1'"
  local self file
  self=$(readlink -f "$0")
  file=$APPS_DIR/vmclaude-$1.desktop
  mkdir -p "$APPS_DIR"
  cat >"$file" <<EOF
[Desktop Entry]
Type=Application
Name=Claude Code ($1)
Comment=Open Claude Code on the virtual machine $1 over SSH
Exec=$(desktop_escape "$self") connect --hold $1
Terminal=true
Icon=utilities-terminal
Categories=Development;
Keywords=claude;ssh;vm;
EOF
  chmod +x "$file"
  if command -v update-desktop-database >/dev/null; then
    update-desktop-database "$APPS_DIR" >/dev/null 2>&1 || true
  fi
  say "Created $file — look for \"Claude Code ($1)\" in your app menu."
}

ask() { # VAR PROMPT DEFAULT
  local __a
  read -r -p "$2${3:+ [$3]}: " __a || die "aborted"
  printf -v "$1" '%s' "${__a:-$3}"
}

first_run() {
  [[ -t 0 && -t 1 ]] || die "no VM configured. Add one: $PROG add NAME --host IP"
  local name domain='' host='' user port doms yn
  say "No VM configured yet — let's add one."
  ask name "Name for this VM" vm
  if command -v virsh >/dev/null; then
    doms=$(virsh -c qemu:///system list --all --name 2>/dev/null | sed '/^$/d' | tr '\n' ' ' || true)
    if [[ -n $doms ]]; then
      say "libvirt VMs: $doms"
      ask domain "libvirt VM to use (empty if it is not a libvirt VM)" ""
    fi
  fi
  if [[ -n $domain ]]; then
    ask host "Host or IP (empty: detect automatically)" ""
  else
    while [[ -z $host ]]; do ask host "Host or IP of the VM" ""; done
  fi
  ask user "User on the VM" "$(id -un)"
  ask port "SSH port" 22
  local -a args=("$name" --user "$user" --port "$port")
  [[ -n $host ]] && args+=(--host "$host")
  [[ -n $domain ]] && args+=(--domain "$domain")
  cmd_add "${args[@]}"
  ask yn "Set up the VM now (SSH key, tmux, Claude Code)? [Y/n]" ""
  [[ $yn == [nN]* ]] || cmd_setup "$name"
  cmd_connect "$name"
}

# "vmclaude COMMAND --help". For connect and shell only right after the
# command: later arguments belong to Claude or to the remote command.
wants_help() { # COMMAND ARGS...
  local cmd=$1 a
  shift
  case $cmd in
    connect) [[ ${1-} == -h || ${1-} == --help ]]; return ;;
    shell) [[ ${1-} == --keep ]] && shift; [[ ${1-} == -h || ${1-} == --help ]]; return ;;
  esac
  for a in "$@"; do
    [[ $a == -- ]] && return 1
    [[ $a == -h || $a == --help ]] && return 0
  done
  return 1
}

main() {
  ((BASH_VERSINFO[0] >= 4)) || { echo "$PROG: bash 4 or newer is required" >&2; exit 1; }
  local cmd=${1-}
  case $cmd in
    "")
      if [[ -z $(profile_names) ]]; then first_run; else cmd_connect; fi ;;
    help | -h | --help)
      if [[ -n ${2-} ]]; then help_cmd "$2"; else usage; fi ;;
    version | -V | --version) say "vmclaude $VERSION" ;;
    __mcp-info | __mcp-run | __mcp-get | __mcp-put) shift; "cmd_$cmd" "$@" ;;
    add | create | delete | images | prune | mcp | mount | umount | login | setup | connect | shell | start | stop | autostop | autostart | doctor | list | default | desktop | edit | forget | rm)
      shift
      if wants_help "$cmd" "$@"; then help_cmd "$cmd"; return 0; fi
      "cmd_$cmd" "$@" ;;
    ls) shift; cmd_list "$@" ;;
    remove) shift; cmd_rm "$@" ;;
    --hold | --no-tmux | --keep) cmd_connect "$@" ;;
    -*) usage_error "unknown option $cmd" ;;
    *)
      profile_exists "$cmd" || usage_error "unknown command or VM: $cmd"
      cmd_connect "$@" ;;
  esac
}

main "$@"
