#!/usr/bin/env bash
# vmclaude — open Claude Code inside a virtual machine over SSH, in one step.
# https://github.com/emincan2000/vmclaude
set -euo pipefail

VERSION=0.7.0
PROG=${0##*/}
CONF_DIR=${VMCLAUDE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/vmclaude}
HOSTS_DIR=$CONF_DIR/hosts
KNOWN_HOSTS=$CONF_DIR/known_hosts
DEFAULT_KEY=$HOME/.ssh/vmclaude_ed25519
BOOT_TIMEOUT=${VMCLAUDE_BOOT_TIMEOUT:-180}
STOP_TIMEOUT=${VMCLAUDE_STOP_TIMEOUT:-120}
APPS_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/applications
PROFILE_KEYS=" HOST USER PORT IDENTITY DOMAIN LIBVIRT_URI DIR SESSION OS AUTOSTOP CREATED "
HOLD=0

say()  { printf '%s\n' "$*"; }
info() { printf '%s\n' "$*" >&2; }
warn() { printf '%s: warning: %s\n' "$PROG" "$*" >&2; }
die()  {
  printf '%s: %s\n' "$PROG" "$*" >&2
  hold_prompt
  exit 1
}
usage_error() { printf '%s: %s\n' "$PROG" "$*" >&2; printf "Try '%s help'.\n" "$PROG" >&2; exit 2; }
# In a desktop launcher the terminal closes as soon as we exit; keep it open on errors.
hold_prompt() {
  if [[ $HOLD = 1 && -t 0 ]]; then
    read -r -p "Press Enter to close." _ || true
  fi
}

usage() {
  cat <<EOF
vmclaude $VERSION — run Claude Code inside a virtual machine, over SSH.

Claude Code then works on the VM's files and programs, not on your computer's.
vmclaude starts the VM, logs in with its own SSH key and opens Claude there:
in tmux on Linux VMs, so Claude keeps running if the connection drops.
When you leave Claude, a libvirt VM that nothing else uses shuts down again.

GET STARTED
  No VM yet? Make one (Linux computer with libvirt):
    vmclaude create dev                      new Debian 13 VM with Claude Code, no password
    vmclaude create box --image arch         the same with Arch Linux
    vmclaude login dev                       log Claude in (browser opens on this computer)
    vmclaude dev                             open Claude Code in it

  A VM you already have:
    vmclaude add win10 --domain win10 --user emin     a libvirt VM (vmclaude starts it)
    vmclaude add srv --host 192.168.1.50 --user dev   any machine you can SSH into
    vmclaude setup srv                       install SSH key + Claude Code (asks the VM password once)
    vmclaude srv                             open Claude Code in it

  Every day:
    vmclaude                                 open Claude on the default VM
    vmclaude dev --continue                  arguments after the name go to Claude
    ssh dev@VM                               any SSH app opens Claude too (after setup)

COMMANDS
  Make and remove VMs (libvirt):
    create NAME          new Linux VM from an official cloud image, ready for Claude
    delete NAME          delete a VM made with create, with its disks
    images               list the images: which exist, which are downloaded, where
    prune                delete downloaded images that no VM uses any more

  Use a VM:
    connect NAME         open Claude Code ("vmclaude NAME" does the same)
    shell NAME [CMD]     a normal shell on the VM, or run one command there
    start NAME           start a libvirt VM and wait until SSH answers
    stop NAME            shut a libvirt VM down (--force: pull the plug)
    doctor NAME          check VM, network, SSH, key, Claude and tmux, step by step
    login NAME           log Claude in on the VM, with the browser of THIS computer
    mcp NAME --add       let Claude Code on THIS computer work in the VM (run, read, write, edit)
    mount NAME [DIR]     show the VM's folder as a folder here (~/vm/NAME); umount NAME

  Profiles (one per VM, in ${CONF_DIR/#$HOME/\~}/hosts/):
    add NAME             add an existing VM, or change the settings of a profile
    setup NAME           install the SSH key, tmux and Claude Code on the VM
    list                 show all profiles; * marks the default
    default NAME         choose the VM that plain "vmclaude" opens
    autostart NAME on|off   open Claude on every SSH login, or stop doing so
    autostop NAME on|off    shut the VM down when you leave Claude (default: on)
    desktop NAME         add "Claude Code (NAME)" to your app menu
    edit NAME            open the profile file in your editor
    forget NAME          forget the VM's SSH host key (after reinstalling the VM)
    rm NAME              delete the profile only (the VM stays)

MORE HELP
  vmclaude help COMMAND     what a command does, its options and examples
                            (e.g. "vmclaude help create"; "vmclaude create --help" works too)
  vmclaude images           where downloaded images and VM disks are stored
EOF
}

help_cmd() { # COMMAND
  local u
  u=$(id -un)
  case $1 in
    create) cat <<EOF
vmclaude create NAME [options]

Makes a new Linux VM in libvirt and sets it up for Claude Code. You need
virt-install and virsh (Debian/Ubuntu: sudo apt install virtinst libvirt-daemon-system)
and your user in the "libvirt" group. No password is set or asked: the VM
lets you in with vmclaude's SSH key only, and sudo works without a password.

What happens:
  1. The official cloud image is downloaded once and checked against the
     distribution's published SHA-256/SHA-512 checksum.
  2. It is copied into the libvirt pool as a base image. The new VM gets its
     own small disk that only stores what differs from the base, so more VMs
     from the same image need no download and little space.
  3. cloud-init in the VM creates your user with the SSH key and installs tmux.
  4. "vmclaude setup NAME" installs Claude Code and the SSH-login autostart.

Options:
  --image IMAGE    debian13 (default), debian12, ubuntu24.04 or arch
                   ("vmclaude images" lists them, with what is downloaded)
  --memory MB      RAM in megabytes          (default 4096)
  --cpus N         virtual CPUs              (default 2)
  --disk GB        disk size in gigabytes    (default 20)
  --user USER      user created in the VM    (default: $u)
  --uri URI        libvirt connection        (default: qemu:///system)
  --no-setup       only make the VM; run "vmclaude setup NAME" later

Examples:
  vmclaude create dev                              Debian 13: 4 GB RAM, 2 CPUs, 20 GB disk
  vmclaude create big --memory 16384 --cpus 8 --disk 100
                                                   16 GB RAM, 8 CPUs, 100 GB disk
  vmclaude create u24 --image ubuntu24.04          Ubuntu 24.04
  vmclaude create box --image arch                 Arch Linux
  VMCLAUDE_ARCH_MIRROR=https://mirrors.dotsrc.org/archlinux vmclaude create box --image arch
                                                   Arch Linux, image from a faster mirror

Then: "vmclaude dev" opens Claude. "vmclaude delete dev" removes the VM again.
EOF
      ;;
